<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_it_credential_tree" model="ir.ui.view">
        <field name="name">wex.it.credential.tree</field>
        <field name="model">wex.it.credential</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="asset_id"/>
                <field name="service_id"/>
                <field name="credential_type"/>
                <field name="login"/>
                <field name="last_updated"/>
                <field name="rotation_due_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_wex_it_credential_form" model="ir.ui.view">
        <field name="name">wex.it.credential.form</field>
        <field name="model">wex.it.credential</field>
        <field name="arch" type="xml">
            <form string="Credencial">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="asset_id" domain="[('partner_id', '=', partner_id)]"/>
                            <field name="service_id" domain="[('partner_id', '=', partner_id)]"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="credential_type"/>
                            <field name="login"/>
                            <field name="url" widget="url"/>
                            <field name="last_updated"/>
                            <field name="rotation_due_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="secret_value" password="True" placeholder="Valor de la credencial..." groups="wex_it_maintenance.group_it_maintenance_credential_user"/>
                    </group>
                    <group groups="wex_it_maintenance.group_it_maintenance_credential_user">
                        <button name="action_show_secret" string="Mostrar" type="object" class="oe_highlight" invisible="not can_view_secret"/>
                        <field name="secret_preview" readonly="1" invisible="not show_secret_preview"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notas operativas..."/>
                    </group>
                    <div class="o_form_label text-muted">Nota de seguridad</div>
                    <div class="text-muted">
                        En esta v1 el secreto queda oculto en interfaz y protegido por permisos, pero no cifrado con gestión fuerte de claves.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_wex_it_credential_search" model="ir.ui.view">
        <field name="name">wex.it.credential.search</field>
        <field name="model">wex.it.credential</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="asset_id"/>
                <field name="service_id"/>
                <filter name="filter_active" string="Activas" domain="[('active', '=', True)]"/>
                <filter name="filter_rotation_due" string="Rotación vencida" domain="[('rotation_due_date', '&lt;=', context_today())]"/>
                <filter name="group_customer" string="Cliente" context="{'group_by': 'partner_id'}"/>
                <filter name="group_type" string="Tipo" context="{'group_by': 'credential_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_wex_it_credentials" model="ir.actions.act_window">
        <field name="name">Credenciales</field>
        <field name="res_model">wex.it.credential</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wex_it_credential_search"/>
        <field name="context">{'default_active': True}</field>
        <field name="groups_id" eval="[(4, ref('wex_it_maintenance.group_it_maintenance_credential_user')), (4, ref('wex_it_maintenance.group_it_maintenance_manager'))]"/>
    </record>
</odoo>
