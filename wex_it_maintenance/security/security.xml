        <field name="model_id" ref="model_wex_it_service_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('wex_it_maintenance.group_it_maintenance_user'))]"/>
    </record>

