<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_it_maintenance_wex" model="ir.module.category">
        <field name="name">Mantenimiento IT</field>
        <field name="description">Permisos de mantenimiento IT</field>
        <field name="sequence">38</field>
    </record>

    <record id="group_it_maintenance_user" model="res.groups">
        <field name="name">Técnico de mantenimiento IT</field>
        <field name="category_id" ref="wex_it_maintenance.module_category_it_maintenance_wex"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_it_maintenance_credential_user" model="res.groups">
        <field name="name">Acceso a credenciales de mantenimiento IT</field>
        <field name="category_id" ref="wex_it_maintenance.module_category_it_maintenance_wex"/>
        <field name="implied_ids" eval="[(4, ref('wex_it_maintenance.group_it_maintenance_user'))]"/>
    </record>

