        <field name="name">Administrador de mantenimiento IT</field>
        <field name="category_id" ref="wex_it_maintenance.module_category_it_maintenance_wex"/>
        <field name="implied_ids" eval="[(4, ref('wex_it_maintenance.group_it_maintenance_user')), (4, ref('wex_it_maintenance.group_it_maintenance_credential_user'))]"/>
    </record>

    <record id="wex_it_asset_rule_user" model="ir.rule">
        <field name="name">Activos IT por compañía</field>
        <field name="model_id" ref="model_wex_it_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('wex_it_maintenance.group_it_maintenance_user'))]"/>
