<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_image_record_tree" model="ir.ui.view">
        <field name="name">wex.image.record.tree</field>
        <field name="model">wex.image.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="preview_image" string="Imagen" widget="image" options="{'size': [64, 64]}"/>
                <field name="name" string="Nombre"/>
                <field name="description" string="Descripción"/>
                <field name="tag_ids" string="Etiquetas" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="uploaded_by_id" string="Subida por"/>
                <field name="uploaded_at" string="Subida el"/>
            </list>
        </field>
    </record>

    <record id="view_wex_image_record_form" model="ir.ui.view">
        <field name="name">wex.image.record.form</field>
        <field name="model">wex.image.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_dms_file"
                            type="object"
                            string="Abrir en DMS"
                            class="btn btn-secondary"/>
                </header>
                <sheet class="wex_repair_images_detail_sheet">
                    <div class="row g-4 align-items-start">
                        <div class="col-lg-5">
                            <group string="Datos principales">
                                <field name="name" readonly="1"/>
                                <field name="description" placeholder="Añade contexto útil para taller o mostrador..."/>
                                <field name="sequence"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </group>
                            <group string="Trazabilidad" class="wex_repair_images_trace_group">
                                <field name="uploaded_by_id" readonly="1"/>
                                <field name="uploaded_at" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                                <field name="res_model" readonly="1"/>
                                <field name="res_id" readonly="1"/>
                                <field name="dms_file_name" readonly="1"/>
                                <field name="dms_file_id" readonly="1"/>
                                <field name="dms_directory_id" readonly="1"/>
                                <field name="mimetype" readonly="1"/>
                                <field name="file_size" readonly="1"/>
                                <field name="checksum" readonly="1"/>
                                <field name="active"/>
                            </group>
                        </div>
                        <div class="col-lg-7">
                            <group string="Imagen" class="wex_repair_images_preview_group">
                                <field name="preview_image"
                                       nolabel="1"
                                       widget="image"
                                       class="w-100"
                                       options="{'preview_image': 'preview_image', 'size': [0, 1200]}"/>
                            </group>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
