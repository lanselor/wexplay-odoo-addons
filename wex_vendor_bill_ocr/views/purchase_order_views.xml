<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_vendor_bill_ocr" model="ir.ui.view">
        <field name="name">purchase.order.form.vendor.bill.ocr</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class,'oe_button_box')]" position="inside">
                <button type="object"
                        name="action_view_vendor_bill_ocr_jobs"
                        class="oe_stat_button"
                        icon="fa-file-pdf-o"
                        string="OCR Jobs"
                        groups="purchase.group_purchase_user">
                    <field name="vendor_bill_ocr_job_count" widget="statinfo" string="OCR Jobs"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button type="object"
                        name="action_open_vendor_bill_ocr_upload"
                        string="Process Vendor Bill PDF"
                        class="btn btn-secondary"
                        groups="purchase.group_purchase_user"
                        invisible="state not in ('purchase', 'done')"/>
            </xpath>
        </field>
    </record>
</odoo>
