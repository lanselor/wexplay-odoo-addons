<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_vendor_bill_ocr_upload_wizard_form" model="ir.ui.view">
        <field name="name">wex.vendor.bill.ocr.upload.wizard.form</field>
        <field name="model">wex.vendor.bill.ocr.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Vendor Bill PDF">
                <group>
                    <field name="purchase_order_id"/>
                    <field name="filename"/>
                    <field name="pdf_file" filename="filename"/>
                </group>
                <footer>
                    <button type="object"
                            name="action_upload_and_enqueue"
                            string="Upload and Queue"
                            class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_wex_vendor_bill_ocr_review_wizard_form" model="ir.ui.view">
        <field name="name">wex.vendor.bill.ocr.review.wizard.form</field>
        <field name="model">wex.vendor.bill.ocr.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Vendor Bill OCR">
                <sheet>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="purchase_order_id"/>
                            <field name="supplier_id"/>
                            <field name="invoice_number"/>
                            <field name="invoice_date"/>
                        </group>
                        <group>
                            <field name="external_ref"/>
                            <field name="untaxed_amount"/>
                            <field name="tax_amount"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Serials" invisible="not serial_line_ids">
                            <field name="serial_line_ids" nolabel="1">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="qty_required"/>
                                    <field name="serial_input" widget="text"/>
                                </list>
                            </field>
                        </page>
                        <page string="Raw Text">
                            <field name="raw_text_preview" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button type="object"
                            name="action_confirm"
                            string="Receive and Create Bill"
                            class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
