<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_knowledge_article_image_upload_wizard_form" model="ir.ui.view">
        <field name="name">wex.knowledge.article.image.upload.wizard.form</field>
        <field name="model">wex.knowledge.article.image.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Insert Image">
                <sheet>
                    <group>
                        <field name="article_id"/>
                        <field name="description"/>
                        <field name="image_file"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_upload_image" type="object" string="Insert" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
