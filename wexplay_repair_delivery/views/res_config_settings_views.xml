<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_wexplay_repair_delivery" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wexplay.repair.delivery</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="wexplay_repair.res_config_settings_view_form_wexplay_repair"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='wexplay_sat_repair_state_settings']" position="after">
                <block title="Notificaciones SAT" name="wexplay_sat_delivery_notification_settings">
                    <setting string="Canal de presupuestos aceptados">
                        <field name="x_sat_budget_accepted_channel_id"
                               options="{'no_create': False, 'no_open': False}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
