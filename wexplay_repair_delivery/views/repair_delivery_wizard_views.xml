<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <record id="view_wex_repair_delivery_wizard_form" model="ir.ui.view">
        <field name="name">wex.repair.delivery.wizard.form</field>
        <field name="model">wex.repair.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Entrega de reparación">
                <sheet>
                    <group col="1">
                        <field name="invoice_id" readonly="1"/>
                        <field name="repair_id" readonly="1"/>
                        <field name="message_html" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_mark_delivered"
                            type="object"
                            string="Marcar como entregado"
                            class="btn-primary"/>
                    <button name="action_do_nothing"
                            type="object"
                            string="No hacer nada"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>