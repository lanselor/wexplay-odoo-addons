<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_repair_order_search_delivery_inherit" model="ir.ui.view">
        <field name="name">repair.order.search.delivery.inherit</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Pendiente de entrega"
                        name="pending_delivery"
                        domain="[('x_pending_delivery_filter', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
