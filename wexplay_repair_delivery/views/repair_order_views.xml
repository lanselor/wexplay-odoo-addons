<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <record id="view_repair_order_form_delivery_status_inherit" model="ir.ui.view">
        <field name="name">repair.order.form.delivery.status.inherit</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,confirmed,under_repair,done,delivered,cancel</attribute>
            </xpath>
        </field>
    </record>
    
</odoo>