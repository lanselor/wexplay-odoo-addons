<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mrw_shipping" model="ir.module.category">
        <field name="name">Envíos MRW</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_mrw_shipping_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_mrw_shipping"/>
    </record>

    <record id="group_mrw_shipping_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="module_category_mrw_shipping"/>
        <field name="implied_ids" eval="[(4, ref('group_mrw_shipping_user'))]"/>
    </record>

    <record id="group_mrw_shipping_administrator" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_mrw_shipping"/>
        <field name="implied_ids" eval="[(4, ref('group_mrw_shipping_manager'))]"/>
    </record>

    <record id="mrw_shipping_config_rule_company" model="ir.rule">
        <field name="name">MRW: regla de compañía para configuraciones</field>
        <field name="model_id" ref="model_mrw_shipping_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_mrw_shipping_user'))]"/>
    </record>

    <record id="mrw_shipping_shipment_rule_company" model="ir.rule">
        <field name="name">MRW: regla de compañía para envíos</field>
        <field name="model_id" ref="model_mrw_shipping_shipment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_mrw_shipping_user'))]"/>
    </record>

    <record id="mrw_shipping_package_rule_company" model="ir.rule">
        <field name="name">MRW: regla de compañía para bultos</field>
        <field name="model_id" ref="model_mrw_shipping_package"/>
        <field name="domain_force">[('shipment_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_mrw_shipping_user'))]"/>
    </record>

    <record id="mrw_shipping_log_rule_company" model="ir.rule">
        <field name="name">MRW: regla de compañía para logs</field>
        <field name="model_id" ref="model_mrw_shipping_log"/>
        <field name="domain_force">['|', ('shipment_id.company_id', 'in', company_ids), ('shipment_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_mrw_shipping_administrator'))]"/>
    </record>

    <record id="mrw_shipping_notification_rule_company" model="ir.rule">
        <field name="name">MRW: regla de compañía para notificaciones</field>
        <field name="model_id" ref="model_mrw_shipping_notification"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_mrw_shipping_user'))]"/>
    </record>
</odoo>
