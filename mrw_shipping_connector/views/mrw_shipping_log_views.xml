<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrw_shipping_log_view_list" model="ir.ui.view">
        <field name="name">mrw.shipping.log.view.list</field>
        <field name="model">mrw.shipping.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Creado el"/>
                <field name="shipment_id"/>
                <field name="operation"/>
                <field name="status"/>
                <field name="mrw_status"/>
                <field name="duration_ms"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="mrw_shipping_log_view_form" model="ir.ui.view">
        <field name="name">mrw.shipping.log.view.form</field>
        <field name="model">mrw.shipping.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="shipment_id"/>
                            <field name="config_id"/>
                            <field name="operation"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="mrw_status"/>
                            <field name="duration_ms"/>
                            <field name="user_id"/>
                            <field name="create_date" string="Creado el"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mensaje MRW">
                            <field name="mrw_message" nolabel="1"/>
                        </page>
                        <page string="Error">
                            <field name="error_message" nolabel="1"/>
                        </page>
                        <page string="Petición">
                            <field name="request_raw" nolabel="1"/>
                        </page>
                        <page string="Respuesta">
                            <field name="response_raw" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrw_shipping_log_view_search" model="ir.ui.view">
        <field name="name">mrw.shipping.log.view.search</field>
        <field name="model">mrw.shipping.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="shipment_id"/>
                <field name="operation"/>
                <field name="status"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_operation" string="Operación" context="{'group_by': 'operation'}"/>
                    <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mrw_shipping_log_action" model="ir.actions.act_window">
        <field name="name">Logs técnicos MRW</field>
        <field name="res_model">mrw.shipping.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
