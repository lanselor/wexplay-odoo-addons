<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrw_stock_picking_view_form" model="ir.ui.view">
        <field name="name">stock.picking.form.mrw</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_mrw_shipment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-archive"
                    invisible="not mrw_shipment_id"
                >
                    <field name="mrw_shipment_id" widget="statinfo" string="Envío MRW"/>
                </button>
                <button
                    name="action_open_mrw_logs"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list"
                    groups="mrw_shipping_connector.group_mrw_shipping_administrator"
                    invisible="not mrw_log_count"
                >
                    <field name="mrw_log_count" widget="statinfo" string="Logs MRW"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='carrier_tracking_ref']" position="after">
                <field name="mrw_state" invisible="not mrw_shipment_id"/>
                <field name="mrw_request_number" invisible="not mrw_request_number"/>
                <field
                    name="mrw_effective_shipping_date"
                    invisible="not mrw_effective_shipping_date"
                />
                <field name="mrw_label_attachment_id" invisible="not mrw_label_attachment_id"/>
                <button
                    name="action_get_mrw_label"
                    type="object"
                    string="Obtener etiqueta MRW"
                    class="btn-secondary"
                    invisible="not mrw_shipment_id or mrw_label_attachment_id or mrw_state not in ('sent', 'label_ready')"
                    confirm="Se solicitará la etiqueta real de PRUEBAS a MRW. ¿Continuar?"
                />
                <button
                    name="action_open_mrw_label"
                    type="object"
                    string="Abrir etiqueta MRW"
                    class="btn-secondary"
                    invisible="not mrw_label_attachment_id"
                />
                <button
                    name="action_download_mrw_label"
                    type="object"
                    string="Descargar etiqueta MRW"
                    class="btn-secondary"
                    invisible="not mrw_label_attachment_id"
                />
                <button
                    name="action_open_mrw_tracking"
                    type="object"
                    string="Abrir tracking MRW"
                    class="btn-secondary"
                    invisible="carrier_id.delivery_type != 'mrw' or not carrier_tracking_ref"
                />
                <button
                    name="action_preview_mrw_cancellation"
                    type="object"
                    string="Previsualizar cancelación MRW"
                    class="btn-secondary"
                    invisible="not mrw_shipment_id or mrw_state in ('draft', 'cancel_pending', 'cancelled')"
                />
                <button
                    name="action_request_mrw_cancellation"
                    type="object"
                    string="Solicitar cancelación MRW"
                    class="btn-secondary"
                    invisible="not mrw_shipment_id or mrw_state in ('draft', 'cancel_pending', 'cancelled')"
                    confirm="Se solicitará una cancelación real de PRUEBAS a MRW. Si MRW la rechaza, Odoo conservará el rastreo actual. ¿Continuar?"
                />
                <field name="mrw_last_error" invisible="not mrw_last_error"/>
            </xpath>
        </field>
    </record>
</odoo>
