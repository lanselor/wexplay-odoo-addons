<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrw_delivery_carrier_view_form" model="ir.ui.view">
        <field name="name">delivery.carrier.form.mrw</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MRW" name="mrw_settings" invisible="delivery_type != 'mrw'">
                    <group>
                        <group>
                            <field
                                name="mrw_config_id"
                                required="delivery_type == 'mrw'"
                                options="{'no_create_edit': True}"
                            />
                            <field
                                name="mrw_service_id"
                                required="delivery_type == 'mrw'"
                                options="{'no_create_edit': True}"
                            />
                        </group>
                        <group>
                            <field name="mrw_label_on_send"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="mrw_delivery_carrier_view_list" model="ir.ui.view">
        <field name="name">delivery.carrier.list.mrw</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_type']" position="after">
                <field name="mrw_service_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
