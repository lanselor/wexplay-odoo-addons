<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrw_shipping_config_view_list" model="ir.ui.view">
        <field name="name">mrw.shipping.config.view.list</field>
        <field name="model">mrw.shipping.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" string="Compañía"/>
                <field name="environment"/>
                <field name="agency_code"/>
                <field name="subscriber_code"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="mrw_shipping_config_view_form" model="ir.ui.view">
        <field name="name">mrw.shipping.config.view.form</field>
        <field name="model">mrw.shipping.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Probar conexión"
                        class="btn-primary"
                        icon="fa-plug"
                    />
                    <button
                        name="action_inspect_wsdl"
                        type="object"
                        string="Inspeccionar WSDL"
                        class="btn-secondary"
                        icon="fa-search"
                    />
                    <button
                        name="action_run_diagnostic"
                        type="object"
                        string="Ejecutar diagnóstico"
                        class="btn-info"
                        icon="fa-stethoscope"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Configuración MRW"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        Usa esta pantalla para validar conectividad, revisar el WSDL y
                        guardar un informe de diagnóstico que luego puedas copiar.
                    </div>
                    <group>
                        <group string="Contexto">
                            <field name="active"/>
                            <field name="company_id" string="Compañía"/>
                            <field name="warehouse_ref"/>
                            <field name="environment"/>
                            <field name="is_default"/>
                        </group>
                        <group string="Reglas operativas">
                            <field name="default_national_service_id"/>
                            <field name="default_international_service_id"/>
                            <field name="enable_international_shipments"/>
                            <field name="enable_production_calls"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conexión">
                            <group string="Endpoints y resultado">
                                <field name="test_wsdl_url"/>
                                <field name="production_wsdl_url"/>
                                <field name="api_timeout_seconds"/>
                                <field name="last_connection_test_at"/>
                                <field name="last_connection_test_status"/>
                                <field name="last_connection_test_message"/>
                            </group>
                        </page>
                        <page string="Diagnóstico">
                            <group string="Última ejecución">
                                <field name="last_diagnostic_at"/>
                                <field name="last_diagnostic_status"/>
                                <field name="last_diagnostic_message"/>
                            </group>
                            <group string="Informe para copiar">
                                <field name="last_diagnostic_report" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Inspección WSDL">
                            <group>
                                <field name="last_wsdl_inspection_at"/>
                                <field name="last_wsdl_inspection_status"/>
                                <field name="last_wsdl_inspection_message"/>
                                <field name="last_wsdl_operation_count"/>
                            </group>
                            <group string="Operaciones">
                                <field name="last_wsdl_operations" nolabel="1"/>
                            </group>
                            <group string="Detalle de operaciones">
                                <field name="last_wsdl_operation_details" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Credenciales" groups="mrw_shipping_connector.group_mrw_shipping_administrator">
                            <group string="AuthInfo MRW">
                                <field name="agency_code"/>
                                <field name="subscriber_code"/>
                                <field name="department_code"/>
                                <field name="username"/>
                                <field name="password" password="True"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrw_shipping_config_view_search" model="ir.ui.view">
        <field name="name">mrw.shipping.config.view.search</field>
        <field name="model">mrw.shipping.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <field name="environment"/>
                <filter name="active" string="Activo" domain="[('active', '=', True)]"/>
                <filter name="default" string="Por defecto" domain="[('is_default', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}"/>
                    <filter name="group_environment" string="Entorno" context="{'group_by': 'environment'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mrw_shipping_config_action" model="ir.actions.act_window">
        <field name="name">Configuraciones MRW</field>
        <field name="res_model">mrw.shipping.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
