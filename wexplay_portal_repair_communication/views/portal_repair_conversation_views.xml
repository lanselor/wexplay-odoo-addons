<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_portal_repair_conversation_list" model="ir.ui.view">
        <field name="name">wex.portal.repair.conversation.list</field>
        <field name="model">wex.portal.repair.conversation</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-warning="state == 'pending_customer_reply'" decoration-success="state == 'answered'" decoration-muted="state == 'no_response_needed'">
                <field name="last_message_at" string="Último movimiento"/>
                <field name="repair_id" string="SAT"/>
                <field name="partner_id" string="Cliente"/>
                <field name="responsible_user_id" string="Responsable"/>
                <field name="state" string="Estado" widget="badge"/>
                <field name="message_count" string="Mensajes"/>
                <field name="last_message_preview" string="Último mensaje"/>
                <button name="action_open_repair" type="object" string="Abrir SAT" class="btn btn-secondary"/>
                <button name="action_open_reply_wizard" type="object" string="Responder" class="btn btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_wex_portal_repair_conversation_form" model="ir.ui.view">
        <field name="name">wex.portal.repair.conversation.form</field>
        <field name="model">wex.portal.repair.conversation</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_open_reply_wizard" type="object" string="Responder" class="btn-primary"/>
                    <button name="action_open_operator_chat" type="object" string="Abrir chat técnico" class="btn-secondary"/>
                    <button name="action_mark_no_response_needed" type="object" string="No requiere contestación" invisible="state == 'no_response_needed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending_customer_reply,answered,no_response_needed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_repair" type="object" class="oe_stat_button" icon="fa-wrench">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Abrir SAT</span>
                            </div>
                        </button>
                        <button name="action_open_operator_chat" type="object" class="oe_stat_button" icon="fa-comments">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Chat técnico</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Conversación">
                            <field name="name" readonly="1"/>
                            <field name="repair_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="responsible_user_id" readonly="1"/>
                            <field name="operator_channel_id" readonly="1"/>
                        </group>
                        <group string="Seguimiento">
                            <field name="last_customer_message_at" readonly="1"/>
                            <field name="last_technician_message_at" readonly="1"/>
                            <field name="last_message_at" readonly="1"/>
                            <field name="message_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="last_message_preview" readonly="1"/>
                    </group>
                    <group string="Histórico">
                        <field name="message_ids" nolabel="1" readonly="1">
                            <list create="0" delete="0">
                                <field name="create_date" string="Fecha"/>
                                <field name="author_name" string="Autor"/>
                                <field name="source" string="Origen" widget="badge"/>
                                <field name="visible_to_customer" string="Visible cliente"/>
                                <field name="body" string="Mensaje"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wex_portal_repair_conversation_search" model="ir.ui.view">
        <field name="name">wex.portal.repair.conversation.search</field>
        <field name="model">wex.portal.repair.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="repair_id" string="SAT"/>
                <field name="partner_id" string="Cliente"/>
                <field name="responsible_user_id" string="Responsable"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending_customer_reply')]"/>
                <filter name="answered" string="Respondidas" domain="[('state', '=', 'answered')]"/>
                <filter name="no_response_needed" string="Sin respuesta necesaria" domain="[('state', '=', 'no_response_needed')]"/>
                <separator/>
                <filter name="group_responsible" string="Agrupar por responsable" context="{'group_by': 'responsible_user_id'}"/>
                <filter name="group_customer" string="Agrupar por cliente" context="{'group_by': 'commercial_partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_wex_portal_repair_conversation" model="ir.actions.act_window">
        <field name="name">Conversaciones pendientes</field>
        <field name="res_model">wex.portal.repair.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wex_portal_repair_conversation_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay conversaciones pendientes.
            </p>
        </field>
    </record>

    <menuitem id="menu_wex_portal_repair_conversation"
              name="Conversaciones pendientes"
              parent="wexplay_portal_repair_workflow.menu_wex_portal_repair_activity_root"
              action="action_wex_portal_repair_conversation"
              sequence="20"
              groups="base.group_user"/>
</odoo>
