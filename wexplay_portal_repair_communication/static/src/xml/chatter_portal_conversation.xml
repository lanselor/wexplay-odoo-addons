<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="wexplay_portal_repair_communication.ChatterPortalConversation"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension"
       owl="1">

        <xpath expr="//Thread[@t-if=&quot;this.isWexChatterMainTabActive() and !(messageSearch.searching or messageSearch.searched)&quot;]" position="after">
            <div t-if="this.isPortalConversationTabActive()"
                 class="wex-portal-conversation-page h-100 d-flex flex-column">
                <div class="wex-portal-conversation-page__header d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="wex-portal-conversation-page__eyebrow">Conversación portal</div>
                        <div class="wex-portal-conversation-page__title">Histórico SAT-cliente</div>
                    </div>
                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            t-on-click="openPortalConversationRecord">
                        Abrir conversación
                    </button>
                </div>

                <div t-if="state.portalConversationLoading"
                     class="wex-portal-conversation-page__loading">
                    Cargando conversación...
                </div>

                <div t-elif="this.portalConversationItems.length"
                     class="wex-portal-conversation-page__stream">
                    <t t-foreach="this.portalConversationItems" t-as="item" t-key="item.type + '-' + item.id + '-' + item.label">
                        <div t-if="item.type === 'date_separator'"
                             class="wex-portal-conversation-page__date">
                            <t t-out="item.label"/>
                        </div>
                        <div t-elif="item.type === 'message'"
                             t-att-class="'wex-portal-conversation-page__message ' + (item.is_customer ? 'is-customer' : 'is-technician')">
                            <div class="wex-portal-conversation-page__meta">
                                <strong><t t-out="item.author_name"/></strong>
                                <span><t t-out="item.created_at_label"/></span>
                            </div>
                            <div class="wex-portal-conversation-page__body">
                                <t t-out="item.body"/>
                            </div>
                        </div>
                    </t>
                </div>

                <div t-else=""
                     class="wex-portal-conversation-page__empty">
                    Aún no hay conversación portal asociada a este SAT.
                </div>
            </div>
        </xpath>

    </t>

</templates>
