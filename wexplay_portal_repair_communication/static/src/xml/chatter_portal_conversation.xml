<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="wexplay_portal_repair_communication.ChatterPortalConversation"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension"
       owl="1">

        <xpath expr="//t[@t-if=&quot;props.has_activities and activities.length and !messageSearch.searching and !messageSearch.searched&quot;]" position="attributes">
            <attribute name="t-if">props.has_activities and activities.length and !messageSearch.searching and !messageSearch.searched and !this.isPortalConversationTabActive()</attribute>
        </xpath>

        <xpath expr="//t[@t-if=&quot;scheduledMessages.length&quot;]" position="attributes">
            <attribute name="t-if">scheduledMessages.length and !this.isPortalConversationTabActive()</attribute>
        </xpath>

        <xpath expr="//div[@t-if=&quot;state.isAttachmentBoxOpened&quot;]" position="attributes">
            <attribute name="t-if">state.isAttachmentBoxOpened and !this.isPortalConversationTabActive()</attribute>
        </xpath>

        <xpath expr="//SearchMessageResult[@t-if=&quot;messageSearch.searching or messageSearch.searched&quot;]" position="replace">
            <SearchMessageResult t-if="!this.isPortalConversationTabActive() and (messageSearch.searching or messageSearch.searched)"
                                 thread="state.thread"
                                 messageSearch="messageSearch"
                                 onClickJump.bind="closeSearch"/>
        </xpath>

        <xpath expr="//Thread[@t-else='']" position="replace">
            <Thread t-if="!this.isPortalConversationTabActive() and !(messageSearch.searching or messageSearch.searched)"
                    thread="state.thread"
                    t-key="state.thread.localId"
                    order="'desc'"
                    scrollRef="rootRef"
                    jumpPresent="state.jumpThreadPresent"/>
            <div t-if="this.isPortalConversationTabActive()"
                 class="wex-portal-conversation-page h-100 d-flex flex-column">
                <div class="wex-portal-conversation-page__header d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="wex-portal-conversation-page__eyebrow">Conversación portal</div>
                        <div class="wex-portal-conversation-page__title">Histórico SAT-cliente</div>
                    </div>
                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            t-on-click="openPortalConversationRecord">
                        Abrir conversación
                    </button>
                </div>

                <div t-if="state.portalConversationLoading"
                     class="wex-portal-conversation-page__loading">
                    Cargando conversación...
                </div>

                <div t-elif="this.portalConversationItems.length"
                     class="wex-portal-conversation-page__stream">
                    <t t-foreach="this.portalConversationItems" t-as="item" t-key="item.type + '-' + item.id + '-' + item.label">
                        <div t-if="item.type === 'date_separator'"
                             class="wex-portal-conversation-page__date">
                            <t t-out="item.label"/>
                        </div>
                        <div t-elif="item.type === 'message'"
                             t-att-class="'wex-portal-conversation-page__message ' + (item.is_customer ? 'is-customer' : 'is-technician')">
                            <div class="wex-portal-conversation-page__meta">
                                <strong><t t-out="item.author_name"/></strong>
                                <span><t t-out="item.created_at_label"/></span>
                            </div>
                            <div class="wex-portal-conversation-page__body">
                                <t t-out="item.body"/>
                            </div>
                        </div>
                    </t>
                </div>

                <div t-else=""
                     class="wex-portal-conversation-page__empty">
                    Aún no hay conversación portal asociada a este SAT.
                </div>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('o-mail-Chatter-content')]" position="after">
            <div t-if="this.isPortalConversationSupportedThread()"
                 class="wex-portal-conversation-footer d-print-none">
                <button type="button"
                        t-att-class="'wex-portal-conversation-footer__tab ' + (state.portalConversationTab === 'chatter' ? 'is-active' : '')"
                        t-on-click="onClickChatterTab">
                    Chatter
                </button>
                <button type="button"
                        t-att-class="'wex-portal-conversation-footer__tab ' + (state.portalConversationTab === 'portal_conversation' ? 'is-active' : '')"
                        t-on-click="onClickPortalConversationTab">
                    Conversación portal
                    <span t-if="this.portalConversationMessageCount"
                          class="wex-portal-conversation-footer__count">
                        <t t-out="this.portalConversationMessageCount"/>
                    </span>
                </button>
            </div>
        </xpath>

    </t>

</templates>
