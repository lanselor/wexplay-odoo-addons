<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_portal_repair_reply_wizard_form" model="ir.ui.view">
        <field name="name">wex.portal.repair.reply.wizard.form</field>
        <field name="model">wex.portal.repair.reply.wizard</field>
        <field name="arch" type="xml">
            <form string="Responder al cliente">
                <group>
                    <field name="conversation_id" readonly="1"/>
                    <field name="mark_no_response_needed"/>
                    <field name="body"
                           placeholder="Escribe aquí la respuesta visible para el cliente..."
                           required="not mark_no_response_needed"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
