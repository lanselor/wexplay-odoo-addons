<odoo>
    <record id="view_wex_return_resolve_form" model="ir.ui.view">
        <field name="name">wex.return.resolve.form</field>
        <field name="model">wex.return.resolve</field>
        <field name="arch" type="xml">
            <form string="Resolver sin enviar" class="wex_return_prepare">
                <field name="company_id" invisible="1"/>
                <div class="wex_pl_form_title wex_return_heading">
                    <div>
                        <div class="wex_pl_form_kicker"><i class="fa fa-undo"/> Decisión excepcional</div>
                        <h2><field name="product_id" nolabel="1" options="{'no_open': True}"/></h2>
                    </div>
                </div>
                <p class="text-muted">Utiliza esta opción solo si la pieza finalmente no se enviará o necesita revisión. No modifica el SAT ni la venta de origen.</p>
                <group>
                    <field name="return_id" string="Devolución"/>
                    <field name="disposition" required="1"/>
                    <field name="quantity"/>
                    <field name="destination_location_id" invisible="disposition != 'recover'" required="disposition == 'recover'" domain="[('usage', '=', 'internal'), ('active', '=', True), ('scrap_location', '=', False), ('company_id', '=', company_id)]" options="{'no_create': True}"/>
                    <field name="package_id" invisible="disposition == 'hold'" options="{'no_create': True}"/>
                    <field name="explanation" required="1" placeholder="Explica el cambio de decisión"/>
                </group>
                <div class="alert alert-info" invisible="disposition != 'hold'">La pieza seguirá apartada y pendiente. Esta anotación no impedirá preparar su envío posteriormente.</div>
                <div class="alert alert-warning" invisible="disposition != 'scrap'">Se abrirá un documento de desecho de Odoo para revisarlo y validarlo. Hasta entonces las unidades seguirán pendientes de devolución.</div>
                <footer>
                    <button name="action_resolve" type="object" string="Confirmar decisión" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_wex_return_resolution_form" model="ir.ui.view">
        <field name="name">wex.return.resolution.form</field>
        <field name="model">wex.return.resolution</field>
        <field name="arch" type="xml">
            <form string="Resolución excepcional" create="0" edit="0" delete="0" duplicate="0">
                <group>
                    <field name="return_id"/>
                    <field name="disposition"/>
                    <field name="quantity"/>
                    <field name="state"/>
                    <field name="destination_location_id" invisible="disposition != 'recover'"/>
                    <field name="explanation"/>
                    <field name="create_uid" string="Registrado por"/>
                    <field name="create_date" string="Fecha"/>
                    <field name="picking_id" invisible="not picking_id"/>
                    <field name="scrap_ids" invisible="not scrap_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
            </form>
        </field>
    </record>
    <record id="view_stock_scrap_wex_return_resolution" model="ir.ui.view">
        <field name="name">stock.scrap.wex.return.resolution</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="wex_return_resolution_id" string="Resolución de devolución" readonly="1" invisible="not wex_return_resolution_id" groups="wex_purchase_list.group_wex_purchase_list_user"/>
            </xpath>
        </field>
    </record>
</odoo>
