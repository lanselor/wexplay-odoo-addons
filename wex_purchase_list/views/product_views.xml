<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <record id="product_template_form_inherit_wex_vendor_url" model="ir.ui.view">
        <field name="name">product.template.form.inherit.wex.vendor.url</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            
            <!-- Campo URL proveedor (tu cambio actual) -->
            <xpath expr="//page[@name='purchase']" position="inside">
                <group string="Wexplay">
                    <field name="wex_vendor_url" widget="url"/>
                </group>
            </xpath>
            
            <!-- NUEVO: PVP con IVA debajo de Precio de venta -->
            <xpath expr="//field[@name='standard_price']" position="after">
                <separator string="Cálculo de Precios y Margen (Wexplay)" class="mt-4 mb-2"/>
                
                <group name="wexplay_pricing">
                    <group>
                        <label for="wex_list_price_tax_included"/>
                        <div class="o_row">
                            <field name="wex_list_price_tax_included" class="oe_inline"/>
                            <span class="text-muted">IVA Incl.</span>
                        </div>
                        
                        <label for="wex_margin_percent"/>
                        <div class="o_row">
                            <field name="wex_margin_percent" class="oe_inline" style="width: 70px !important;"/>
                            <span>%</span>
                        </div>
                    </group>
                    
                    <group>
                        <field name="wex_suggested_price_tax_included" 
                               string="Sugerencia (PVP)" 
                               decoration-bf="1" 
                               decoration-info="1"
                               widget="monetary"/>
                        <p class="text-muted small" colspan="2">
                            * Precio recomendado basado en el margen sobre el coste.
                        </p>
                    </group>
                </group>
            </xpath>
            
        </field>
    </record>
    
</odoo>
