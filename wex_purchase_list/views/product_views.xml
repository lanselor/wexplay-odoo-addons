<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <record id="product_template_form_inherit_wex_vendor_url" model="ir.ui.view">
        <field name="name">product.template.form.inherit.wex.vendor.url</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            
            <!-- Botón de añadir a lista desde ficha de producto -->
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_add_to_purchase_list"
                    type="object"
                    string="Añadir a lista"
                    class="btn-primary"
                    context="{'wex_qty': 1.0}"
                    invisible="type == 'service'"
                    />
            </xpath>
            
            
            
            <!-- Campo URL proveedor (tu cambio actual) -->
            <xpath expr="//page[@name='purchase']" position="inside">
                <group string="Wexplay">
                    <field name="wex_vendor_url" widget="url"/>
                </group>
            </xpath>
            
            <xpath expr="//field[@name='standard_price']" position="after">
                <separator string="Precio Wexplay" class="mt-4 mb-2"/>

                <group name="wexplay_pricing" string="Cálculo rápido de PVP">
                    <field name="wex_list_price_tax_included"
                           string="PVP con IVA"
                           widget="monetary"/>
                    <field name="wex_margin_percent"
                           string="Margen sobre venta (%)"/>
                    <field name="wex_suggested_price_tax_included"
                           string="Sugerencia PVP con IVA"
                           widget="monetary"
                           readonly="1"/>
                    <button name="action_apply_wex_suggested_price"
                            type="object"
                            string="Aplicar sugerencia"
                            icon="fa-magic"
                            class="btn btn-secondary"
                            invisible="not wex_suggested_price_tax_included"/>
                    <p class="text-muted small" colspan="2">
                        La sugerencia se calcula con margen sobre venta y se redondea siempre hacia arriba al siguiente precio acabado en 0 o 5.
                    </p>
                </group>
            </xpath>
            
        </field>
    </record>
    
</odoo>
