<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- Smart button en sale.order -->
    <record id="view_sale_order_form_inherit_wex_purchase_list" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.wex.purchase.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class,'oe_button_box')]" position="inside">
                <button type="object"
                        name="action_view_purchase_list_lines"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        string="Lista de compra">
                    <field name="purchase_list_line_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
    
    <!-- Botón en líneas -->
    <record id="view_sale_order_form_line_inherit_wex_purchase_list" model="ir.ui.view">
        <field name="name">sale.order.form.line.inherit.wex.purchase.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']//field[@name='order_line']//list" position="inside">
                <field name="product_id" invisible="1"/>
                <button name="action_add_to_purchase_list"
                        type="object"
                        string="Añadir a lista"
                        class="btn btn-outline-success"
                        attrs="{
                            'invisible': [
                            '|',
                            ('purchase_list_line_id', '!=', False),
                            ('product_id.product_tmpl_id.detailed_type', '=', 'service')
                            ]
                            }"/>
                <field name="purchase_list_line_id" optional="hide"/>
            </xpath>
        </field>
    </record>
    
</odoo>
