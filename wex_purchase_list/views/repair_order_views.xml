<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- Smart button en repair.order -->
    <record id="view_repair_order_form_inherit_wex_purchase_list" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.wex.purchase.list</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.repair_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class,'oe_button_box')]" position="inside">
                <button type="object"
                        name="action_view_purchase_list_lines"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        string="Lista de compra">
                    <field name="purchase_list_line_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
    
    <!-- Botón en líneas de Piezas: intento 1 (field name=operations) -->
    <record id="view_repair_order_form_parts_inherit_wex_purchase_list_ops" model="ir.ui.view">
        <field name="name">repair.order.form.parts.inherit.wex.purchase.list.ops</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.repair_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[.//field[@name='operations']]//field[@name='operations']//list" position="inside">
                <button name="action_add_to_purchase_list"
                        type="object"
                        string="Añadir a lista"
                        class="btn btn-secondary"
                        attrs="{'invisible': [('purchase_list_line_id','!=',False)]}"/>
                <field name="purchase_list_line_id" optional="hide"/>
            </xpath>
        </field>
    </record>
    
    <!-- Botón en líneas de Piezas: intento 2 (field name=line_ids) -->
    <record id="view_repair_order_form_parts_inherit_wex_purchase_list_lines" model="ir.ui.view">
        <field name="name">repair.order.form.parts.inherit.wex.purchase.list.lines</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.repair_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[.//field[@name='line_ids']]//field[@name='line_ids']//list" position="inside">
                <button name="action_add_to_purchase_list"
                        type="object"
                        string="Añadir a lista"
                        class="btn btn-secondary"
                        attrs="{'invisible': [('purchase_list_line_id','!=',False)]}"/>
                <field name="purchase_list_line_id" optional="hide"/>
            </xpath>
        </field>
    </record>
    
</odoo>
