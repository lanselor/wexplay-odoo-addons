<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- List View (main) -->
    <record id="view_wex_purchase_list_line_list" model="ir.ui.view">
        <field name="name">wex_purchase_list.line.list</field>
        <field name="model">wex_purchase_list.line</field>
        <field name="arch" type="xml">
            <list string="Lista de compra (Wexplay)" editable="bottom"
                  decoration-warning="state == 'draft_wait_customer'"
                  decoration-info="state == 'ordered'"
                  decoration-success="state == 'received'"
                  decoration-danger="state == 'cancelled'">
                <field name="requested_by" string="Solicitado por" optional="show"/>
                <field name="product_id" string="Producto" required="1"/>
                <field name="quantity" string="Cantidad"/>
                <field name="vendor_id" string="Proveedor" required="1" />
                <field name="vendor_url" string="URL proveedor" widget="url" optional="show"/>
                <field name="state" string="Estado"/>
                <field name="is_reservation" string="Reserva"/>
                <field name="customer_notified" string="Cliente avisado"/>
                <field name="customer_price_note" string="Precio al cliente" widget="monetary" optional="show"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_wex_purchase_list_line_form" model="ir.ui.view">
        <field name="name">wex_purchase_list.line.form</field>
        <field name="model">wex_purchase_list.line</field>
        <field name="arch" type="xml">
            <form string="Línea de lista de compra (Wexplay)">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" string="Compañía" groups="base.group_multi_company"/>
                            <field name="requested_by" string="Solicitado por"/>
                            <field name="state" string="Estado"/>
                        </group>
                        <group>
                            <field name="product_id" string="Producto"/>
                            <field name="quantity" string="Cantidad"/>
                            <field name="vendor_id" string="Proveedor"/>
                            <field name="vendor_url" string="URL proveedor" widget="url"/>
                        </group>
                    </group>
                    
                    <group>
                        <group>
                            <field name="is_reservation" string="Reserva"/>
                            <field name="customer_notified" string="Cliente avisado"/>
                        </group>
                        <group>
                            <field name="customer_price_note" string="Precio al cliente" widget="monetary"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="notes" string="Notas"
                               placeholder="Notas internas, detalles para el pedido, reservas, etc."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_wex_purchase_list_line_search" model="ir.ui.view">
        <field name="name">wex_purchase_list.line.search</field>
        <field name="model">wex_purchase_list.line</field>
        <field name="arch" type="xml">
            <search string="Buscar en lista de compra">
                <field name="product_id" string="Producto"/>
                <field name="requested_by" string="Solicitado por"/>
                <field name="vendor_id" string="Proveedor"/>
                <field name="state" string="Estado"/>
                
                <filter string="Esperando cliente (no pedir)" name="f_wait" domain="[('state','=','draft_wait_customer')]"/>
                <filter string="Pedido realizado" name="f_ordered" domain="[('state','=','ordered')]"/>
                <filter string="Recibido" name="f_received" domain="[('state','=','received')]"/>
                <filter string="Cancelado" name="f_cancelled" domain="[('state','=','cancelled')]"/>
                
                <separator/>
                
                <filter string="Reserva" name="f_reservation" domain="[('is_reservation','=',True)]"/>
                <filter string="Cliente avisado" name="f_notified" domain="[('customer_notified','=',True)]"/>
                
                <group expand="0" string="Agrupar por">
                    <filter string="Solicitado por" name="gb_requested_by" context="{'group_by':'requested_by'}"/>
                    <filter string="Proveedor" name="gb_vendor" context="{'group_by':'vendor_id'}"/>
                    <filter string="Estado" name="gb_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_wex_purchase_list_line" model="ir.actions.act_window">
        <field name="name">Lista de compra</field>
        <field name="res_model">wex_purchase_list.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_wex_purchase_list_line_list"/>
        <field name="search_view_id" ref="view_wex_purchase_list_line_search"/>
        <field name="context">{'search_default_f_wait': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Lista de compra (Fase 1).
            </p>
            <p>
                Añade repuestos a pedir, proveedor y enlace rápido.
            </p>
        </field>
    </record>
    
    <!-- Menu: Compras → Lista de compra (Wexplay) -->
    <menuitem id="menu_wex_purchase_list_root"
              name="Lista de compra (Wexplay)"
              parent="purchase.menu_purchase_root"
              action="action_wex_purchase_list_line"
              sequence="60"/>
    
</odoo>
