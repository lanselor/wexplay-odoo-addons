<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- List View (main) -->
    <record id="view_wex_purchase_list_line_list" model="ir.ui.view">
        <field name="name">wex_purchase_list.line.list</field>
        <field name="model">wex_purchase_list.line</field>
        <field name="arch" type="xml">
            <list string="Purchase List (Wexplay)" editable="bottom"
                  decoration-warning="state == 'draft_wait_customer'"
                  decoration-info="state == 'ordered'"
                  decoration-success="state == 'received'"
                  decoration-danger="state == 'cancelled'">
                <field name="requested_by" optional="show"/>
                <field name="product_id" required="1"/>
                <field name="quantity"/>
                <field name="vendor_id" optional="show"/>
                <field name="vendor_url" widget="url" optional="show"/>
                <field name="state"/>
                <field name="is_reservation"/>
                <field name="customer_notified"/>
                <field name="customer_price_note" widget="monetary" optional="show"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_wex_purchase_list_line_form" model="ir.ui.view">
        <field name="name">wex_purchase_list.line.form</field>
        <field name="model">wex_purchase_list.line</field>
        <field name="arch" type="xml">
            <form string="Purchase List Line (Wexplay)">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="requested_by"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="vendor_id"/>
                            <field name="vendor_url" widget="url"/>
                        </group>
                    </group>
                    
                    <group>
                        <group>
                            <field name="is_reservation"/>
                            <field name="customer_notified"/>
                        </group>
                        <group>
                            <field name="customer_price_note" widget="monetary"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="notes" placeholder="Notas internas, detalles para el pedido, reservas, etc."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_wex_purchase_list_line_search" model="ir.ui.view">
        <field name="name">wex_purchase_list.line.search</field>
        <field name="model">wex_purchase_list.line</field>
        <field name="arch" type="xml">
            <search string="Search Purchase List">
                <field name="product_id"/>
                <field name="requested_by"/>
                <field name="vendor_id"/>
                <field name="state"/>
                
                <filter string="Waiting customer" name="f_wait" domain="[('state','=','draft_wait_customer')]"/>
                <filter string="Ordered" name="f_ordered" domain="[('state','=','ordered')]"/>
                <filter string="Received" name="f_received" domain="[('state','=','received')]"/>
                <filter string="Cancelled" name="f_cancelled" domain="[('state','=','cancelled')]"/>
                
                <separator/>
                
                <filter string="Reservation" name="f_reservation" domain="[('is_reservation','=',True)]"/>
                <filter string="Customer notified" name="f_notified" domain="[('customer_notified','=',True)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Requested by" name="gb_requested_by" context="{'group_by':'requested_by'}"/>
                    <filter string="Vendor" name="gb_vendor" context="{'group_by':'vendor_id'}"/>
                    <filter string="State" name="gb_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_wex_purchase_list_line" model="ir.actions.act_window">
        <field name="name">Lista de compra</field>
        <field name="res_model">wex_purchase_list.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_wex_purchase_list_line_list"/>
        <field name="search_view_id" ref="view_wex_purchase_list_line_search"/>
        <field name="context">{'search_default_f_wait': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Lista de la Compra (Fase 1).
            </p>
            <p>
                Añade repuestos a pedir, proveedor y enlace rápido.
            </p>
        </field>
    </record>
    
    <!-- Menu: Compras → Lista de compra (Wexplay) -->
    <menuitem id="menu_wex_purchase_list_root"
              name="Lista de compra (Wexplay)"
              parent="purchase.menu_purchase_root"
              action="action_wex_purchase_list_line"
              sequence="60"/>
    
</odoo>
