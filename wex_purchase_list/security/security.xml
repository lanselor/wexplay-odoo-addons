<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Groups -->
    <record id="group_wex_purchase_list_user" model="res.groups">
        <field name="name">Wexplay Purchase List User</field>
        <field name="category_id" ref="base.module_category_purchase_management"/>
    </record>
    
    <record id="group_wex_purchase_list_manager" model="res.groups">
        <field name="name">Wexplay Purchase List Manager</field>
        <field name="category_id" ref="base.module_category_purchase_management"/>
        <!-- IMPORTANT: refer to local xmlid without module prefix -->
        <field name="implied_ids" eval="[(4, ref('group_wex_purchase_list_user'))]"/>
    </record>
    
    <!-- Record Rules -->
    <!-- USERS: Read all lines (shared sheet behavior) -->
    <record id="rule_wex_purchase_list_user_read_all" model="ir.rule">
        <field name="name">Wex Purchase List - User: read all</field>
        <field name="model_id" ref="model_wex_purchase_list_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_wex_purchase_list_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    
    <!-- USERS: Create lines -->
    <record id="rule_wex_purchase_list_user_create_all" model="ir.rule">
        <field name="name">Wex Purchase List - User: create</field>
        <field name="model_id" ref="model_wex_purchase_list_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_wex_purchase_list_user'))]"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    
    <!-- USERS: Write only own lines -->
    <record id="rule_wex_purchase_list_user_write_own" model="ir.rule">
        <field name="name">Wex Purchase List - User: write own</field>
        <field name="model_id" ref="model_wex_purchase_list_line"/>
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_wex_purchase_list_user'))]"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    
    <!-- MANAGERS: Full access -->
    <record id="rule_wex_purchase_list_manager_full" model="ir.rule">
        <field name="name">Wex Purchase List - Manager: full</field>
        <field name="model_id" ref="model_wex_purchase_list_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_wex_purchase_list_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
