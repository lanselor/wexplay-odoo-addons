<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_wex_purchase_list_user" model="res.groups">
        <field name="name">Wexplay Purchase List User</field>
        <field name="category_id" ref="base.module_category_purchase_management"/>
    </record>
    <record id="group_wex_purchase_list_manager" model="res.groups">
        <field name="name">Wexplay Purchase List Manager</field>
        <field name="category_id" ref="base.module_category_purchase_management"/>
        <field name="implied_ids" eval="[(4, ref('wex_purchase_list.group_wex_purchase_list_user'))]"/>
    </record>
    <record id="rule_wex_purchase_list_user_company_scope" model="ir.rule">
        <field name="name">Wex Purchase List - User: allowed companies</field>
        <field name="model_id" ref="model_wex_purchase_list_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('wex_purchase_list.group_wex_purchase_list_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_wex_purchase_list_manager_full" model="ir.rule">
        <field name="name">Wex Purchase List - Manager: full</field>
        <field name="model_id" ref="model_wex_purchase_list_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('wex_purchase_list.group_wex_purchase_list_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
