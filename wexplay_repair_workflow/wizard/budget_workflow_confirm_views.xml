<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_wex_budget_workflow_confirm_wizard_form" model="ir.ui.view">
        <field name="name">wex.budget.workflow.confirm.wizard.form</field>
        <field name="model">wex.budget.workflow.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar acción" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="repair_id" invisible="1"/>
                        <field name="action_key" invisible="1"/>
                        <field name="message" nolabel="1" readonly="1" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirmar"
                            class="btn btn-primary"/>
                    <button string="Descartar"
                            special="cancel"
                            class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
