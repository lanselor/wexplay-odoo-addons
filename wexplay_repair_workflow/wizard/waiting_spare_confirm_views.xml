<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <record id="view_wex_waiting_spare_confirm_wizard_form" model="ir.ui.view">
        <field name="name">wex.waiting.spare.confirm.wizard.form</field>
        <field name="model">wex.waiting.spare.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar pendiente de repuesto" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <p>
                            Estás intentando mover la orden de trabajo a <strong>Pendiente de repuesto</strong>,
                            pero no hay ningún repuesto asociado a la reparación.
                            ¿Deseas continuar?
                        </p>
                        <field name="repair_id" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_waiting_spare"
                            type="object"
                            string="Sí, continuar"
                            class="btn btn-primary"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>