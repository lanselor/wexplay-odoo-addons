<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_repair_warranty_claim_wizard_form" model="ir.ui.view">
        <field name="name">wex.repair.warranty.claim.wizard.form</field>
        <field name="model">wex.repair.warranty.claim.wizard</field>
        <field name="arch" type="xml">
            <form string="Tramitar garantía">
                <group>
                    <field name="repair_id" invisible="1"/>
                    <field name="is_out_of_warranty" invisible="1"/>
                    <field name="can_override_expired_warranty" invisible="1"/>

                    <div class="alert alert-info" role="alert">
                        ¿Está seguro de que desea tramitar la garantía?
                    </div>

                    <field name="override_expired_warranty"
                           invisible="not is_out_of_warranty"
                           required="is_out_of_warranty"
                           readonly="not can_override_expired_warranty"/>

                    <div class="alert alert-warning"
                         role="alert"
                         invisible="not is_out_of_warranty or can_override_expired_warranty">
                        La orden está fuera de plazo y su usuario no tiene permisos para forzar la tramitación.
                    </div>
                </group>
                <footer>
                    <button name="action_confirm_claim"
                            type="object"
                            string="Sí, tramitar garantía"
                            class="btn btn-primary"/>
                    <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
