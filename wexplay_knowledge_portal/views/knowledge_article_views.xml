<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_knowledge_article_form_portal" model="ir.ui.view">
        <field name="name">wex.knowledge.article.form.portal</field>
        <field name="model">wex.knowledge.article</field>
        <field name="inherit_id" ref="wex_knowledge.view_wex_knowledge_article_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="can_manage_external_publication" invisible="1"/>
            </xpath>
            <xpath expr="//div[@class='wex_kb_workspace_nav'][.//div[text()='Acceso interno']]" position="after">
                <div class="wex_kb_workspace_nav">
                    <div class="wex_kb_sidebar_heading">Canales externos</div>
                    <div class="text-muted">
                        Solo los artículos publicados pueden exponerse fuera del entorno interno.
                    </div>
                    <div class="wex_kb_external_channel_block">
                        <div class="wex_kb_external_channel_header">
                            <strong>Portal general</strong>
                            <span class="text-muted">Hace visible el artículo en el listado del portal.</span>
                        </div>
                        <field name="portal_visible"
                               string="Visible en portal"
                               readonly="id and not can_manage_external_publication"/>
                        <button name="action_publish_to_portal"
                                type="object"
                                string="Publicar en portal"
                                class="btn btn-primary"
                                invisible="portal_visible or not can_manage_external_publication"/>
                    </div>
                    <div class="wex_kb_external_channel_block">
                        <div class="wex_kb_external_channel_header">
                            <strong>Contactos concretos</strong>
                            <span class="text-muted">Permite enseñar este artículo solo a clientes portal seleccionados.</span>
                        </div>
                        <field name="portal_contact_ids"
                               string="Contactos autorizados"
                               widget="many2many_tags"
                               readonly="id and not can_manage_external_publication"
                               options="{'no_create': True}"/>
                    </div>
                    <div class="wex_kb_external_channel_block">
                        <div class="wex_kb_external_channel_header">
                            <strong>Enlace público</strong>
                            <span class="text-muted">Genera un acceso directo compartible sin entrar al portal.</span>
                        </div>
                        <field name="public_link_enabled"
                               string="Enlace público activo"
                               readonly="id and not can_manage_external_publication"/>
                        <button name="action_generate_public_link"
                                type="object"
                                string="Generar enlace público"
                                class="btn btn-secondary"
                                invisible="public_link_enabled or not can_manage_external_publication"/>
                        <field name="public_access_expires_at"
                               string="Caduca el"
                               readonly="id and not can_manage_external_publication"
                               invisible="not public_link_enabled"/>
                        <div class="text-muted" invisible="not public_link_enabled">
                            Disponible hasta esta fecha.
                        </div>
                    </div>
                    <div class="wex_kb_portal_public_link" invisible="not public_link_enabled or not public_access_token">
                        <field name="public_link_url" widget="url" readonly="1"/>
                    </div>
                    <button name="action_regenerate_public_access_token"
                            type="object"
                            string="Regenerar enlace público"
                            class="btn btn-link p-0"
                            invisible="not public_link_enabled or not can_manage_external_publication"/>
                    <div class="wex_kb_sidebar_meta_row" invisible="not id">
                        <span>Vistas portal</span>
                        <strong><field name="portal_view_count" readonly="1" nolabel="1"/></strong>
                    </div>
                    <div class="wex_kb_sidebar_meta_row" invisible="not id">
                        <span>Vistas públicas</span>
                        <strong><field name="public_view_count" readonly="1" nolabel="1"/></strong>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@class='wex_kb_workspace_main']" position="inside">
                <div class="wex_kb_workspace_floating_bar" invisible="not name">
                    <div class="wex_kb_workspace_floating_bar_inner">
                        <div class="wex_kb_workspace_floating_context">
                            <span class="wex_kb_workspace_floating_label">Base de conocimiento</span>
                            <strong><field name="name" readonly="1" nolabel="1"/></strong>
                        </div>
                        <div class="wex_kb_workspace_floating_actions">
                            <button name="action_publish"
                                    type="object"
                                    string="Publicar"
                                    class="btn btn-primary"
                                    invisible="state == 'published' or not can_publish or not can_edit"
                                    groups="wex_knowledge.group_knowledge_editor,wex_knowledge.group_knowledge_manager"/>
                            <div class="wex_kb_workspace_floating_state">
                                <span>Estado editorial</span>
                                <field name="state" widget="badge" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
