<odoo>
    <record id="spreadsheet_dashboard_wex_accounting" model="spreadsheet.dashboard">
        <field name="name">Wex Accounting Overview</field>
        <field name="spreadsheet_binary_data" type="base64" file="wex_accounting_portal/data/files/accounting_dashboard.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('model_wex_accounting_dashboard_report'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"/>
        <field name="group_ids" eval="[Command.link(ref('account.group_account_readonly')), Command.link(ref('account.group_account_invoice'))]"/>
        <field name="sequence">25</field>
        <field name="is_published">True</field>
    </record>
</odoo>
