<odoo>
    <record id="group_wex_accounting_portal" model="res.groups">
        <field name="name">Wex Accounting Portal</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Read-only portal access to Wexplay sales invoices and POS sales.</field>
    </record>

    <record id="wex_accounting_dashboard_report_rule_multi_company" model="ir.rule">
        <field name="name">Wex Accounting Dashboard Report multi-company</field>
        <field name="model_id" ref="model_wex_accounting_dashboard_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_readonly')), (4, ref('account.group_account_invoice'))]"/>
    </record>
</odoo>
