<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_wexplay_repair_images" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wexplay.repair.images</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="wexplay_repair.res_config_settings_view_form_wexplay_repair"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='wexplay_sat_dms_settings']" position="after">
                <block title="Imágenes SAT" name="wexplay_sat_image_settings">
                    <setting string="Comprimir imágenes al subir"
                             help="Redimensiona y recomprime cada imagen antes de guardarla en DMS.">
                        <field name="x_sat_image_compress_enabled"/>
                    </setting>
                    <setting string="Resolución máxima (px)"
                             help="Lado más largo en píxeles. Las imágenes más pequeñas no se modifican."
                             invisible="not x_sat_image_compress_enabled">
                        <field name="x_sat_image_max_px"/>
                    </setting>
                    <setting string="Calidad JPEG / WebP"
                             help="Valor entre 1 y 95. 85 es el equilibrio recomendado."
                             invisible="not x_sat_image_compress_enabled">
                        <field name="x_sat_image_quality"/>
                    </setting>
                </block>
                <block title="Vídeos SAT" name="wexplay_sat_video_settings">
                    <setting string="Comprimir vídeos al subir" help="Convierte los vídeos a MP4 compatible en segundo plano.">
                        <field name="x_sat_video_compress_enabled"/>
                    </setting>
                    <setting string="Resolución máxima (px)" invisible="not x_sat_video_compress_enabled">
                        <field name="x_sat_video_max_px"/>
                    </setting>
                    <setting string="Calidad de vídeo (CRF)" help="Valores mayores reducen el tamaño y la calidad." invisible="not x_sat_video_compress_enabled">
                        <field name="x_sat_video_crf"/>
                    </setting>
                    <setting string="Duración máxima (segundos)"><field name="x_sat_video_max_duration_seconds"/></setting>
                    <setting string="Tamaño máximo de origen (MB)"><field name="x_sat_video_max_size_mb"/></setting>
                    <setting string="Ruta de FFmpeg" help="Ejecutable de FFmpeg disponible para el servicio Odoo."><field name="x_sat_video_ffmpeg_path"/></setting>
                    <setting string="Ruta de FFprobe" help="Ejecutable de FFprobe disponible para el servicio Odoo."><field name="x_sat_video_ffprobe_path"/></setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
