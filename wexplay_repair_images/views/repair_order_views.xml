<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_repair_order_form_wex_repair_images" model="ir.ui.view">
        <field name="name">repair.order.form.wex.repair.images</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="wex_consent.view_repair_order_form_wex_consent"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="x_image_count" invisible="1"/>
            </xpath>

            <xpath expr="//notebook[hasclass('wex_consent_notebook')]/page[1]" position="replace">
                <page string="Imágenes" groups="wexplay_image_core.group_wex_image_user">
                    <div class="wex_repair_images_panel">
                    <div class="d-flex flex-wrap gap-2 mb-3 wex_repair_images_panel__toolbar">
                        <button name="action_open_image_upload_wizard"
                                type="object"
                                string="Subir imágenes"
                                class="btn btn-primary"/>
                        <div class="text-muted align-self-center wex_repair_images_panel__counter">
                            <field name="x_image_count" nolabel="1" readonly="1"/> imágenes registradas
                        </div>
                    </div>

                    <field name="x_image_ids"
                           nolabel="1"
                           context="{'default_repair_order_id': id}"
                           mode="list,form">
                        <list create="0" class="wex_repair_images_list">
                            <field name="sequence" widget="handle"/>
                            <field name="preview_image" string="Imagen" widget="image" options="{'size': [72, 72]}"/>
                            <field name="name" string="Nombre"/>
                            <field name="description" string="Descripción"/>
                            <field name="tag_ids" string="Etiquetas" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <button name="action_open_preview" type="object" string="Vista previa" class="btn btn-link"/>
                            <button name="action_open_dms_file" type="object" string="DMS" class="btn btn-link"/>
                        </list>
                        <form>
                            <sheet class="wex_repair_images_inline_form">
                                <group col="2">
                                    <group string="Datos de la imagen">
                                        <field name="name" readonly="1"/>
                                        <field name="description"/>
                                        <field name="sequence"/>
                                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                        <field name="dms_file_name" readonly="1"/>
                                        <field name="dms_file_id" readonly="1"/>
                                    </group>
                                    <group string="Vista previa">
                                        <field name="preview_image" widget="image" options="{'preview_image': 'preview_image', 'size': [0, 900]}"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
