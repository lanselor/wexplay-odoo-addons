<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="queue_job_channel_sat_video" model="queue.job.channel">
        <field name="name">sat_video</field>
        <field name="parent_id" ref="queue_job.channel_root"/>
    </record>

    <record id="queue_job_function_process_sat_video" model="queue.job.function">
        <field name="model_id" ref="model_wex_repair_media_process_job"/>
        <field name="method">process_queued_video</field>
        <field name="channel_id" ref="queue_job_channel_sat_video"/>
        <field name="retry_pattern" eval="{1: 30, 2: 120}"/>
        <field name="allow_commit" eval="True"/>
    </record>
</odoo>
