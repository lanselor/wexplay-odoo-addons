<odoo>
  <!-- IMPORTANTE:
       - id estable para el módulo
       - t-name EXACTO para que lo encuentre tu ir.actions.report existente
  -->
  <template id="report_product_label_ql700_62x29">
    <t t-name="wexplay_product_print.report_product_label_ql700_62x29">
      <t t-call="web.basic_layout">
        <style>
          :root {
            --paper_w: 62mm; /* ancho real */
            --paper_h: 29mm; /* alto */
            --pad: 2mm;
          }

          @page {
            size: var(--paper_w) var(--paper_h);
            margin: 0;
          }

          html,
          body,
          main {
            margin: 0 !important;
            padding: 0 !important;
            background: #fff;
          }

          /* Área etiqueta (papel real) */
          .label-wrapper {
            width: var(--paper_w);
            height: var(--paper_h);
            box-sizing: border-box;
            padding: var(--pad);
            overflow: hidden;
            background: #fff;
          }

          .content {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
          }

          .product-name {
            font-size: 18pt;
            font-weight: 800;
            line-height: 1.05;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          }

          .product-price {
            font-size: 22pt;
            font-weight: 900;
            line-height: 1;
            white-space: nowrap;
            text-align: right;
            margin-top: 1mm;
          }

          .bottom-ref {
            border-top: 0.2mm solid #000;
            font-size: 14pt;
            font-family: monospace;
            padding-top: 1mm;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 1mm;
          }
        </style>

        <main>
          <t t-foreach="docs" t-as="o">
            <div class="label-wrapper">
              <div class="content">

                <div class="product-name">
                  <t t-esc="o.name or o.display_name or ''"/>
                </div>

                <div class="bottom-ref">
                  <t t-esc="o.default_code or ''"/>
                </div>

                <div class="product-price">
                  <!-- Base de precio (en product.template suele ser lst_price; en algunos contextos puede venir list_price) -->
                  <t t-set="base_price" t-value="(o.lst_price or o.list_price or 0.0)"/>

                  <!-- Moneda segura: product.template NO suele tener currency_id; usar la de la compañía -->
                  <t t-set="company" t-value="o.company_id or env.company"/>
                  <t t-set="currency" t-value="company.currency_id"/>

                  <!-- Impuestos del producto (pueden estar vacíos) -->
                  <t t-set="taxes" t-value="o.taxes_id"/>

                  <!-- compute_all solo si hay taxes, si no usa base_price -->
                  <t t-set="price_inc"
                     t-value="(taxes and taxes.compute_all(base_price, currency=currency, quantity=1.0, product=o, partner=False).get('total_included')) or base_price"/>

                  <!-- Formateo oficial Odoo -->
                  <t t-esc="format_amount(env, price_inc, currency)"/>
                </div>

              </div>
            </div>
          </t>
        </main>
      </t>
    </t>
  </template>
</odoo>