<odoo>
  <!-- IMPORTANTE:
       - id estable para el módulo
       - t-name EXACTO para que lo encuentre tu ir.actions.report existente
  -->
  <template id="report_product_label_ql700_62x29">
    <t t-name="wexplay_product_print.report_product_label_ql700_62x29">
      <t t-call="web.basic_layout">
        <style>
          :root {
            --paper_w: 62mm; /* ancho real */
            --paper_h: 29mm; /* alto */
            --pad: 2mm;
          }

          @page {
            size: var(--paper_w) var(--paper_h);
            margin: 0;
          }

          html,
          body,
          main {
            margin: 0 !important;
            padding: 0 !important;
            background: #fff;
          }

          /* Área etiqueta (papel real) */
          .label-wrapper {
            width: var(--paper_w);
            height: var(--paper_h);
            box-sizing: border-box;
            padding: var(--pad);
            overflow: hidden;
            background: #fff;
          }

          .content {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
          }

          .product-name {
            font-size: 18pt;
            font-weight: 800;
            line-height: 1.05;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          }

          .product-price {
            font-size: 22pt;
            font-weight: 900;
            line-height: 1;
            white-space: nowrap;
            text-align: right;
            margin-top: 1mm;
          }

          .bottom-ref {
            border-top: 0.2mm solid #000;
            font-size: 14pt;
            font-family: monospace;
            padding-top: 1mm;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 1mm;
          }
        </style>

        <main>
          <t t-foreach="docs" t-as="o">
            <div class="label-wrapper">
              <div class="content">

                <div class="product-name">
                  <t t-esc="o.name or o.display_name or ''"/>
                </div>

                <div class="bottom-ref">
                  <t t-esc="o.default_code or ''"/>
                </div>

                <div class="product-price">
                  <!-- Precio base: product.template -->
                  <t t-set="base_price" t-value="o.list_price or 0.0"/>

                  <!-- Moneda: la de la compañía (currency_id en product.template no es fiable) -->
                  <t t-set="company" t-value="o.company_id or env.company"/>
                  <t t-set="currency" t-value="company.currency_id"/>

                  <!-- Impuestos -->
                  <t t-set="taxes" t-value="o.taxes_id"/>
                  <t t-set="res"
                     t-value="taxes and taxes.compute_all(base_price, currency=currency, quantity=1.0, product=o, partner=None)"/>

                  <!-- Total con IVA -->
                  <t t-set="price_inc" t-value="(res and res.get('total_included')) or base_price"/>

                  <!-- Formato simple (como en tu XML original funcional) -->
                  <t t-set="sym" t-value="(currency and currency.symbol) or '€'"/>
                  <t t-esc="('%0.2f %s' % (price_inc, sym))"/>
                </div>


              </div>
            </div>
          </t>
        </main>
      </t>
    </t>
  </template>
</odoo>