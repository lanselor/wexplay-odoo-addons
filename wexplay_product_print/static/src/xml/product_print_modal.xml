<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wexplay_product_print.PrintCenterModal">
        <div class="p-3">
            <h5 class="mb-3">Centro de impresión</h5>
            <div class="mb-3">
                <div class="fw-bold mb-2">Etiquetas (Brother QL-700)</div>
                <button type="button" class="btn btn-primary me-2" t-on-click="printProductLabel">
                    Etiqueta de producto
                </button>
                <button type="button" class="btn btn-outline-primary" disabled="1">
                    Etiqueta SAT (más adelante)
                </button>
            </div>
            <div class="mt-4 text-end">
                <button type="button" class="btn btn-secondary" t-on-click="onClose">Cerrar</button>
            </div>
        </div>
    </t>
</templates>