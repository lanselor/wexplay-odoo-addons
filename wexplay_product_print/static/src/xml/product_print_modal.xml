<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wexplay_product_print.PrintCenterModal">
        <div class="modal fade show d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content border-0 shadow-lg">
                    
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <i class="fa fa-barcode me-2"></i>Centro de Impresión - Productos
                        </h5>
                        <button type="button" class="btn-close btn-close-white" t-on-click="close" aria-label="Close"/>
                    </div>

                    <div class="modal-body p-4">
                        <div class="section-container p-3 border rounded bg-light">
                            <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">
                                <i class="fa fa-cog me-2"></i>Configuración de Etiquetas
                            </h6>

                            <div class="d-flex flex-column gap-3">
                                <label class="fw-bold text-dark mb-0">Cantidad a imprimir</label>
                                
                                <div class="d-flex align-items-center gap-2">
                                    <div class="input-group" style="max-width: 150px;">
                                        <button type="button" class="btn btn-secondary px-3" 
                                                t-on-click="decrementQty" title="Restar">
                                            <i class="fa fa-minus"></i>
                                        </button>
                                        
                                        <input type="number"
                                               class="form-control text-center fw-bold"
                                               min="1" step="1"
                                               t-att-value="state.qty"
                                               t-on-input="onQtyInput"/>
                                        
                                        <button type="button" class="btn btn-secondary px-3" 
                                                t-on-click="incrementQty" title="Sumar">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </div>

                                    <button type="button" class="btn btn-primary flex-grow-1 py-2 shadow-sm"
                                            t-on-click="printProductLabel">
                                        <i class="fa fa-print me-2"></i> Imprimir Etiqueta
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-top-0 justify-content-center">
                        <button type="button" class="btn btn-link text-muted" t-on-click="close">
                            Cancelar y Salir
                        </button>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    </t>
</templates>