<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wex_print_profile_tree" model="ir.ui.view">
        <field name="name">wex.print.profile.tree</field>
        <field name="model">wex.print.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="legacy_kind"/>
                <field name="printer_name"/>
                <field name="company_id"/>
                <field name="allow_fallback"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_wex_print_profile_form" model="ir.ui.view">
        <field name="name">wex.print.profile.form</field>
        <field name="model">wex.print.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="legacy_kind"/>
                        <field name="printer_name"/>
                        <field name="company_id"/>
                        <field name="allow_fallback"/>
                        <field name="copies_override"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wex_print_assignment_tree" model="ir.ui.view">
        <field name="name">wex.print.assignment.tree</field>
        <field name="model">wex.print.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="priority"/>
                <field name="document_type_id"/>
                <field name="profile_id"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_wex_print_assignment_form" model="ir.ui.view">
        <field name="name">wex.print.assignment.form</field>
        <field name="model">wex.print.assignment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="priority"/>
                        <field name="document_type_id"/>
                        <field name="profile_id"/>
                        <field name="user_id"/>
                        <field name="company_id"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wex_print_trace_tree" model="ir.ui.view">
        <field name="name">wex.print.trace.tree</field>
        <field name="model">wex.print.trace</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="document_code"/>
                <field name="legacy_kind"/>
                <field name="printer_name"/>
                <field name="next_resolution_found"/>
                <field name="next_printer_name"/>
                <field name="shadow_matches_legacy"/>
                <field name="success"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="action_wex_print_profiles" model="ir.actions.act_window">
        <field name="name">Print Profiles</field>
        <field name="res_model">wex.print.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_wex_print_assignments" model="ir.actions.act_window">
        <field name="name">Print Assignments</field>
        <field name="res_model">wex.print.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_wex_print_traces" model="ir.actions.act_window">
        <field name="name">Print Traces</field>
        <field name="res_model">wex.print.trace</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_wex_print_root" name="Wex Print" sequence="90" groups="wex_print_core.group_wex_print_core_admin"/>
    <menuitem id="menu_wex_print_profiles" name="Profiles" parent="menu_wex_print_root" action="action_wex_print_profiles" sequence="10" groups="wex_print_core.group_wex_print_core_admin"/>
    <menuitem id="menu_wex_print_assignments" name="Assignments" parent="menu_wex_print_root" action="action_wex_print_assignments" sequence="20" groups="wex_print_core.group_wex_print_core_admin"/>
    <menuitem id="menu_wex_print_traces" name="Traces" parent="menu_wex_print_root" action="action_wex_print_traces" sequence="30" groups="wex_print_core.group_wex_print_core_admin"/>
</odoo>
