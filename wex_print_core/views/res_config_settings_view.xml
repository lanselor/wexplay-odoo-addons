<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wex_print_core_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">wex_print_core.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Wexplay Print / QZ" name="wex_print_core_qz" logo="/wex_print_core/static/description/icon.png">

                    <block title="Estado y Diagnóstico" name="wexplay_status_block">
                        <setting string="Conexión QZ Tray" help="Estado actual del servicio QZ Tray en este navegador.">
                            <field name="wex_qz_ui" widget="wex_qz_settings_widget"/>

                            <div class="content-group mt-3 border-start ps-3">
                                <div class="row">
                                    <div class="col-12 text-muted mb-2">
                                        <i class="fa fa-info-circle me-1"/> Información del último diagnóstico
                                    </div>
                                    <div class="col-md-6">
                                        <span class="fw-bold">Resultado:</span> <field name="wex_qz_last_test_ok" class="ms-1"/>
                                    </div>
                                    <div class="col-md-6">
                                        <span class="fw-bold">Fecha:</span> <field name="wex_qz_last_test_at" class="ms-1"/>
                                    </div>
                                    <div class="col-md-12 mt-1">
                                        <span class="fw-bold">Ejecutado por:</span> <field name="wex_qz_last_test_user_id" class="ms-1"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Configuración de Impresoras" name="wexplay_printers_block">
                        <div class="text-muted mb-3">
                            <i class="fa fa-print me-1"/> Define las impresoras predeterminadas para cada formato de documento.
                        </div>
                        <div class="row mt-2">
                            <setting string="Etiquetas (ZPL/EPL)" help="Usada para etiquetas Brother o Zebra.">
                                <field name="wex_qz_label_device_id" options="{'no_create': False}"/>
                                <field name="wex_qz_label_printer" placeholder="Ej: Brother_QL_800"/>
                            </setting>

                            <setting string="Térmica (Ticket)" help="Para tickets de resguardo de 80mm.">
                                <field name="wex_qz_thermal_device_id" options="{'no_create': False}"/>
                                <field name="wex_qz_thermal_printer" placeholder="Ej: EPSON_TM_T20"/>
                            </setting>

                            <setting string="A4 Estándar" help="Impresora de oficina convencional.">
                                <field name="wex_qz_a4_device_id" options="{'no_create': False}"/>
                                <field name="wex_qz_a4_printer" placeholder="Ej: HP_LaserJet_Pro"/>
                            </setting>
                        </div>
                    </block>

                    <block title="Seguridad QZ" name="wexplay_security_block">
                        <setting string="Modo de seguridad"
                                 help="'Sin certificado' usa el modo sin firma de QZ (puede mostrar prompts en el navegador). 'Con certificado' requiere un certificado RSA configurado abajo.">
                            <field name="wex_qz_security_mode"/>
                        </setting>
                        <div invisible="wex_qz_security_mode != 'signed'" class="mt-2">
                            <div class="alert alert-warning" role="alert">
                                <i class="fa fa-lock me-1"/>
                                La clave privada se almacena en la base de datos. Asegúrate de que el acceso a Odoo está protegido adecuadamente.
                            </div>
                            <setting string="Certificado público (.crt)"
                                     help="Pega aquí el contenido del archivo .crt generado con keytool. Empieza por -----BEGIN CERTIFICATE-----.">
                                <field name="wex_qz_certificate" widget="text" style="font-family: monospace; font-size: 0.8rem;"/>
                            </setting>
                            <setting string="Clave privada (.pem)"
                                     help="Pega aquí el contenido de la clave privada en formato PEM. Empieza por -----BEGIN RSA PRIVATE KEY-----.">
                                <field name="wex_qz_private_key" widget="text" style="font-family: monospace; font-size: 0.8rem;" password="True"/>
                            </setting>
                        </div>
                    </block>

                    <block title="Opciones Avanzadas" name="wexplay_advanced_block">
                        <div class="row">
                            <setting string="Modo de Resolución" help="Define qué capa decide la impresión: legacy, híbrida o nueva.">
                                <field name="wex_print_mode"/>
                            </setting>
                            <setting string="Modo Depuración" help="Muestra logs detallados en la consola del navegador.">
                                <field name="wex_qz_debug"/>
                            </setting>

                            <setting string="Permitir Fallback" help="Si falla QZ, usar el diálogo de impresión nativo.">
                                <field name="wex_qz_allow_fallback"/>
                            </setting>
                        </div>
                    </block>

                </app>
            </xpath>
        </field>
    </record>
</odoo>
