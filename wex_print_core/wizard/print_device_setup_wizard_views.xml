<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wex_print_device_setup_wizard_form" model="ir.ui.view">
        <field name="name">wex.print.device.setup.wizard.form</field>
        <field name="model">wex.print.device.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Configurar impresora detectada" create="0">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        El asistente creará o ampliará la configuración documental de esta impresora. Reutiliza perfiles compatibles y no modifica la configuración legacy.
                    </div>
                    <group string="1. Impresora detectada">
                        <field name="snapshot_id" invisible="1"/>
                        <field name="existing_device_id" invisible="1"/>
                        <field name="qz_printer_name" readonly="existing_device_id"/>
                        <field name="name" readonly="existing_device_id"/>
                        <field name="model_hint" readonly="existing_device_id"/>
                        <field name="backend" readonly="existing_device_id"/>
                        <field name="device_kind" readonly="existing_device_id"/>
                        <field name="company_id" readonly="existing_device_id"/>
                    </group>
                    <group string="2. Documentos que imprimirá">
                        <field name="document_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="wizard_device_kind" column_invisible="1"/>
                                <field name="document_type_id"/>
                                <field name="report_action_id"/>
                                <field name="paperformat_id"/>
                            </list>
                        </field>
                    </group>
                    <group string="3. Regla de impresión">
                        <field name="user_id"/>
                        <field name="priority"/>
                        <field name="allow_fallback"/>
                        <field name="pilot_use_new_resolution"/>
                        <field name="duplex_mode" invisible="device_kind != 'a4'"/>
                        <field name="notes" placeholder="Notas sobre ubicación, puesto o mantenimiento..."/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        La resolución nueva queda desactivada por defecto. Prueba la asignación y actívala después desde Wex Print cuando la impresora esté validada.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Crear configuración" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
