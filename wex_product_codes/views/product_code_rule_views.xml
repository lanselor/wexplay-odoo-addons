<odoo>
    <record id="view_wex_product_code_rule_list" model="ir.ui.view">
        <field name="name">wex.product.code.rule.list</field>
        <field name="model">wex.product.code.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="active"/>
                <field name="categ_id"/>
                <field name="prefix"/>
                <field name="sequence_id"/>
                <field name="padding"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    
    <record id="view_wex_product_code_rule_form" model="ir.ui.view">
        <field name="name">wex.product.code.rule.form</field>
        <field name="model">wex.product.code.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_sequence" type="object" string="Create/Attach Sequence" class="btn-primary"/>
                    <button name="action_generate_missing_codes" type="object" string="Generate Missing Codes" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="company_id"/>
                        <field name="categ_id"/>
                        <field name="prefix"/>
                        <field name="padding"/>
                        <field name="sequence_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_wex_product_code_rules" model="ir.actions.act_window">
        <field name="name">Product Code Rules</field>
        <field name="res_model">wex.product.code.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
