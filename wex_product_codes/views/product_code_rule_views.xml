<odoo>
    <record id="view_wex_product_code_rule_list" model="ir.ui.view">
        <field name="name">wex.product.code.rule.list</field>
        <field name="model">wex.product.code.rule</field>
        <field name="arch" type="xml">
            <list string="Reglas de referencias">
                <field name="active" string="Activo"/>
                <field name="company_id" string="Empresa"/>
                <field name="categ_id" string="Categoría de producto"/>
                <field name="prefix" string="Prefijo"/>
                <field name="padding" string="Relleno (nº dígitos)"/>
                <field name="sequence_id" string="Secuencia"/>
            </list>
        </field>
    </record>
    
    <record id="view_wex_product_code_rule_form" model="ir.ui.view">
        <field name="name">wex.product.code.rule.form</field>
        <field name="model">wex.product.code.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de referencias">
                <header>
                    <button name="action_create_sequence"
                            type="object"
                            string="Crear / Asociar secuencia"
                            class="btn-primary"/>
                    <button name="action_generate_missing_codes"
                            type="object"
                            string="Generar referencias pendientes"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="active" string="Activo"/>
                        <field name="company_id" string="Empresa"/>
                        <field name="categ_id" string="Categoría de producto"/>
                        <field name="prefix" string="Prefijo"/>
                        <field name="padding" string="Relleno (nº dígitos)"/>
                        <field name="sequence_id" string="Secuencia" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_wex_product_code_rules" model="ir.actions.act_window">
        <field name="name">Reglas de referencias</field>
        <field name="res_model">wex.product.code.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
