<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="chatter_whatsapp_button" inherit_id="mail.Chatter" name="Chatter WhatsApp Button" owl="1">
        <xpath expr="//div[contains(@class, 'o_Chatter_topbar')]" position="inside">
            <button type="button"
                    class="btn btn-success btn-sm ms-2"
                    t-on-click="onClickWhatsApp">
                <i class="fa fa-whatsapp me-1"/>
                WhatsApp
            </button>
        </xpath>
    </template>
</odoo>
