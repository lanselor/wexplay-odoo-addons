<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Extend OWL template mail.Chatter -->
    <t t-name="wex_whatsapp_chatter.chatter_whatsapp_button"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension"
       owl="1">

        <!-- Insert right after "Send message" button in topbar -->
        <xpath expr="//button[contains(@class,'o-mail-Chatter-sendMessage')]" position="after">
            <button type="button"
                    class="btn btn-link text-nowrap o-mail-Chatter-topbar-button o_whatsapp_btn d-flex align-items-center"
                    groups="wex_whatsapp_chatter.group_whatsapp_user"
                    t-on-click="() => this.onClickWhatsApp()"
                    style="color: #25D366; font-weight: 500;">
                <i class="fa fa-whatsapp me-1" style="font-size: 1.2em;"/>
                <span>WhatsApp</span>
            </button>
        </xpath>

    </t>

</templates>
