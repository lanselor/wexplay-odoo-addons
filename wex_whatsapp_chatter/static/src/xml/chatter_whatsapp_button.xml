<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        QWeb assets REQUIRE a template with t-name somewhere in the file.
        We define one, and inside we extend mail.Chatter to inject our button.
    -->
    <t t-name="wex_whatsapp_chatter.chatter_whatsapp_button" owl="1">

        <t t-extend="mail.Chatter">
            <!-- Insert the button in the chatter topbar -->
            <t t-jquery=".o_Chatter_topbar" t-operation="append">
                <button type="button"
                        class="btn btn-success btn-sm ms-2"
                        t-on-click="onClickWhatsApp">
                    <i class="fa fa-whatsapp me-1"/>
                    WhatsApp
                </button>
            </t>
        </t>

    </t>

</templates>
