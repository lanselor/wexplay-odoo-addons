<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Extend OWL/QWeb template from mail -->
    <t t-name="wex_whatsapp_chatter.ChatterWhatsAppButton"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension"
       owl="1">

        <xpath expr="//div[contains(@class, 'o_Chatter_topbar')]" position="inside">
            <button type="button"
                    class="btn btn-success btn-sm ms-2"
                    t-on-click="onClickWhatsApp">
                <i class="fa fa-whatsapp me-1"/>
                WhatsApp
            </button>
        </xpath>

    </t>

</templates>
