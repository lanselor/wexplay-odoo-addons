<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">Plantillas</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
    
    <record id="view_whatsapp_template_list" model="ir.ui.view">
        <field name="name">whatsapp.template.list</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="res_model"/>
                <field name="context_group"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de WhatsApp">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="name" string="Nombre de la Plantilla"/>
                        <h1>
                            <field name="name" placeholder="Ej: Confirmación de Pedido" required="1"/>
                        </h1>
                    </div>
                    
                    <div class="mt-4 p-3 border rounded shadow-sm bg-white">
                        <div class="o_horizontal_separator text-uppercase fw-bold mb-3" style="font-size: 0.75rem; color: #714B67;">
                            <i class="fa fa-cog me-2"/> Configuración General
                        </div>
                        <group>
                            <group>
                                <field name="res_model" placeholder="sale.order / account.move / repair.order"/>
                                <field name="context_group"/>
                                <field name="sequence"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </div>
                    
                    <div class="mt-4 p-3 border rounded shadow-sm bg-white">
                        <div class="o_horizontal_separator text-uppercase fw-bold mb-3" style="font-size: 0.75rem; color: #25D366;">
                            <i class="fa fa-whatsapp me-2"/> Cuerpo del Mensaje
                        </div>
                        <group string="Message" invisible="1">
                        </group>
                        <div class="mt-2">
                            <field name="body" 
                                   nolabel="1" 
                                   placeholder="Escribe aquí el mensaje de WhatsApp..." 
                                   style="min-height: 200px; border-radius: 10px; background-color: #f8f9fa; border: 1px solid #dee2e6; padding: 15px; box-shadow: inset 0 1px 3px rgba(0,0,0,0.05); font-family: sans-serif;"/>
                        </div>
                        <div class="oe_grey mt-2 small">
                            <i class="fa fa-lightbulb-o me-1"/> 
                            <strong>Consejo:</strong> Usa asteriscos para *negrita* y guiones bajos para _cursiva_.
                        </div>
   
                    </div>
                    
                    <!-- Situamos las leyendas y los placeholders de cada uno de los distintos tipos -->
                    
                    <div class="mt-4 p-3 border rounded shadow-sm bg-white">
                        <div class="o_horizontal_separator text-uppercase fw-bold mb-3" style="font-size: 0.75rem; color: #714B67;">
                            <i class="fa fa-info-circle me-2"/> Ayuda de variables
                        </div>
                        <div class="alert alert-info mt-2 mb-0 small shadow-sm">
                            <div class="d-flex align-items-start gap-2 mb-3">
                                <i class="fa fa-info-circle mt-1"/>
                                <div>
                                    <strong>Variables disponibles para el cuerpo del WhatsApp</strong>
                                    <div class="text-muted mt-1">
                                        Puedes copiar una variable y pegarla en el mensaje. Se sustituirá al abrir el wizard según el documento, cliente, compañía o usuario activo.
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-lg-6">
                                    <div class="p-3 bg-white rounded border h-100">
                                        <div class="fw-bold text-uppercase text-muted mb-2">Directos</div>
                                        <div class="mb-2">
                                            <code><span>$</span>{portal_url}</code>
                                            <div class="text-muted">Enlace del portal nativo de Odoo. Úsalo para cotizaciones, pedidos o facturas.</div>
                                        </div>
                                        <div class="mb-2">
                                            <code><span>$</span>{dispositivo}</code>
                                            <div class="text-muted">Tipo, marca y modelo del dispositivo cuando el documento SAT tiene datos de dispositivo.</div>
                                        </div>
                                        <div class="mb-2">
                                            <code><span>$</span>{importe}</code>
                                            <div class="text-muted">Importe del documento. En SAT usa el campo Total SAT cuando existe cotización asociada.</div>
                                        </div>
                                        <div>
                                            <code><span>$</span>{referencia_cliente}</code>
                                            <div class="text-muted">Referencia del cliente en la reparación. Usa <code><span>$</span>{object.x_customer_reference}</code> internamente.</div>
                                        </div>
                                        <div class="mt-2">
                                            <code><span>$</span>{notasreparacion}</code>
                                            <div class="text-muted">Notas de reparación del notebook inferior de SAT. Lee <code><span>$</span>{object.internal_notes}</code> y lo convierte a texto limpio para WhatsApp.</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <div class="p-3 bg-white rounded border h-100">
                                        <div class="fw-bold text-uppercase text-muted mb-2">Documento activo</div>
                                        <div class="text-muted mb-2">Usa <code><span>$</span>{object.campo}</code> para leer campos del documento desde el que se abre el wizard.</div>
                                        <div class="d-flex flex-wrap gap-1">
                                            <code><span>$</span>{object.name}</code>
                                            <code><span>$</span>{object.partner_id.name}</code>
                                            <code><span>$</span>{object.partner_id.phone}</code>
                                            <code><span>$</span>{object.company_id.name}</code>
                                            <code><span>$</span>{object.amount_total}</code>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <div class="p-3 bg-white rounded border h-100">
                                        <div class="fw-bold text-uppercase text-muted mb-2">SAT / Reparación</div>
                                        <div class="text-muted mb-2">Variables útiles para plantillas de <span class="fw-semibold">repair.order</span>.</div>
                                        <div class="d-flex flex-wrap gap-1">
                                            <code><span>$</span>{object.name}</code>
                                            <code><span>$</span>{object.x_customer_reference}</code>
                                            <code><span>$</span>{object.x_reported_issue}</code>
                                            <code><span>$</span>{object.x_model_id.name}</code>
                                            <code><span>$</span>{object.x_brand_id.name}</code>
                                            <code><span>$</span>{object.x_device_type}</code>
                                            <code><span>$</span>{dispositivo}</code>
                                            <code><span>$</span>{importe}</code>
                                            <code><span>$</span>{referencia_cliente}</code>
                                            <code><span>$</span>{notasreparacion}</code>
                                            <code><span>$</span>{object.internal_notes}</code>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <div class="p-3 bg-white rounded border h-100">
                                        <div class="fw-bold text-uppercase text-muted mb-2">Cliente</div>
                                        <div class="text-muted mb-2">Siempre usa el cliente seleccionado en el wizard, aunque el documento origen sea otro.</div>
                                        <div class="d-flex flex-wrap gap-1">
                                            <code><span>$</span>{partner.name}</code>
                                            <code><span>$</span>{partner.phone}</code>
                                            <code><span>$</span>{partner.mobile}</code>
                                            <code><span>$</span>{partner.email}</code>
                                            <code><span>$</span>{partner.vat}</code>
                                            <code><span>$</span>{partner.country_id.name}</code>
                                            <code><span>$</span>{partner.parent_id.name}</code>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <div class="p-3 bg-white rounded border h-100">
                                        <div class="fw-bold text-uppercase text-muted mb-2">Compañía</div>
                                        <div class="text-muted mb-2">Datos de la empresa activa en el wizard.</div>
                                        <div class="d-flex flex-wrap gap-1">
                                            <code><span>$</span>{company.name}</code>
                                            <code><span>$</span>{company.email}</code>
                                            <code><span>$</span>{company.phone}</code>
                                            <code><span>$</span>{company.vat}</code>
                                            <code><span>$</span>{company.currency_id.name}</code>
                                            <code><span>$</span>{company.partner_id.street}</code>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <div class="p-3 bg-white rounded border h-100">
                                        <div class="fw-bold text-uppercase text-muted mb-2">Usuario</div>
                                        <div class="text-muted mb-2">Datos del usuario que está preparando el WhatsApp.</div>
                                        <div class="d-flex flex-wrap gap-1">
                                            <code><span>$</span>{user.name}</code>
                                            <code><span>$</span>{user.email}</code>
                                            <code><span>$</span>{user.company_id.name}</code>
                                            <code><span>$</span>{user.partner_id.mobile}</code>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 text-muted fst-italic">
                                Los campos vacíos o inexistentes se sustituyen por vacío. Fechas, números y moneda se formatean automáticamente cuando el campo lo permite.
                            </div>
                        </div>
                    </div>
                    
                </sheet>
            </form>
        </field>
    </record>
</odoo>
