<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">Plantillas</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
    
    <record id="view_whatsapp_template_list" model="ir.ui.view">
        <field name="name">whatsapp.template.list</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas">
                <field name="name"/>
                <field name="res_model"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de WhatsApp">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="name" string="Nombre de la Plantilla"/>
                        <h1>
                            <field name="name" placeholder="Ej: Confirmación de Pedido" required="1"/>
                        </h1>
                    </div>
                    
                    <div class="mt-4 p-3 border rounded shadow-sm bg-white">
                        <div class="o_horizontal_separator text-uppercase fw-bold mb-3" style="font-size: 0.75rem; color: #714B67;">
                            <i class="fa fa-cog me-2"/> Configuración General
                        </div>
                        <group>
                            <group>
                                <field name="res_model" placeholder="sale.order / account.move / repair.order"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </div>
                    
                    <div class="mt-4 p-3 border rounded shadow-sm bg-white">
                        <div class="o_horizontal_separator text-uppercase fw-bold mb-3" style="font-size: 0.75rem; color: #25D366;">
                            <i class="fa fa-whatsapp me-2"/> Cuerpo del Mensaje
                        </div>
                        <group string="Message" invisible="1">
                        </group>
                        <div class="mt-2">
                            <field name="body" 
                                   nolabel="1" 
                                   placeholder="Escribe aquí el mensaje de WhatsApp..." 
                                   style="min-height: 200px; border-radius: 10px; background-color: #f8f9fa; border: 1px solid #dee2e6; padding: 15px; box-shadow: inset 0 1px 3px rgba(0,0,0,0.05); font-family: sans-serif;"/>
                        </div>
                        <div class="oe_grey mt-2 small">
                            <i class="fa fa-lightbulb-o me-1"/> 
                            <strong>Consejo:</strong> Usa asteriscos para *negrita* y guiones bajos para _cursiva_.
                        </div>
   
                    </div>
                    
                    <!-- Situamos las leyendas y los placeholders de cada uno de los distintos tipos -->
                    
                    <div class="mt-4 p-3 border rounded shadow-sm bg-white">
                        <div class="alert alert-info mt-2 mb-3 small shadow-sm">
                            <i class="fa fa-info-circle me-1"/>
                            <strong>Variables disponibles:</strong>
                            <div class="mt-2">
                                
                                <!-- 1) Directos -->
                                <div class="mb-2">
                                    <div class="fw-bold">1) <span class="font-monospace"><h3>Directos</h3></span></div>                             
                                    <div class="mt-1">
                                        <code>$&#8203;{portal_url}</code>
                                        <span class="text-muted">→ Enlace al portal (solo <span class="fw-semibold">sale.order</span> / <span class="fw-semibold">account.move</span>, requiere documento válido).</span>
                                    </div>
                                    <div class="mt-1">
                                        <code>$&#8203;{dispositivo}</code>
                                        <span class="text-muted">→ Tipo · Marca · Modelo (si el documento tiene campos de dispositivo; si no, vacío).</span>
                                    </div>
                                    <div class="mt-1">
                                        <code>$&#8203;{importe}</code>
                                        <span class="text-muted">→ Importe total del SAT (solo <span class="fw-semibold">repair.order</span> / SAT).</span>
                                    </div>
                                </div>
                                
                                <!-- 2) object.* -->
                                <div class="mb-2">
                                    <div class="fw-bold">2) <span class="font-monospace"><h3>Referencias al documento desde donde se envia.*</h3></span></div>
                                    <div class="text-muted">Campos del documento activo (con dot-path seguro).</div>
                                    <div class="mt-1">
                                        <code>$&#8203;{object.name}</code>,
                                        <code>$&#8203;{object.date_order}</code>,
                                        <code>$&#8203;{object.partner_id.name}</code>,
                                        <code>$&#8203;{object.partner_id.phone}</code>,
                                        <code>$&#8203;{object.partner_id.country_id.name}</code>,
                                        <code>$&#8203;{object.company_id.name}</code>
                                    </div>
                                    
                                    <div class="mt-1 text-muted">
                                        Importes (solo Sales/Invoices si existe el campo):
                                        <code>$&#8203;{object.amount_total}</code>
                                    </div>
                                    
                                    <div class="mt-1 text-muted">
                                        Reparaciones (si existen):
                                        <code>$&#8203;{object.x_model_id.name}</code>,
                                        <code>$&#8203;{object.x_brand_id.name}</code>,
                                        <code>$&#8203;{object.x_device_type}</code>
                                    </div>
                                </div>
                                
                                <!-- 3) partner.* -->
                                <div class="mb-2">
                                    <div class="fw-bold">3) <span class="font-monospace"><h3>Cliente.*</h3></span></div>
                                    <div class="text-muted">Siempre usa el cliente seleccionado en el wizard.</div>
                                    <div class="mt-1">
                                        <code>$&#8203;{partner.name}</code>,
                                        <code>$&#8203;{partner.phone}</code>,
                                        <code>$&#8203;{partner.mobile}</code>,
                                        <code>$&#8203;{partner.email}</code>,
                                        <code>$&#8203;{partner.vat}</code>,
                                        <code>$&#8203;{partner.country_id.name}</code>,
                                        <code>$&#8203;{partner.parent_id.name}</code>
                                    </div>
                                </div>
                                
                                <!-- 4) company.* -->
                                <div class="mb-2">
                                    <div class="fw-bold">4) <span class="font-monospace"><h3>Compañía.*</h3></span></div>
                                    <div class="text-muted">Empresa activa del wizard (o empresa actual).</div>
                                    <div class="mt-1">
                                        <code>$&#8203;{company.name}</code>,
                                        <code>$&#8203;{company.email}</code>,
                                        <code>$&#8203;{company.phone}</code>,
                                        <code>$&#8203;{company.vat}</code>,
                                        <code>$&#8203;{company.currency_id.name}</code>,
                                        <code>$&#8203;{company.partner_id.street}</code>
                                    </div>
                                </div>
                                
                                <!-- 5) user.* -->
                                <div class="mb-2">
                                    <div class="fw-bold">5) <span class="font-monospace"><h3>Empleado.</h3></span></div>
                                    <div class="text-muted">Usuario/Empleado actual.</div>
                                    <div class="mt-1">
                                        <code>$&#8203;{user.name}</code>,
                                        <code>$&#8203;{user.email}</code>,
                                        <code>$&#8203;{user.company_id.name}</code>,
                                        <code>$&#8203;{user.partner_id.mobile}</code>
                                    </div>
                                </div>
                               
                                <!-- 6) Formateo -->
                                <div class="mb-1">
                                    <div class="fw-bold">6) <span class="font-monospace"><h3>Formateo automático</h3></span></div>
                                    <div class="text-muted">
                                        Números y moneda se formatean según idioma/moneda si el objeto tiene <span class="fw-semibold">currency_id</span>.
                                        Fechas (<span class="fw-semibold">date/datetime</span>) se formatean según idioma/zona horaria.
                                    </div>
                                </div>
                                
                            </div>
                            
                            <div class="mt-2 text-muted fst-italic">
                                Escribe las variables tal cual aparecen arriba en tu mensaje.
                            </div>
                        </div>
                    </div>
                    
                </sheet>
            </form>
        </field>
    </record>
</odoo>