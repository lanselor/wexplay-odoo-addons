<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- MENÚ RAÍZ (APP) -->
    <menuitem
        id="menu_whatsapp_root"
        name="WhatsApp"
        sequence="10"
        action="wex_whatsapp_chatter.action_whatsapp_template"
        groups="wex_whatsapp_chatter.group_whatsapp_user"
        />
    
    <!-- Set icon + (opcional) reescribir campos del menú raíz -->
    <record id="menu_whatsapp_root" model="ir.ui.menu">
        <!-- IMPORTANTE: web_icon es lo que mejor pinta el icono en el launcher -->
        <field name="web_icon">wex_whatsapp_chatter,static/description/icon.png</field>
    </record>
    
    <!-- SUBMENÚS -->
    <menuitem
        id="menu_whatsapp_compose"
        name="Redactar WhatsApp"
        parent="wex_whatsapp_chatter.menu_whatsapp_root"
        action="wex_whatsapp_chatter.action_whatsapp_compose_wizard"
        sequence="10"
        groups="wex_whatsapp_chatter.group_whatsapp_user"
        />
    
    <menuitem
        id="menu_whatsapp_templates"
        name="Plantillas"
        parent="wex_whatsapp_chatter.menu_whatsapp_root"
        action="wex_whatsapp_chatter.action_whatsapp_template"
        sequence="20"
        groups="wex_whatsapp_chatter.group_whatsapp_user"
        />
    
</odoo>