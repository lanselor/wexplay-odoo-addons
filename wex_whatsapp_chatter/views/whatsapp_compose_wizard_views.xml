<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_whatsapp_compose_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.compose.wizard.form</field>
        <field name="model">whatsapp.compose.wizard</field>
        <field name="arch" type="xml">
            <form string="Redactar WhatsApp">
                <sheet>
                    <div class="alert alert-secondary d-flex align-items-center mb-3 py-2 shadow-sm" role="alert" invisible="not res_model">
                        <i class="fa fa-whatsapp me-2" style="font-size: 1.2rem; color: #25D366;"/>
                        <span class="fw-bold">Redactando mensaje para: </span>
                        <field name="res_model" class="ms-1 fw-normal text-muted" readonly="1"/>
                    </div>

                    <notebook>
                        <page string="Rapido">
                            <group name="main_config">
                                <group string="Destinatario">
                                    <field name="partner_id" string="Cliente" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="phone_source" string="Origen Telefono"/>
                                    <field name="phone_number" string="Numero de Telefono" placeholder="+34XXXXXXXXX"/>
                                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                </group>

                                <group string="Plantilla">
                                    <field name="template_id"
                                           string="Seleccionar Plantilla"
                                           widget="wex_whatsapp_template_picker"
                                           domain="[('res_model', '=', res_model)]"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>

                            <div class="mt-4">
                                <label for="rendered_body" string="Vista previa del mensaje" class="fw-bold text-uppercase small text-muted mb-2 d-block"/>
                                <field name="rendered_body"
                                       nolabel="1"
                                       widget="text"
                                       placeholder="El mensaje se generara aqui al seleccionar una plantilla..."
                                       style="min-height: 180px; border-radius: 10px; background-color: #f8f9fa; border: 1px solid #dee2e6; padding: 15px; box-shadow: inset 0 1px 3px rgba(0,0,0,0.05);"/>
                                <field name="rendered_body_preview_html"
                                       nolabel="1"
                                       readonly="1"
                                       widget="html"
                                       class="mt-3"/>
                            </div>
                        </page>

                        <page string="Portal">
                            <div class="mt-1 p-3 border rounded shadow-sm bg-white">
                                <div class="o_horizontal_separator text-uppercase fw-bold mb-3" style="font-size: 0.75rem; color: #714B67;">
                                    <i class="fa fa-file-text-o me-2"/> Enlace de portal
                                </div>

                                <div class="text-muted small mb-3">
                                    <i class="fa fa-info-circle me-1"/>
                                    Selecciona que enlace quieres insertar. Las cotizaciones y facturas se filtran por el cliente del wizard.
                                </div>

                                <group col="2" class="mt-0">
                                    <field name="portal_link_type" string="Tipo de enlace"/>
                                    <field name="sale_order_id"
                                           string="Cotizacion / pedido"
                                           placeholder="Seleccione cotizacion o pedido..."
                                           domain="[('partner_id', 'child_of', portal_commercial_partner_id)]"
                                           invisible="portal_link_type != 'sale_order'"/>
                                    <field name="account_move_id"
                                           string="Factura"
                                           placeholder="Seleccione factura..."
                                           domain="[('partner_id', 'child_of', portal_commercial_partner_id), ('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '!=', 'cancel')]"
                                           invisible="portal_link_type != 'account_move'"/>
                                </group>
                                <field name="portal_commercial_partner_id" invisible="1"/>

                                <div class="mt-2 p-2 rounded d-flex align-items-center"
                                     style="background-color: #f8f9fa; border: 1px solid #e9ecef;"
                                     invisible="not portal_link_status">
                                    <i class="fa fa-info-circle me-2 text-muted"/>
                                    <field name="portal_link_status" class="text-muted" readonly="1"/>
                                </div>

                                <div class="mt-2 p-2 rounded d-flex align-items-center" style="background-color: #e9ecef; border: 1px dashed #ced4da;" invisible="not portal_url">
                                    <i class="fa fa-link me-2 text-primary"/>
                                    <span class="fw-bold text-muted me-2">Enlace generado: </span>
                                    <field name="portal_url" class="text-primary" widget="url" readonly="1"/>
                                </div>
                                <field name="portal_link_available" invisible="1"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button string="Abrir WhatsApp"
                            type="object"
                            name="action_open_whatsapp"
                            class="btn-success"
                            icon="fa-whatsapp"
                            style="padding: 0.6rem 1.2rem; font-weight: bold;"/>

                    <button string="Insertar enlace portal"
                            type="object"
                            name="action_insert_portal_link"
                            class="btn-outline-primary"
                            icon="fa-magic"
                            help="Genera el enlace del portal y lo inserta en el cuerpo del mensaje"/>

                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_compose_wizard" model="ir.actions.act_window">
        <field name="name">Redactar WhatsApp</field>
        <field name="res_model">whatsapp.compose.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
