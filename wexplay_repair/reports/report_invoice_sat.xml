<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="action_report_invoice_sat" model="ir.actions.report">
        <field name="name">Factura SAT</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        
        <field name="report_name">wexplay_repair.report_invoice_sat</field>
        <field name="report_file">wexplay_repair.report_invoice_sat</field>
        
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        
        <field name="print_report_name">(object.name or 'Factura SAT')</field>
    </record>
    
    <template id="report_invoice_sat">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="wexplay_repair.report_invoice_sat_document"/>
            </t>
        </t>
    </template>
    
    <template id="report_invoice_sat_document">
        <t t-call="web.external_layout">
            <style>
                /* Roboto: wkhtmltopdf no siempre carga @import remotos.
                Si no tienes Roboto embebida en el motor PDF, caerá en sans-serif. */
                
                
                :root {
                --wex-purple: #714B67;
                --wex-green: #97d1a2;
                --wex-bg: #fdfafc;
                
                --ink: #111;
                --muted: #6b7280;
                --line: #e5e7eb;
                --line-strong: #111;
                --card: #fff;
                --shadow: 0 2px 10px rgba(0,0,0,0.06);
                }
                
                .page {
                font-family: 'Roboto', sans-serif;
                color: #333;
                width: 100%;
                position: relative;
                }
                
                /* Filete lateral “industrial” */
                .wex_page_rail {
                position: absolute;
                left: -2mm;
                top: 0;
                bottom: 0;
                width: 2mm;
                background: linear-gradient(to bottom, var(--wex-purple), var(--wex-green));
                border-radius: 2mm;
                }
                
                /* Estructura tabla para cards superiores */
                .wex_container_full {
                width: 100%;
                display: table;
                table-layout: fixed;
                border-collapse: separate;
                border-spacing: 0;
                }
                .wex_col_half { width: 50%; display: table-cell; vertical-align: top; }
                
                /* Header */
                .wex_header {
                width: 100%;
                border-bottom: 2px solid var(--line-strong);
                padding-bottom: 8px;
                margin-bottom: 14px;
                }
                .wex_title {
                color: var(--wex-purple);
                font-weight: 800;
                letter-spacing: 0.5px;
                margin: 0;
                font-size: 18pt;
                text-transform: uppercase;
                }
                
                /* INV a la derecha (mantengo monospace para efecto “técnico/industrial”) */
                .wex_invnum {
                display: block;
                width: 100%;
                text-align: right;
                font-family: monospace;
                font-weight: 800;
                color: var(--ink);
                font-size: 14pt;
                line-height: 1.1;
                }
                
                /* Chips a la derecha (mantengo monospace para meta-datos) */
                .wex_header_meta {
                
                margin-top: 6px;
                font-size: 8.5pt;
                color: var(--muted);
                text-align: right;      /* 🔹 Fuerza alineación derecha */
                white-space: nowrap;    /* 🔹 Evita que se rompa en varias líneas */

                }
                .wex_chip {
                display: inline-block;
                margin-left: 18px;   /* separación entre bloques */
                }
                
                .wex_chip:first-child {
                margin-left: 0;
                }
                .wex_chip {
                display: inline-block;
                border: 1px solid var(--line);
                border-left: 3px solid var(--wex-green);
                background: #fff;
                padding: 3px 8px;
                border-radius: 999px;
                font-family: monospace;
                color: #111;
                white-space: nowrap;
                }
                .wex_chip strong {
                font-family: 'Roboto', sans-serif;
                color: var(--muted);
                font-weight: 700;
                margin-right: 4px;
                }
                
                /* Cards (NO USADO actualmente: se mantiene comentado para no interferir)
                .wex_card {
                border: 1px solid #ddd;
                border-top: 3px solid var(--wex-purple);
                padding: 15px;
                border-radius: 10px;
                background: var(--card);
                box-sizing: border-box;
                min-height: 120px;
                box-shadow: var(--shadow);
                }
                */
                
                .wex_card_title {
                font-size: 8pt;
                font-weight: 800;
                text-transform: uppercase;
                color: var(--wex-purple);
                margin-bottom: 8px;
                display: block;
                border-bottom: 1px solid var(--wex-green);
                padding-bottom: 4px;
                letter-spacing: 0.3px;
                }
                
                .wex_mono { font-family: monospace; font-weight: 800; color: #000; }
                .wex_row { width: 100%; display: block; clear: both; margin-bottom: 16px; }
                
                /* Tablas */
                .wex_table {
                /* padding: 20px; */
                border: 1px solid #e0e0e0;
                border-radius: 15px;
                background-color: #fff;
                box-shadow: 1px 3px 6px rgba(0, 0, 0, 0.15);
                border-collapse: separate;
                margin-top: 12px;
                table-layout: fixed;
                border: 1px solid var(--line-strong);
                border-top: 3.5px solid #714B67;
                width: 100%;
                border-left: 4px solid var(--wex-purple);
                }
                
                .wex_table thead th {
                background-color: #fff;
                color: #111;
                text-transform: uppercase;
                font-size: 8pt;
                padding: 10px;
                border-bottom: 2px solid var(--line-strong);
                letter-spacing: 0.35px;
                font-family: 'Roboto', sans-serif; /* asegura Roboto en cabeceras */
                }
                .wex_table tbody td {
                padding: 9px 10px;
                border-bottom: 1px solid var(--line);
                font-size: 10pt;
                word-wrap: break-word;
                font-family: 'Roboto', sans-serif; /* asegura Roboto en celdas */
                }
                .wex_table tbody tr:last-child td { border-bottom: 0; }
                
                /* .wex_main_table (NO USADO actualmente: se mantiene comentado para no interferir)
                .wex_main_table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 12px;
                table-layout: fixed;
                border: 1px solid var(--line-strong);
                border-left: 4px solid var(--wex-green);
                }
                .wex_main_table thead th {
                background-color: #fff;
                color: #111;
                text-transform: uppercase;
                font-size: 8pt;
                padding: 10px;
                border-bottom: 2px solid var(--line-strong);
                letter-spacing: 0.35px;
                }
                .wex_main_table tbody td {
                padding: 9px 10px;
                border-bottom: 1px solid var(--line);
                font-size: 10pt;
                word-wrap: break-word;
                }
                .wex_main_table tbody tr:last-child td { border-bottom: 0; }
                */
                
                /* .wex_kv_table (NO USADO actualmente: se mantiene comentado para no interferir)
                .wex_kv_table,
                .wex_kv_table tr,
                .wex_kv_table td {
                border: 0 !important;
                }
                .wex_kv_table { border-collapse: collapse; }
                .wex_kv_table td { padding: 2px 0; }
                */
                
                /* Bloque totales “barra” (NO USADO actualmente: se mantiene comentado para no interferir)
                .wex_totals_block {
                margin-top: 14px;
                page-break-inside: avoid;
                break-inside: avoid;
                }
                .wex_totals_bar {
                width: 100%;
                border: 2px solid var(--line-strong);
                border-radius: 12px;
                background: var(--wex-bg);
                padding: 10px 12px;
                display: table;
                table-layout: fixed;
                }
                .wex_totals_cell {
                display: table-cell;
                vertical-align: middle;
                padding: 2px 8px;
                }
                */
                
                /* Contenedor general de totales */
                .wex_totals_wrapper {
                page-break-inside: avoid;
                margin-top: 30px;
                }
                
                /* Layout en dos columnas */
                .wex_totals_layout {
                width: 100%;
                display: table;
                table-layout: fixed;
                }
                
                .wex_totals_left {
                display: table-cell;
                width: 55%;
                }
                
                .wex_totals_right {
                display: table-cell;
                width: 45%;
                vertical-align: top;
                }
                
                /* Recuadro principal (tarjeta) */
                .wex_totals_box {
                padding: 20px;
                border: 1px solid #e0e0e0;
                border-radius: 12px 12px 0 0;
                background-color: #fff;
                box-shadow: 1px 3px 6px rgba(0, 0, 0, 0.15);
                border-top: 3.5px solid #714B67;
                border-top-color: var(--wex-green); 
                min-height: 120px;
                font-family: 'Roboto', sans-serif; /* asegura Roboto dentro de las “cards” */
                }
                
                /* Filas base/impuestos */
                .wex_totals_row {
                display: table;
                width: 100%;
                margin-bottom: 8px;
                }
                
                /* Fusion: .wex_totals_label absorbe también lo que antes era .wex_totals_value */
                .wex_totals_label {
                display: table-cell;
                font-size: 8pt;
                font-weight: 700;
                color: #666;
                text-transform: uppercase;
                font-family: 'Roboto', sans-serif;
                }
                /* segunda celda de la fila (importe) */
                .wex_totals_row .wex_totals_label:last-child {
                text-align: right;
                font-family: monospace; /* mantengo monospace para importes */
                font-weight: 700;
                color: #111;
                }
                
                /* Línea total */
                .wex_totals_total {
                border-top: 2px solid #97d1a2;
                margin-top: 10px;
                padding-top: 10px;
                display: table;
                width: 100%;
                }
                
                .wex_totals_total_label {
                display: table-cell;
                font-size: 11pt;
                font-weight: 800;
                color: #000;
                text-transform: uppercase;
                vertical-align: middle;
                font-family: 'Roboto', sans-serif;
                }
                
                .wex_divider {
                height: 5px;
                background: var(--line);
                margin: 14px 0 10px 0;
                }

                .wex_totals_total_value {
                display: table-cell;
                text-align: right;
                font-size: 16pt;
                font-weight: 900;
                color: #714B67;
                vertical-align: middle;
                font-family: monospace; /* mantengo monospace para el total */
                }
                
                /* Ajuste de jerarquía en Tarjetas */
                .wex_card_title {
                font-size: 7.5pt; /* Más pequeño para que no compita con el dato */
                font-weight: 700;
                text-transform: uppercase;
                color: var(--muted); /* Color más suave para el título */
                margin-bottom: 4px;
                display: block;
                border-bottom: 1px solid var(--wex-green);
                padding-bottom: 2px;
                letter-spacing: 0.8px; /* Más aire entre letras para estilo Apple */
                }
                
                /* Ajuste de los datos dentro de las cards */
                .wex_card_data {
                font-size: 10pt; /* Tamaño equilibrado */
                font-weight: 500;
                color: var(--ink);
                line-height: 1.2;
                }
                
                /* Unificación de Tablas (estilo tarjeta) */
                .wex_table {
                border: 1px solid #e0e0e0;
                border-radius: 12px 12px 0 0;
                background-color: #fff;
                box-shadow: var(--shadow);
                border-collapse: separate; /* Obligatorio para border-radius */
                margin-top: 15px;
                table-layout: fixed;
                width: 100%;
                border-top: 3px solid var(--wex-purple);
                overflow: hidden;
                }
                
                .wex_table thead th {
                background-color: #f9fafb;
                font-size: 7.5pt;
                padding: 8px 10px;
                border-bottom: 1px solid var(--line-strong);
                color: var(--muted);
                }

                .wex_table tbody td {
                text-align: left; 
                padding: 8px 10px;
                font-size: 9pt;
                border-bottom: 1px solid #f3f4f6;
                }

                
                .wex_th_left  { text-align: left; }
                .wex_th_right { text-align: right;  padding-right: 14px; }
                .wex_th_center { text-align: center; }
            </style>
                
                <t t-set="sale_orders" t-value="o.invoice_line_ids.sale_line_ids.order_id"/>
                <t t-set="repairs" t-value="env['repair.order'].sudo().search([('sale_order_id', 'in', sale_orders.ids)])"/>
                <t t-set="r" t-value="repairs and repairs[0] or False"/>
                
                <div class="page">
                    <div class="wex_page_rail"></div>
                    
                    <!-- Header -->
                <div class="wex_header">
                    <!-- Línea 1: Título izquierda + INV derecha (ancho completo) -->
                    <div class="row">
                        <div class="col-7">
                            <h2 class="wex_title">Factura SAT</h2>
                        </div>
                        <div class="col-5">
                            <span class="wex_invnum"><span t-field="o.name"/></span>
                        </div>
                    </div>
                    
                    <!-- Línea 2: metadata en una sola línea, alineada a la derecha, ancho completo -->
                    <div class="row">
                        <div class="col-12">
                            <div class="wex_header_meta">
                                <span class="wex_chip">
                                    <strong>Fecha</strong>
                                    <span t-field="o.invoice_date"/>
                                </span>
                                <span class="wex_chip">
                                    <strong>Venta</strong>
                                    <span t-esc="', '.join(sale_orders.mapped('name')) or '—'"/>
                                </span>
                                <t t-if="r">
                                    <span class="wex_chip">
                                        <strong>Parte</strong>
                                        <span t-esc="r.name"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="wex_divider"/>

                    <!-- SUPERIOR: Cliente / Equipo -->
                    <div class="wex_container_full">
                        <div class="wex_col_half" style="padding-right: 7.5px;">
                            <div class="wex_totals_box">
                                <span class="wex_card_title">Datos del Cliente</span>
                                <div style="font-size: 11pt; font-weight: bold;" t-esc="o.partner_id.name"/>
                                <div t-if="o.partner_id.vat" class="wex_mono">NIF: <span t-field="o.partner_id.vat"/></div>
                                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True}'/>
                            </div>
                        </div>
                        
                        <div class="wex_col_half" style="padding-left: 7.5px;">
                            <div class="wex_totals_box">
                                <span class="wex_card_title">Información del Equipo</span>
                                
                                <t t-if="r">
                                    <div class="row">
                                        <div class="col-4">
                                            <span style="font-size: 7pt; color: #6b7280; font-weight: bold;">DISPOSITIVO</span><br/>
                                            <span class="wex_card_data" t-field="r.product_id.display_name"/>
                                        </div>
                                        <div class="col-4">
                                            <span style="font-size: 7pt; color: #6b7280; font-weight: bold;">MODELO</span><br/>
                                            <span class="wex_card_data" t-field="r.x_model_id.name" t-if="'x_model_id' in r._fields"/>
                                        </div>
                                        <div class="col-4 text-right">
                                            <span style="font-size: 7pt; color: #6b7280; font-weight: bold;">IMEI / SN</span><br/>
                                            <span class="wex_mono" style="font-size: 10pt;" t-field="r.x_imei" t-if="'x_imei' in r._fields"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="color: #999; font-size: 9pt;">No hay reparación SAT vinculada.</div>
                                </t>
                            </div>
                        </div>
                    </div>
                
                <div class="wex_divider"/>
                
                
                
                <!-- Avería / Notas -->
                    <t t-if="r">
                        <div class="wex_container_full" style="margin-top: 14px;">
                            <div class="wex_col_half" style="padding-right: 7.5px;" t-if="r.x_reported_issue">
                                <div class="wex_totals_box">
                                    <span class="wex_card_title">Avería Reportada</span>
                                    <div style="font-style: italic; font-size: 9pt;">
                                        <span t-esc="r.x_reported_issue"/>
                                    </div>
                                </div>
                            </div>
                            <div class="wex_col_half" style="padding-left: 7.5px;" t-if="r.internal_notes">
                                <div class="wex_totals_box">
                                    <span class="wex_card_title">Informe Técnico</span>
                                    <div style="font-size: 9pt;">
                                        <div t-field="r.internal_notes"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                
                <div class="wex_divider"/>

                    <!-- Piezas SAT -->
                    <t t-if="r and r.move_ids">
                        <div class="wex_row" style="margin-top: 16px;">
                            <div style="display:flex; align-items:flex-end; justify-content:space-between;">
                                <h3 style="font-size: 11pt; font-weight: 800; margin: 0;">Repuestos Usados</h3>
                                <div style="font-size:8pt; color: var(--muted);">SAT / stock moves</div>
                            </div>
                            <table class="wex_table">
                                <thead>
                                    <tr>
                                        <th class="wex_th_left" style="width: 50%;">Producto</th>
                                        <th class="wex_th_right" style="width: 15%;">Demanda</th>
                                        <th class="wex_th_right" style="width: 15%;">Usado</th>
                                        <th class="wex_th_right" style="width: 20%;">Cargada</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="r.move_ids" t-as="m">
                                        <tr t-if="m.repair_line_type == 'add' and m.state != 'cancel'">
                                            <td><span t-esc="m.product_id.display_name"/></td>
                                            <td class="text-right">
                                                <span t-esc="m.product_uom_qty or 0"/>
                                                <span t-esc="m.product_uom.name"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="m.quantity or 0"/>
                                                <span t-esc="m.product_uom.name"/>
                                            </td>
                                            <td class="wex_th_right"><span t-esc="'Sí' if m.picked else 'No'"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    
                    <!-- Detalle Factura -->
                    <div class="wex_row" style="margin-top: 12px;">
                        <div style="display:flex; align-items:flex-end; justify-content:space-between;">
                            <h3 style="font-size: 11pt; font-weight: 800; margin: 0;">Servicios/Mano de Obra</h3>
                            <div style="font-size:8pt; color: var(--muted);">Trabajos realizados</div>
                        </div>
                        <table class="wex_table">
                            <thead>
                                <tr>
                                    <th class="wex_th_left" style="width: 50%;">Descripción</th>
                                    <th class="wex_th_right" style="width: 10%;">Cantidad</th>
                                    <th class="wex_th_right" style="width: 20%;">Precio Unitario</th>
                                    <th class="wex_th_right" style="width: 20%;">Precio sin IVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.invoice_line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-right"><span t-field="line.quantity"/></td>
                                    <td class="text-right"><span t-field="line.price_unit"/></td>
                                    <td class="text-right wex_mono"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="wex_totals_wrapper">
                        <div class="wex_totals_layout">
                            <div class="wex_totals_left"></div>
                            
                            <div class="wex_totals_right">
                                <div class="wex_totals_box">
                                    
                                    <div class="wex_totals_row">
                                        <span class="wex_totals_label">Base Imponible</span>
                                        <span class="wex_totals_label">
                                            <span t-field="o.amount_untaxed"/>
                                        </span>
                                    </div>
                                    
                                    <div class="wex_totals_row">
                                        <span class="wex_totals_label">Impuestos</span>
                                        <span class="wex_totals_label">
                                            <span t-field="o.amount_tax"/>
                                        </span>
                                    </div>
                                    
                                    <div class="wex_totals_total">
                                        <span class="wex_totals_total_label">Total</span>
                                        <span class="wex_totals_total_value">
                                            <span t-field="o.amount_total"/>
                                        </span>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </t>
        </template>
        
    </odoo>