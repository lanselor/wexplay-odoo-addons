<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="action_report_invoice_sat" model="ir.actions.report">
        <field name="name">Factura SAT</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wexplay_repair.report_invoice_sat</field>
        <field name="report_file">wexplay_repair.report_invoice_sat</field>
        
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        
        <field name="print_report_name">(object.name or 'Factura SAT')</field>
    </record>
    
    <template id="report_invoice_sat">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="wexplay_repair.report_invoice_sat_document"/>
            </t>
        </t>
    </template>
    
    <template id="report_invoice_sat_document">
        <t t-call="web.external_layout">
            <style>
                .page {
                    position: relative;
                    width: 100%;
                    color: #1f2937;
                    font-family: 'Roboto', sans-serif;
                    font-size: 9.4pt;
                    line-height: 1.42;
                    padding-top: 8px;
                    border-top: 4px solid #7b68b5;
                }

                .wex_page_rail {
                    display: none;
                }

                .wex_container_full {
                    width: 100%;
                    display: table;
                    table-layout: fixed;
                    border-collapse: separate;
                    border-spacing: 0;
                }

                .wex_col_half {
                    display: table-cell;
                    width: 50%;
                    vertical-align: top;
                }

                .wex_header {
                    width: 100%;
                    border-bottom: 1px solid #c2cddd;
                    padding-bottom: 10px;
                    margin-bottom: 14px;
                }

                .wex_title {
                    margin: 0;
                    color: #7b68b5;
                    font-size: 18pt;
                    font-weight: 900;
                    letter-spacing: 0.2px;
                    text-transform: uppercase;
                }

                .wex_invnum {
                    display: block;
                    width: 100%;
                    text-align: right;
                    color: #1f2937;
                    font-family: monospace;
                    font-size: 14pt;
                    font-weight: 800;
                    line-height: 1.1;
                }

                .wex_header_meta {
                    margin-top: 6px;
                    text-align: right;
                    white-space: nowrap;
                    font-size: 8pt;
                    color: #667085;
                }

                .wex_chip {
                    display: inline-block;
                    margin-left: 8px;
                    padding: 4px 8px;
                    border: 1px solid #c2cddd;
                    background: #f5f7fb;
                    color: #1f2937;
                    font-family: monospace;
                    white-space: nowrap;
                }

                .wex_chip:first-child {
                    margin-left: 0;
                }

                .wex_chip strong {
                    margin-right: 4px;
                    color: #667085;
                    font-family: 'Roboto', sans-serif;
                    font-weight: 700;
                }

                .wex_divider {
                    height: 0;
                    margin: 12px 0 14px 0;
                    border-top: 1px solid #c2cddd;
                }

                .wex_mono {
                    color: #1f2937;
                    font-family: monospace;
                    font-weight: 800;
                }

                .wex_row {
                    display: block;
                    clear: both;
                    width: 100%;
                    margin-bottom: 14px;
                }

                .wex_row h3 {
                    margin: 0 !important;
                    color: #1f2937;
                    font-size: 11pt !important;
                    font-weight: 900 !important;
                    letter-spacing: -0.1px;
                }

                .wex_row > div > div:last-child {
                    color: #667085 !important;
                    font-size: 8pt !important;
                }

                .wex_totals_box {
                    min-height: 120px;
                    padding: 15px 16px 16px;
                    border: 1px solid #c2cddd;
                    border-top: 2px solid #7b68b5;
                    background: #ffffff;
                    box-sizing: border-box;
                }

                .wex_totals_box--hero {
                    min-height: 152px;
                }

                .wex_card_title {
                    display: block;
                    margin-bottom: 10px;
                    padding-bottom: 5px;
                    border-bottom: 1px solid #b9c6d8;
                    color: #4d5b72;
                    font-size: 8.4pt;
                    font-weight: 800;
                    letter-spacing: 0.9px;
                    text-transform: uppercase;
                }

                .wex_card_data {
                    color: #1f2937;
                    font-size: 10pt;
                    font-weight: 600;
                    line-height: 1.3;
                }

                .wex_table {
                    width: 100%;
                    margin-top: 13px;
                    table-layout: fixed;
                    border-collapse: collapse;
                    border: 1px solid #c2cddd;
                    border-top: 2px solid #7b68b5;
                    background: #ffffff;
                }

                .wex_table thead th {
                    padding: 9px 10px;
                    border-bottom: 1px solid #b9c6d8;
                    background: #f3f1fa;
                    color: #4d5b72;
                    font-size: 7.8pt;
                    font-weight: 800;
                    letter-spacing: 0.7px;
                    text-transform: uppercase;
                    font-family: 'Roboto', sans-serif;
                }

                .wex_table tbody td {
                    padding: 8px 10px;
                    border-bottom: 1px solid #dde4ef;
                    color: #1f2937;
                    word-wrap: break-word;
                    font-family: 'Roboto', sans-serif;
                    text-align: left;
                }

                .wex_table tbody tr:nth-child(even) td {
                    background: #fafbfd;
                }

                .wex_table tbody tr:last-child td {
                    border-bottom: 0;
                }

                .wex_totals_wrapper {
                    margin-top: 26px;
                    page-break-inside: avoid;
                }

                .wex_totals_layout {
                    width: 100%;
                    display: table;
                    table-layout: fixed;
                }

                .wex_totals_left {
                    display: table-cell;
                    width: 55%;
                }

                .wex_totals_right {
                    display: table-cell;
                    width: 45%;
                    vertical-align: top;
                }

                .wex_totals_row {
                    display: table;
                    width: 100%;
                    margin-bottom: 7px;
                }

                .wex_totals_label {
                    display: table-cell;
                    color: #667085;
                    font-size: 8pt;
                    font-weight: 700;
                    text-transform: uppercase;
                    font-family: 'Roboto', sans-serif;
                    letter-spacing: 0.45px;
                }

                .wex_totals_row .wex_totals_label:last-child {
                    color: #1f2937;
                    text-align: right;
                    font-family: monospace;
                    font-weight: 800;
                }

                .wex_totals_total {
                    display: table;
                    width: 100%;
                    margin-top: 10px;
                    padding-top: 10px;
                    border-top: 1px solid #b9c6d8;
                }

                .wex_totals_total_label {
                    display: table-cell;
                    color: #1f2937;
                    font-size: 10pt;
                    font-weight: 900;
                    text-transform: uppercase;
                    font-family: 'Roboto', sans-serif;
                }

                .wex_totals_total_value {
                    display: table-cell;
                    color: #7b68b5;
                    text-align: right;
                    font-size: 16pt;
                    font-weight: 900;
                    font-family: monospace;
                }

                .wex_sub_label {
                    color: #667085;
                    font-size: 7.2pt;
                    font-weight: 800;
                    letter-spacing: 0.55px;
                    text-transform: uppercase;
                }

                .wex_text_soft {
                    color: #1f2937;
                }

                .wex_text_emphasis {
                    color: #1f2937;
                    font-style: italic;
                }

                .wex_meta_section {
                    margin-top: 18px;
                    page-break-inside: avoid;
                }

                .wex_meta_box {
                    margin-top: 10px;
                    padding: 14px 16px;
                    border: 1px solid #c2cddd;
                    border-top: 2px solid #7b68b5;
                    background: #ffffff;
                }

                .wex_meta_item {
                    margin-bottom: 8px;
                }

                .wex_meta_item:last-child {
                    margin-bottom: 0;
                }

                .wex_meta_label {
                    display: block;
                    margin-bottom: 2px;
                    color: #667085;
                    font-size: 7.6pt;
                    font-weight: 800;
                    letter-spacing: 0.5px;
                    text-transform: uppercase;
                }

                .wex_meta_value {
                    color: #1f2937;
                    font-size: 9.2pt;
                }

                .wex_th_left  { text-align: left; }
                .wex_th_right { text-align: right; padding-right: 14px; }
                .wex_th_center { text-align: center; }
            </style>

                
                <t t-set="sale_orders" t-value="o.invoice_line_ids.sale_line_ids.order_id"/>
                <t t-set="repairs" t-value="env['repair.order'].sudo().search([('sale_order_id', 'in', sale_orders.ids)])"/>
                <t t-set="r" t-value="repairs and repairs[0] or False"/>
                
                <div class="page">
                    <div class="wex_page_rail"></div>
                    
                    <!-- Header -->
                <div class="wex_header">
                    <!-- Línea 1: Título izquierda + INV derecha (ancho completo) -->
                    <div class="row">
                        <div class="col-7">
                            <h2 class="wex_title">Factura SAT</h2>
                        </div>
                        <div class="col-5">
                            <span class="wex_invnum"><span t-field="o.name"/></span>
                        </div>
                    </div>
                    
                    <!-- Línea 2: metadata en una sola línea, alineada a la derecha, ancho completo -->
                    <div class="row">
                        <div class="col-12">
                            <div class="wex_header_meta">
                                <span class="wex_chip">
                                    <strong>Fecha</strong>
                                    <span t-field="o.invoice_date"/>
                                </span>
                                <span class="wex_chip">
                                    <strong>Venta</strong>
                                    <span t-esc="', '.join(sale_orders.mapped('name')) or '—'"/>
                                </span>
                                <t t-if="r">
                                    <span class="wex_chip">
                                        <strong>Parte</strong>
                                        <span t-esc="r.name"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="wex_divider"/>

                    <!-- SUPERIOR: Cliente / Equipo -->
                    <div class="wex_container_full">
                        <div class="wex_col_half" style="padding-right: 7.5px;">
                            <div class="wex_totals_box wex_totals_box--hero">
                                <span class="wex_card_title">Datos del Cliente</span>
                                <div style="font-size: 12pt; font-weight: 800; color: #1f2937;" t-esc="o.partner_id.name"/>
                                <div t-if="o.partner_id.vat" class="wex_mono">NIF: <span t-field="o.partner_id.vat"/></div>
                                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True}'/>
                            </div>
                        </div>
                        
                        <div class="wex_col_half" style="padding-left: 7.5px;">
                            <div class="wex_totals_box wex_totals_box--hero">
                                <span class="wex_card_title">Información del equipo</span>
                                
                                <t t-if="r">
                                    <div class="row">
                                        <div class="col-4">
                                            <span class="wex_sub_label">Dispositivo</span><br/>
                                            <span class="wex_card_data" t-field="r.product_id.display_name"/>
                                        </div>
                                        <div class="col-4">
                                            <span class="wex_sub_label">Modelo</span><br/>
                                            <span class="wex_card_data" t-field="r.x_model_id.name" t-if="'x_model_id' in r._fields"/>
                                        </div>
                                        <div class="col-4 text-right">
                                            <span class="wex_sub_label">IMEI / SN</span><br/>
                                            <span class="wex_mono" style="font-size: 10pt;" t-field="r.x_imei" t-if="'x_imei' in r._fields"/>
                                        </div>
                                    </div>
                                    <div class="row" style="margin-top: 10px;">
                                        <div class="col-12">
                                            <span class="wex_sub_label">Referencia del cliente</span><br/>
                                            <span class="wex_card_data" t-esc="r.x_customer_reference or '-'"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="wex_text_soft">No hay reparación SAT vinculada.</div>
                                </t>
                            </div>
                        </div>
                    </div>
                
                <div class="wex_divider"/>
                
                
                
                <!-- Avería / Notas -->
                    <t t-if="r">
                        <div class="wex_container_full" style="margin-top: 14px;">
                            <div class="wex_col_half" style="padding-right: 7.5px;" t-if="r.x_reported_issue">
                                <div class="wex_totals_box">
                                    <span class="wex_card_title">Avería reportada</span>
                                    <div class="wex_text_emphasis">
                                        <span t-esc="r.x_reported_issue"/>
                                    </div>
                                </div>
                            </div>
                            <div class="wex_col_half" style="padding-left: 7.5px;" t-if="r.internal_notes">
                                <div class="wex_totals_box">
                                    <span class="wex_card_title">Informe técnico</span>
                                    <div class="wex_text_soft">
                                        <div t-field="r.internal_notes"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                
                <div class="wex_divider"/>

                    <!-- Piezas SAT -->
                    <t t-if="r and r.move_ids">
                        <div class="wex_row" style="margin-top: 16px;">
                            <div style="display:flex; align-items:flex-end; justify-content:space-between;">
                                <h3 style="font-size: 11pt; font-weight: 800; margin: 0;">Repuestos usados</h3>
                                <div style="font-size:8pt; color: #667085;">SAT / stock moves</div>
                            </div>
                            <table class="wex_table">
                                <thead>
                                    <tr>
                                        <th class="wex_th_left" style="width: 50%;">Producto</th>
                                        <th class="wex_th_right" style="width: 15%;">Demanda</th>
                                        <th class="wex_th_right" style="width: 15%;">Usado</th>
                                        <th class="wex_th_right" style="width: 20%;">Cargada</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="r.move_ids" t-as="m">
                                        <tr t-if="m.repair_line_type == 'add' and m.state != 'cancel'">
                                            <td><span t-esc="m.product_id.display_name"/></td>
                                            <td class="text-right">
                                                <span t-esc="m.product_uom_qty or 0"/>
                                                <span t-esc="m.product_uom.name"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="m.quantity or 0"/>
                                                <span t-esc="m.product_uom.name"/>
                                            </td>
                                            <td class="wex_th_right"><span t-esc="'Sí' if m.picked else 'No'"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    
                    <!-- Detalle Factura -->
                    <div class="wex_row" style="margin-top: 12px;">
                        <div style="display:flex; align-items:flex-end; justify-content:space-between;">
                            <h3 style="font-size: 11pt; font-weight: 800; margin: 0;">Servicios y mano de obra</h3>
                            <div style="font-size:8pt; color: #667085;">Trabajos realizados</div>
                        </div>
                        <table class="wex_table">
                            <thead>
                                <tr>
                                    <th class="wex_th_left" style="width: 50%;">Descripción</th>
                                    <th class="wex_th_right" style="width: 10%;">Cantidad</th>
                                    <th class="wex_th_right" style="width: 20%;">Precio unitario</th>
                                    <th class="wex_th_right" style="width: 20%;">Precio sin IVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.invoice_line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-right"><span t-field="line.quantity"/></td>
                                    <td class="text-right"><span t-field="line.price_unit"/></td>
                                    <td class="text-right wex_mono"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="wex_totals_wrapper">
                        <div class="wex_totals_layout">
                            <div class="wex_totals_left"></div>
                            
                            <div class="wex_totals_right">
                                <div class="wex_totals_box">
                                    
                                    <div class="wex_totals_row">
                                        <span class="wex_totals_label">Base Imponible</span>
                                        <span class="wex_totals_label">
                                            <span t-field="o.amount_untaxed"/>
                                        </span>
                                    </div>
                                    
                                    <div class="wex_totals_row">
                                        <span class="wex_totals_label">Impuestos</span>
                                        <span class="wex_totals_label">
                                            <span t-field="o.amount_tax"/>
                                        </span>
                                    </div>
                                    
                                    <div class="wex_totals_total">
                                        <span class="wex_totals_total_label">Total</span>
                                        <span class="wex_totals_total_value">
                                            <span t-field="o.amount_total"/>
                                        </span>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    </div>

                    <t t-if="o.invoice_payment_term_id.note or (o.move_type in ('out_invoice', 'in_refund') and (o.payment_reference or o.partner_bank_id)) or not is_html_empty(o.narration)">
                        <div class="wex_meta_section">
                            <div class="wex_row">
                                <div style="display:flex; align-items:flex-end; justify-content:space-between;">
                                    <h3 style="font-size: 11pt; font-weight: 800; margin: 0;">Pago y condiciones</h3>
                                    <div style="font-size:8pt; color: #667085;">Configuración documental de la factura</div>
                                </div>
                                <div class="wex_meta_box">
                                    <div class="wex_meta_item" t-if="o.invoice_payment_term_id.note">
                                        <span class="wex_meta_label">Condiciones de pago</span>
                                        <div class="wex_meta_value" t-field="o.invoice_payment_term_id.note"/>
                                    </div>
                                    <div class="wex_meta_item" t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference">
                                        <span class="wex_meta_label">Referencia de pago</span>
                                        <div class="wex_meta_value">
                                            <span t-field="o.payment_reference"/>
                                        </div>
                                    </div>
                                    <div class="wex_meta_item" t-if="o.move_type in ('out_invoice', 'in_refund') and o.partner_bank_id">
                                        <span class="wex_meta_label">Cuenta bancaria</span>
                                        <div class="wex_meta_value">
                                            <span t-field="o.partner_bank_id"/>
                                        </div>
                                    </div>
                                    <div class="wex_meta_item" t-if="not is_html_empty(o.narration)">
                                        <span class="wex_meta_label">Condiciones generales</span>
                                        <div class="wex_meta_value" t-field="o.narration"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    
                </div>
            </t>
        </template>
        
    </odoo>

