<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_repair_sat_report_notes_wizard_form" model="ir.ui.view">
        <field name="name">wex.repair.sat.report.notes.wizard.form</field>
        <field name="model">wex.repair.sat.report.notes.wizard</field>
        <field name="arch" type="xml">
            <form string="Notas complementarias del informe" create="0" delete="0">
                <sheet>
                    <p class="text-muted">
                        Este texto solo se incluye en el informe técnico SAT. Guardarlo actualiza
                        automáticamente el PDF si ya está archivado en DMS.
                    </p>
                    <field name="repair_id" invisible="1"/>
                    <field name="notes"
                           nolabel="1"
                           widget="text"
                           placeholder="Añade información complementaria para este informe..."/>
                </sheet>
                <footer>
                    <button name="action_save"
                            type="object"
                            string="Guardar"
                            class="btn btn-primary"/>
                    <button string="Descartar cambios"
                            special="cancel"
                            class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
