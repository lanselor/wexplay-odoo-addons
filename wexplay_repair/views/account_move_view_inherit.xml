<?xml version="1.0" encoding="UTF-8"?>
<!-- wexplay_repair/views/account_move_view_inherit.xml -->
<odoo>
    <record id="view_move_form_inherit_print_dropdown" model="ir.ui.view">
        <field name="name">account.move.form.print.dropdown.wex</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header/button[@name='action_print_pdf'][1]" position="after">
                <div class="btn-group"
                     invisible="state != 'posted' or is_being_sent or move_type == 'entry'">
                    
                    <div class="btn btn-primary dropdown-toggle"
                         role="button"
                         tabindex="0"
                         data-bs-toggle="dropdown"
                         aria-expanded="false">
                        Imprimir
                    </div>
                    
                    <div class="dropdown-menu">
                        <li><h6 class="dropdown-header">Formatos de Factura</h6></li>
                        <hr class="dropdown-divider"/>
                        
                        <!-- NUEVO: QZ directo (SIN MODAL) -->
                        <button type="object"
                                name="action_qz_print_invoice_standard"
                                class="dropdown-item"
                                groups="account.group_account_invoice">
                            Imprimir factura (QZ)
                        </button>
                        
                        <button type="object"
                                name="action_qz_print_invoice_sat"
                                class="dropdown-item"
                                invisible="not has_sat_related"
                                groups="account.group_account_invoice">
                            Imprimir factura SAT (QZ)
                        </button>
                        
                        <hr class="dropdown-divider"/>
                        
                        <!-- Descargas PDF (lo que ya tenías) -->
                        <button type="object"
                                name="action_print_pdf"
                                class="dropdown-item">
                            Descargar factura
                        </button>
                        
                        <button type="object"
                                name="action_print_sat_pdf"
                                class="dropdown-item"
                                invisible="not has_sat_related"
                                groups="account.group_account_invoice">
                            Descargar factura SAT
                        </button>
                    </div>
                </div>
            </xpath>
            
            <xpath expr="//header//button[@name='action_print_pdf']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
        </field>
    </record>
</odoo>