<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="wex_repair_order_list_default_order" model="ir.ui.view">
      <field name="name">wex_repair_order_list_default_order</field>
      <field name="model">repair.order</field>
      <field name="inherit_id" ref="mrp_repair.repair_list"/>
      <field name="arch" type="xml">

        <xpath expr="//list" position="attributes">
          <attribute name="default_order">create_date desc, name desc</attribute>
          <attribute name="decoration-success">state == 'done'</attribute>
          <attribute name="decoration-info">state == 'confirmed'</attribute>
          <attribute name="decoration-warning">state == 'under_repair'</attribute>
          <attribute name="decoration-danger">state == 'cancel'</attribute>
          <attribute name="decoration-muted">state == 'draft'</attribute>
        </xpath>

        <xpath expr="//list/field[@name='name']" position="after">
          <field name="create_date" optional="show"/>
        </xpath>

        <xpath expr="//list/field[@name='product_id']" position="after">
          <field name="partner_id" optional="show"/>
        </xpath>

        <xpath expr="//list/field[@name='state']" position="before">
          <field name="location_id" optional="show"/>
        </xpath>

      </field>
    </record>

  </data>
</odoo>
