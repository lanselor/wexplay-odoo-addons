<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Heredamos la vista formulario estándar de repair.order -->
    <record id="view_repair_order_form_wexplay" model="ir.ui.view">
        <field name="name">repair.order.form.wexplay</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <!-- 1) Quitar el cliente de su posición original (normalmente columna izquierda) -->
            <xpath expr="//sheet//field[@name='partner_id']" position="replace"/>

            <!-- 2) Añadir cliente + teléfono en la columna derecha (después del responsable) -->
            <xpath expr="//sheet//field[@name='user_id']" position="after">
                <field name="partner_id"/>
                <field name="x_partner_phone" readonly="1"/>
                <field name="x_partner_mobile" readonly="1"/>

            </xpath>

            <!-- Panel Wexplay (notebook nuevo) -->
            <xpath expr="//sheet//notebook[1]" position="before">
                <notebook name="wexplay_notebook">
                    <page string="Datos del dispositivo" name="wex_device">
                        <group>
                             <!-- Columna izquierda -->
                            <group string="Dispositivo">
                                <field name="x_device_type"/>
                                <field name="x_model_id"/>
                                <field name="x_brand_id" readonly="1"/>

                                <field name="x_imei"/>
                                <field name="x_accessories"/>
                            </group>


                            <!-- Columna derecha -->
                            <group string="Desbloqueo">
                                <field name="x_unlock_type"/>
                                <field name="x_unlock_code" invisible="x_unlock_type in ('none', 'unknown')"/>
                                <field name="x_unlock_pattern" invisible="x_unlock_type != 'pattern'"/>
                                <field name="x_unlock_notes"/>
                            </group>

                        </group>
                    </page>

                    <page string="Avería" name="wex_issue">
                        <group>
                            <group string="Información de la avería">
                                <field name="x_reported_issue"/>
                            </group>
                            <group string="Notas internas">
                                <field name="x_internal_notes"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>

        </field>
    </record>

    <!-- Heredamos la vista LISTA (tree) estándar de repair.order para inyectar js_class -->
    <record id="view_repair_order_list_wexplay_jsclass" model="ir.ui.view">
        <field name="name">repair.order.list.wexplay.jsclass</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">wex_repair_list</attribute>
            </xpath>
        </field>
    </record>



</odoo>
