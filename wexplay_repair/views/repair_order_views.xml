<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Heredamos la vista formulario estándar de repair.order -->
    <record id="view_repair_order_form_wexplay" model="ir.ui.view">
        <field name="name">repair.order.form.wexplay</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <!-- Añadimos un bloque con datos del dispositivo debajo del producto -->
            <xpath expr="//field[@name='product_id']" position="after">
                <group string="Datos del dispositivo">
                    <field name="x_device_type"/>
                    <field name="x_brand"/>
                    <field name="x_model"/>
                    <field name="x_imei"/>
                    <field name="x_accessories"/>
                </group>
            </xpath>

            <!-- Añadimos campos de avería y notas internas en el formulario -->
            <xpath expr="//field[@name='internal_notes']" position="before">
                <group string="Información de la avería">
                    <field name="x_reported_issue"/>
                    <field name="x_internal_notes"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
