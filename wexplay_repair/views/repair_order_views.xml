<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Heredamos la vista formulario estándar de repair.order -->
    <record id="view_repair_order_form_wexplay" model="ir.ui.view">
        <field name="name">repair.order.form.wexplay</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <!-- 1) Quitar el cliente de su posición original (normalmente columna izquierda) -->
            <xpath expr="//sheet//field[@name='partner_id']" position="replace"/>

            <!-- 2) Añadir cliente + teléfono en la columna derecha (después del responsable) -->
            <xpath expr="//sheet//field[@name='scheduled_date']" position="before">
                
                <div class="o_group p-3 mt-3 border rounded bg-light shadow-sm">
                    <div class="o_horizontal_separator text-uppercase fw-bold mb-3"
                         style="font-size: 0.85rem; color: #714B67;">
                        <i class="fa fa-user-circle me-2"></i>
                        Información del Cliente
                    </div>
                    
                    <group col="1" class="m-0">
                        
                        <!-- MISMO CAMPO que te funciona -->
                        <field name="partner_id" required="1"/>
                        
                        <!-- MISMO CAMPO que te funciona -->
                        <div class="d-flex align-items-center text-muted mt-2">
                            <i class="fa fa-phone me-2" style="width: 15px;"></i>
                            <field name="x_partner_phone" readonly="1" nolabel="1"/>
                        </div>
                        
                        <!-- MISMO CAMPO que te funciona -->
                        <div class="d-flex align-items-center text-muted">
                            <i class="fa fa-mobile me-2" style="width: 15px;"></i>
                            <field name="x_partner_mobile" readonly="1" nolabel="1"/>
                        </div>
                        
                    </group>
                </div>
                
            </xpath>


            <!-- Panel Wexplay (notebook nuevo) -->
            <xpath expr="//sheet//notebook[1]" position="before">
                <notebook name="wexplay_notebook" class="mt-4 shadow-sm border rounded">
                    
                    <page string="Datos del dispositivo" name="wex_device">
                        <group col="2">
                            
                            <!-- Columna izquierda -->
                            <group>
                                <div class="o_horizontal_separator text-uppercase fw-bold mb-3"
                                     style="font-size: 0.8rem; color: #714B67;">
                                    <i class="fa fa-tablet me-2"></i>
                                    Especificaciones del terminal
                                </div>
                                
                                <field name="x_device_type"/>
                                <field name="x_model_id" placeholder="Ej: Galaxy S24 Ultra..."/>
                                <field name="x_brand_id" readonly="1" options="{'no_open': True}"/>
                                <field name="x_imei" placeholder="15 dígitos..."/>
                                <field name="x_accessories" placeholder="Cargador, funda, tarjeta SD..."/>
                            </group>
                            
                            <!-- Columna derecha -->
                            <group>
                                <div class="o_horizontal_separator text-uppercase fw-bold mb-3"
                                     style="font-size: 0.8rem; color: #714B67;">
                                    <i class="fa fa-lock me-2"></i>
                                    Seguridad y Acceso
                                </div>
                                
                                <field name="x_unlock_type"/>
                                <field name="x_unlock_code"
                                       attrs="{'invisible': [('x_unlock_type','in',['none','unknown'])]}"/>
                                <field name="x_unlock_pattern"
                                       attrs="{'invisible': [('x_unlock_type','!=','pattern')]}"/>
                                <field name="x_unlock_notes" placeholder="Notas adicionales de acceso..."/>
                            </group>
                            
                        </group>
                    </page>
                    
                    <page string="Detalles de Avería" name="wex_issue">
                        <group col="2">
                            
                            <group>
                                <div class="o_horizontal_separator text-uppercase fw-bold mb-3"
                                     style="font-size: 0.8rem; color: #d9534f;">
                                    <i class="fa fa-exclamation-triangle me-2"></i>
                                    Problema Reportado
                                </div>
                                <field name="x_reported_issue" placeholder="Describa el fallo detalladamente..."/>
                            </group>
                            
                            <group>
                                <div class="o_horizontal_separator text-uppercase fw-bold mb-3"
                                     style="font-size: 0.8rem; color: #714B67;">
                                    <i class="fa fa-sticky-note-o me-2"></i>
                                    Notas Técnicas Internas
                                </div>
                                <field name="x_internal_notes" placeholder="Observaciones para el técnico..."/>
                            </group>
                            
                        </group>
                    </page>
                    
                </notebook>
            </xpath>


        </field>
    </record>

    <!-- Heredamos la vista LISTA (tree) estándar de repair.order para inyectar js_class -->
    <record id="view_repair_order_tree_button_header" model="ir.ui.view">
        <field name="name">repair.order.tree.header.button</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">

        <xpath expr="//list" position="inside">
            <header>
                <button name="action_custom_button"
                        type="object"
                        string="Expandir SAT"
                        class="btn-primary"/>
            </header>
        </xpath>

        </field>
    </record>




</odoo>
