<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_repair_order_form_wexplay" model="ir.ui.view">
        <field name="name">repair.order.form.wexplay</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="attributes">
                <attribute name="class" add="wex_repair_form_sheet" separator=" "/>
            </xpath>

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_sale_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-eur">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Total SAT</span>
                        <span class="o_stat_value">
                            <field name="x_sat_total_amount" widget="monetary" options="{'currency_field': 'x_sat_currency_id'}"/>
                        </span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//sheet/group/group[1]/field[@name='partner_id']" position="replace"/>
            <xpath expr="//sheet/group/group[1]/field[@name='product_id']" position="replace"/>
            <xpath expr="//sheet/group/group[1]/label[@for='product_qty']" position="replace"/>
            <xpath expr="//sheet/group/group[1]/div[field[@name='product_qty'] and field[@name='product_uom']]" position="replace"/>
            <xpath expr="//sheet/group/group[1]/field[@name='picking_id']" position="replace"/>
            <xpath expr="//sheet/group/group[2]/field[@name='user_id']" position="replace"/>
            <xpath expr="//sheet/group/group[2]/field[@name='tag_ids']" position="replace"/>

            <xpath expr="(//sheet//field[@name='under_warranty'])[1]" position="after">
                <div name="wex_repair_device_intro" class="wex_repair_form_intro">
                    <div class="wex_repair_form_card wex_repair_form_card--hero wex_repair_form_card--compact wex_repair_form_card--topmatch">
                        <div class="wex_repair_form_eyebrow">Recepción SAT</div>
                        <div class="wex_repair_form_heading">
                            <i class="fa fa-laptop"/>
                            <span>Dispositivo a reparar</span>
                        </div>

                        <field name="product_id"
                               required="1"
                               nolabel="1"
                               placeholder="Ej: iPhone 15 Pro Max / Consola PS5..."
                               class="wex_repair_form_product"/>

                        <div class="wex_repair_form_hint">
                            Selecciona el producto exacto para enlazar correctamente repuestos, historial y operaciones.
                        </div>

                        <div class="wex_repair_form_stack">
                            <div class="wex_repair_form_fieldbox">
                                <div class="wex_repair_form_fieldbox_label">
                                    <i class="fa fa-map-marker"/>
                                    <span>Ubicación SAT</span>
                                </div>
                                <field name="product_location_src_id"
                                       string="Ubicación"
                                       nolabel="1"
                                       domain="[('display_name', 'ilike', '/REPARACIONES/')]"
                                       class="wex_repair_form_location"/>
                            </div>

                            <div class="wex_repair_form_fieldbox">
                                <div class="wex_repair_form_fieldbox_label">
                                    <i class="fa fa-exclamation-circle"/>
                                    <span>Prioridad SAT</span>
                                </div>
                                <field name="x_sat_priority"
                                       nolabel="1"
                                       widget="wex_repair_sat_priority"
                                       class="wex_repair_form_priority"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

            <xpath expr="(//sheet//field[@name='schedule_date'])[1]" position="before">
                <div name="wex_repair_customer_intro" class="wex_repair_form_intro">
                    <div class="wex_repair_form_card wex_repair_form_card--client wex_repair_form_card--topmatch">
                        <div class="wex_repair_form_eyebrow">Cliente</div>
                        <div class="wex_repair_form_heading">
                            <i class="fa fa-user-circle"/>
                            <span>Información de cliente</span>
                        </div>

                        <group col="1" class="wex_repair_form_group">
                            <field name="partner_id" required="1"/>
                            <field name="x_customer_reference"
                                   placeholder="Ej.: RMA-45821 / OT-Cliente-1029"/>
                        </group>

                        <div class="wex_repair_form_contact_list">
                            <div class="wex_repair_form_contact_line" invisible="not x_partner_phone">
                                <i class="fa fa-phone"/>
                                <field name="x_partner_phone" readonly="1" nolabel="1"/>
                            </div>
                            <div class="wex_repair_form_contact_line" invisible="not x_partner_mobile">
                                <i class="fa fa-mobile"/>
                                <field name="x_partner_mobile" readonly="1" nolabel="1"/>
                            </div>
                            <div class="wex_repair_form_contact_line" invisible="not x_partner_email">
                                <i class="fa fa-envelope-o"/>
                                <field name="x_partner_email" readonly="1" nolabel="1"/>
                            </div>
                            <div class="wex_repair_form_contact_line is-secondary" invisible="not x_partner_address_summary">
                                <i class="fa fa-map-marker"/>
                                <field name="x_partner_address_summary" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="wex_repair_form_card wex_repair_form_card--meta">
                        <div class="wex_repair_form_eyebrow">Equipo interno</div>
                        <div class="wex_repair_form_heading">
                            <i class="fa fa-users"/>
                            <span>Recepción y responsable</span>
                        </div>

                        <div class="wex_repair_form_people">
                            <div class="wex_repair_form_person">
                                <field name="x_reception_employee_avatar"
                                       widget="image"
                                       class="wex_repair_form_person_avatar"
                                       options="{'size': [56, 56], 'preview_image': 'x_reception_employee_avatar'}"
                                       nolabel="1"/>
                                <div class="wex_repair_form_person_body">
                                    <div class="wex_repair_form_person_role">Recepciona</div>
                                    <field name="x_reception_employee_id" required="1" nolabel="1"/>
                                </div>
                            </div>

                            <div class="wex_repair_form_person">
                                <field name="x_responsible_avatar"
                                       widget="image"
                                       class="wex_repair_form_person_avatar"
                                       options="{'size': [56, 56], 'preview_image': 'x_responsible_avatar'}"
                                       nolabel="1"/>
                                <div class="wex_repair_form_person_body">
                                    <div class="wex_repair_form_person_role">Responsable</div>
                                    <field name="user_id" nolabel="1" readonly="0"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

            <xpath expr="//sheet/group/group[1]/field[@name='under_warranty']" position="replace"/>
            <xpath expr="//sheet/group/group[2]/field[@name='schedule_date']" position="replace"/>

            <xpath expr="//sheet//notebook[1]" position="before">
                <div name="wex_repair_technical_sections" class="wex_repair_form_sections">
                    <div class="wex_repair_form_section_marker">
                        <span>Ficha técnica y diagnóstico</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <notebook class="wex_repair_form_technical_notebook">
                                <page string="Equipo y seguridad">
                                    <div class="row g-3">
                                        <div class="col-lg-6">
                                            <div class="wex_repair_form_card h-100">
                                                <div class="wex_repair_form_eyebrow">Ficha de equipo</div>
                                                <div class="wex_repair_form_heading">
                                                    <i class="fa fa-tablet"/>
                                                    <span>Especificaciones del terminal</span>
                                                </div>

                                                <group col="1" class="wex_repair_form_group">
                                                    <field name="x_device_type" widget="wex_repair_device_type_picker"/>
                                                    <field name="x_brand_id" readonly="1" options="{'no_open': True}"/>
                                                    <field name="x_model_id" placeholder="Ej: Z Flip 3..."/>
                                                </group>

                                                <div class="wex_repair_form_serial">
                                                    <label for="x_imei" string="IMEI / N.º de serie"/>
                                                    <div class="wex_repair_form_serial_row">
                                                        <field name="x_imei"
                                                               nolabel="1"
                                                               placeholder="15 dígitos..."
                                                               class="o_field_highlight"/>
                                                        <button name="action_view_device_history"
                                                                type="object"
                                                                icon="fa-search"
                                                                class="btn btn-outline-secondary"
                                                                title="Ver historial del dispositivo"
                                                                invisible="not x_imei"/>
                                                    </div>
                                                </div>

                                                <div class="wex_repair_form_accessories">
                                                    <label for="x_accessories" string="Accesorios entregados"/>
                                                    <field name="x_accessories"
                                                           widget="text"
                                                           nolabel="1"
                                                           placeholder="Cargador, funda, tarjeta SIM..."/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-6">
                                            <div class="wex_repair_form_card h-100">
                                                <div class="wex_repair_form_eyebrow">Seguridad</div>
                                                <div class="wex_repair_form_heading">
                                                    <i class="fa fa-lock"/>
                                                    <span>Acceso al dispositivo</span>
                                                </div>

                                                <group col="1" class="wex_repair_form_group">
                                                    <field name="x_unlock_type" widget="wex_repair_unlock_type_picker"/>
                                                </group>

                                                <div class="wex_repair_form_notice wex_repair_form_notice--info"
                                                     invisible="x_unlock_type not in ('pin', 'password')">
                                                    <i class="fa fa-key"/>
                                                    <field name="x_unlock_code"
                                                           class="fw-bold"
                                                           nolabel="1"
                                                           placeholder="Código / Contraseña"/>
                                                </div>

                                                <div class="wex_repair_form_notice wex_repair_form_notice--warning"
                                                     invisible="x_unlock_type != 'pattern'">
                                                    <i class="fa fa-random"/>
                                                    <field name="x_unlock_pattern"
                                                           class="fw-bold"
                                                           nolabel="1"
                                                           placeholder="Describe el patrón (ej: forma de Z)"/>
                                                </div>

                                                <field name="x_unlock_notes"
                                                       placeholder="Notas adicionales de acceso..."/>
                                            </div>
                                        </div>
                                    </div>
                                </page>

                                <page name="wex_repair_test_page" string="Test">
                                    <div class="alert alert-light mb-0" role="alert">
                                        Espacio reservado para resultados y pruebas del dispositivo.
                                    </div>
                                </page>

                                <page string="Firmas">
                                    <div class="wex_repair_form_signatures_placeholder"/>
                                </page>

                                <page name="wex_sat_documents_page" string="Documentos">
                                    <div class="wex_repair_documents_workspace">
                                        <div class="wex_repair_documents_intro">
                                            <div class="wex_repair_form_eyebrow">Documentación SAT</div>
                                            <div class="wex_repair_documents_intro_title">
                                                <i class="fa fa-folder-open-o"/>
                                                <span>Documentos operativos</span>
                                            </div>
                                            <p class="wex_repair_documents_intro_copy">
                                                Gestiona las impresiones de recepción y el informe técnico del expediente.
                                            </p>
                                        </div>

                                        <div class="wex_repair_documents_grid">
                                            <div class="wex_repair_form_card wex_repair_documents_card wex_repair_documents_card--print">
                                                <div class="wex_repair_form_eyebrow">Impresiones SAT</div>
                                                <div class="wex_repair_form_heading">
                                                    <i class="fa fa-print"/>
                                                    <span>Etiquetas y resguardo</span>
                                                </div>
                                                <p class="wex_repair_documents_card_copy">
                                                    Prepara los documentos físicos para identificar y entregar el equipo.
                                                </p>
                                                <!-- wexplay_sat_print reemplaza este ancla con sus acciones. -->
                                                <div name="wex_sat_print_actions_anchor"
                                                     class="wex_repair_documents_actions alert d-none">
                                                    <span class="wex_repair_documents_placeholder">
                                                        Las acciones de impresión SAT estarán disponibles al instalar su módulo.
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="wex_repair_form_card wex_repair_documents_card wex_repair_documents_card--report">
                                                <div class="wex_repair_form_eyebrow">Informe técnico</div>
                                                <div class="wex_repair_form_heading">
                                                    <i class="fa fa-file-text-o"/>
                                                    <span>Informe de servicio</span>
                                                </div>
                                                <p class="wex_repair_documents_card_copy">
                                                    Resume la incidencia, el diagnóstico, la intervención y la evidencia del SAT.
                                                </p>
                                                <field name="x_sat_report_dms_file_id" invisible="1"/>
                                                <field name="x_sat_report_notes" invisible="1"/>
                                                <div class="wex_repair_documents_actions">
                                                    <span class="wex_repair_documents_status wex_repair_documents_status--pending"
                                                          invisible="x_sat_report_dms_file_id">
                                                        <i class="fa fa-circle-o"/>
                                                        Sin generar
                                                    </span>
                                                    <span class="wex_repair_documents_status wex_repair_documents_status--ready"
                                                          invisible="not x_sat_report_dms_file_id">
                                                        <i class="fa fa-check-circle"/>
                                                        Archivado en DMS
                                                    </span>
                                                    <button name="action_generate_sat_report"
                                                            type="object"
                                                            class="btn btn-primary wex_repair_document_action d-inline-flex align-items-center gap-2"
                                                            groups="wexplay_repair.group_wex_repair_sat_report_manage"
                                                            invisible="x_sat_report_dms_file_id">
                                                        <i class="fa fa-file-text-o"/>
                                                        Generar informe
                                                    </button>
                                                    <button name="action_download_sat_report"
                                                            type="object"
                                                            class="btn btn-outline-primary wex_repair_document_action d-inline-flex align-items-center gap-2"
                                                            groups="wexplay_repair.group_wex_repair_sat_report_download,wexplay_repair.group_wex_repair_sat_report_manage"
                                                            invisible="not x_sat_report_dms_file_id">
                                                        <i class="fa fa-download"/>
                                                        Descargar
                                                    </button>
                                                    <button name="action_send_sat_report"
                                                            type="object"
                                                            class="btn btn-outline-primary wex_repair_document_action d-inline-flex align-items-center gap-2"
                                                            groups="wexplay_repair.group_wex_repair_sat_report_manage"
                                                            invisible="not x_sat_report_dms_file_id">
                                                        <i class="fa fa-envelope-o"/>
                                                        Enviar
                                                    </button>
                                                    <button name="action_generate_sat_report"
                                                            type="object"
                                                            class="btn btn-outline-secondary wex_repair_document_action d-inline-flex align-items-center gap-2"
                                                            groups="wexplay_repair.group_wex_repair_sat_report_manage"
                                                            invisible="not x_sat_report_dms_file_id">
                                                        <i class="fa fa-refresh"/>
                                                        Regenerar
                                                    </button>
                                                    <button name="action_open_sat_report_notes_wizard"
                                                            type="object"
                                                            class="btn btn-outline-secondary wex_repair_document_notes_action"
                                                            groups="wexplay_repair.group_wex_repair_sat_report_manage"
                                                            title="Notas complementarias del informe"
                                                            aria-label="Notas complementarias del informe">
                                                        <span class="wex_repair_document_notes_icon">
                                                            <i class="fa fa-sticky-note-o"/>
                                                            <span class="wex_repair_document_notes_indicator"
                                                                  invisible="not x_sat_report_notes"/>
                                                        </span>
                                                        <span class="visually-hidden">Notas complementarias del informe</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </page>
                            </notebook>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-12">
                            <div class="wex_repair_form_card wex_repair_form_card--issue h-100">
                                <div class="wex_repair_form_eyebrow">Diagnóstico de entrada</div>
                                <div class="wex_repair_form_heading">
                                    <i class="fa fa-exclamation-triangle"/>
                                    <span>Problema reportado</span>
                                </div>
                                <field name="x_reported_issue"
                                       widget="text"
                                       nolabel="1"
                                       placeholder="Describe el fallo detalladamente..."/>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="wex_repair_form_card wex_repair_form_card--internal h-100">
                                <div class="wex_repair_form_eyebrow">Uso interno</div>
                                <div class="wex_repair_form_heading">
                                    <i class="fa fa-sticky-note-o"/>
                                    <span>Notas técnicas internas</span>
                                </div>
                                <field name="x_internal_notes"
                                       widget="text"
                                       nolabel="1"
                                       placeholder="Observaciones exclusivas para el técnico..."/>
                            </div>
                        </div>
                    </div>

                </div>
            </xpath>

            <xpath expr="//sheet//notebook[1]" position="after">
                <div name="wex_repair_admin_sections" class="wex_repair_form_sections wex_repair_form_sections--admin">
                    <div class="wex_repair_form_section_marker is-secondary">
                        <span>Datos administrativos</span>
                    </div>

                    <div class="wex_repair_form_card wex_repair_form_card--admin">
                        <group col="2" class="wex_repair_form_group wex_repair_form_group--admin">
                            <field name="product_qty"/>
                            <field name="product_uom"/>
                            <field name="picking_id"/>
                            <field name="under_warranty"/>
                            <field name="schedule_date"/>
                            <field name="planned_duration" widget="float_time"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                        </group>
                    </div>
                </div>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="internal_notes" invisible="1"/>
            </xpath>

        </field>
    </record>

    <record id="view_repair_order_form_wexplay_duration_cleanup" model="ir.ui.view">
        <field name="name">repair.order.form.wexplay.duration.cleanup</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair_scheduled_date_calendar_view.view_repair_order_form_inherit_duration"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[2]/field[@name='planned_duration']" position="replace"/>
        </field>
    </record>

</odoo>
