<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Heredamos la vista formulario estándar de repair.order -->
    <record id="view_repair_order_form_wexplay" model="ir.ui.view">
        <field name="name">repair.order.form.wexplay</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <!-- 1) Quitar el cliente de su posición original (normalmente columna izquierda) -->
            <xpath expr="//sheet//field[@name='partner_id']" position="replace"/>

            <!-- 2) Añadir cliente + teléfono en la columna derecha (después del responsable) -->
            <xpath expr="//sheet//field[@name='user_id']" position="after">
                <div class="o_group p-3 mt-3 border rounded bg-light shadow-sm">
                    <div class="o_horizontal_separator text-uppercase fw-bold mb-3" style="font-size: 0.85rem; color: #714B67;">
                        <i class="fa fa-user-circle me-2"/> Información del Cliente
                    </div>
                    
                    <group col="1" class="m-0">
                        <field name="partner_id" 
                               required="1" 
                               options="{'no_open': True, 'no_create': True}"
                               placeholder="Seleccione el cliente..."/>
                        
                        <div class="d-flex flex-column mt-2 gap-1" t-if="record.partner_id.raw_value">
                            <div class="d-flex align-items-center text-muted">
                                <i class="fa fa-phone me-2" style="width: 15px;"/>
                                <field name="x_partner_phone" readonly="1" nolabel="1" class="mb-0"/>
                            </div>
                            <div class="d-flex align-items-center text-muted">
                                <i class="fa fa-mobile me-2" style="width: 15px;"/>
                                <field name="x_partner_mobile" readonly="1" nolabel="1" class="mb-0"/>
                            </div>
                        </div>
                    </group>
                </div>
            </xpath>

            <!-- Panel Wexplay (notebook nuevo) -->
            <xpath expr="//sheet//notebook[1]" position="before">
                <notebook name="wexplay_notebook">
                    <page string="Datos del dispositivo" name="wex_device">
                        <group>
                             <!-- Columna izquierda -->
                            <group string="Dispositivo">
                                <field name="x_device_type"/>
                                <field name="x_model_id"/>
                                <field name="x_brand_id" readonly="1"/>

                                <field name="x_imei"/>
                                <field name="x_accessories"/>
                            </group>


                            <!-- Columna derecha -->
                            <group string="Desbloqueo">
                                <field name="x_unlock_type"/>
                                <field name="x_unlock_code" invisible="x_unlock_type in ('none', 'unknown')"/>
                                <field name="x_unlock_pattern" invisible="x_unlock_type != 'pattern'"/>
                                <field name="x_unlock_notes"/>
                            </group>

                        </group>
                    </page>

                    <page string="Avería" name="wex_issue">
                        <group>
                            <group string="Información de la avería">
                                <field name="x_reported_issue"/>
                            </group>
                            <group string="Notas internas">
                                <field name="x_internal_notes"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>

        </field>
    </record>

    <!-- Heredamos la vista LISTA (tree) estándar de repair.order para inyectar js_class -->
    <record id="view_repair_order_tree_button_header" model="ir.ui.view">
        <field name="name">repair.order.tree.header.button</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">

        <xpath expr="//list" position="inside">
            <header>
                <button name="action_custom_button"
                        type="object"
                        string="Expandir SAT"
                        class="btn-primary"/>
            </header>
        </xpath>

        </field>
    </record>




</odoo>
