<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_repair_order_card" model="ir.ui.view">
      <field name="name">repair.order.repair.card.wexplay</field>
      <field name="model">repair.order</field>
      <field name="type">repair_card</field>
      <field name="arch" type="xml">
        <repair_card string="SAT Operativo"
                     class="wex_repair_card_view"
                     default_order="create_date desc, name desc"
                     quick_create="false"
                     records_draggable="false"
                     groups_draggable="false">
          <field name="name"/>
          <field name="create_date"/>
          <field name="product_id"/>
          <field name="partner_id"/>
          <field name="x_customer_reference"/>
          <field name="x_sat_priority"/>
          <field name="product_location_src_id"/>
          <field name="state"/>
          <field name="x_reported_issue"/>
          <field name="x_accessories"/>
          <field name="x_unlock_type"/>
          <field name="x_unlock_code"/>
          <field name="x_unlock_pattern"/>
          <field name="sale_order_id"/>
          <field name="user_id"/>
          <field name="tag_ids"/>
          <field name="x_model_id"/>
          <field name="x_brand_id"/>
          <field name="x_device_type"/>
          <templates>
            <t t-name="card">
              <div/>
            </t>
          </templates>
        </repair_card>
      </field>
    </record>

    <record id="repair.action_repair_order_tree" model="ir.actions.act_window">
      <field name="view_id" ref="wexplay_repair.view_repair_order_card"/>
      <field name="view_mode">repair_card,list,kanban,graph,pivot,form,activity</field>
      <field name="context">{'search_default_group_by_create_date_day': 1, 'search_default_wex_my_repairs': 1}</field>
    </record>

    <record id="action_repair_order_tree_view_repair_card" model="ir.actions.act_window.view">
      <field name="act_window_id" ref="repair.action_repair_order_tree"/>
      <field name="view_id" ref="wexplay_repair.view_repair_order_card"/>
      <field name="view_mode">repair_card</field>
      <field name="sequence">1</field>
    </record>

    <function model="ir.actions.act_window" name="_wexplay_configure_repair_order_tree_views"/>

  </data>
</odoo>
