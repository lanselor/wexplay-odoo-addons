<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-inherit="web.ListController" t-inherit-mode="extension">
    <xpath expr="//div[contains(@class,'o_cp_buttons')]" position="inside">
      <t t-if="props.resModel === 'repair.order'">
        <button type="button" class="btn btn-secondary me-2"
                t-on-click="wexExpandGroups">
          Expandir grupos
        </button>
        <button type="button" class="btn btn-secondary me-2"
                t-on-click="wexCollapseGroups">
          Colapsar grupos
        </button>
      </t>
    </xpath>
  </t>

</templates>
