<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="wexplay_repair.WexRepairListView.Buttons"
     t-inherit="web.ListView.Buttons"
     t-inherit-mode="extension"
     owl="1">

    <xpath expr="//div[contains(@class,'o_list_buttons')]" position="inside">
      <button type="button" class="btn btn-secondary me-2" t-on-click="wexExpandGroups">
        Expandir grupos
      </button>
      <button type="button" class="btn btn-secondary me-2" t-on-click="wexCollapseGroups">
        Colapsar grupos
      </button>
    </xpath>

  </t>
</templates>
