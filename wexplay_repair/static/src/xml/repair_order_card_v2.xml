<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="wexplay_repair.RepairOrderCardV2.Buttons"
     t-inherit="web.KanbanView.Buttons"
     t-inherit-mode="primary"
     owl="1">
  </t>

  <t t-name="wexplay_repair.RepairOrderCardV2.Renderer" owl="1">
    <div class="o_wex_repair_card_renderer">
      <div class="wex_v2_hero">
        <div class="wex_v2_hero_track">
        <button t-foreach="heroSections"
                t-as="section"
                t-key="section.key"
                type="button"
                t-att-class="this.getHeroTabClass(section)"
                t-on-click="() => this.openHeroSection(section)">
          <span class="wex_v2_hero_label">
            <t t-esc="section.short_title || section.title"/>
          </span>
          <span class="wex_v2_hero_count">
            <t t-esc="section.count"/>
          </span>
        </button>
        </div>
        <div t-if="heroIndicators.length" class="wex_v2_hero_indicators">
          <button t-foreach="heroIndicators"
                  t-as="indicator"
                  t-key="indicator.key"
                  type="button"
                  t-att-class="this.getHeroIndicatorClass(indicator)"
                  t-att-disabled="!indicator.enabled ? true : undefined"
                  t-on-click="() => this.openHeroIndicator(indicator)">
            <span class="wex_v2_hero_indicator_label">
              <t t-esc="indicator.title"/>
            </span>
            <span class="wex_v2_hero_indicator_count">
              <t t-esc="indicator.count"/>
            </span>
          </button>
        </div>
      </div>

      <div class="wex_repair_layout">

        <div class="wex_repair_content">
          <t t-if="!hasContent">
            <div class="o_view_nocontent_smiling_face wex_repair_empty_state">
              No hay ordenes de reparacion para mostrar.
            </div>
          </t>

          <t t-if="props.list.isGrouped">
            <div t-if="hasGroupedCards" class="wex_repair_group_toolbar">
              <button type="button"
                      class="btn btn-outline-secondary btn-sm"
                      t-on-click="() => this.toggleAllGroups()">
                <i t-att-class="'fa me-1 ' + groupToggleIcon"/>
                <t t-esc="groupToggleLabel"/>
              </button>
            </div>
            <div class="wex_repair_group_stack">
              <t t-foreach="groups" t-as="group" t-key="group.id">
                <section class="wex_repair_group" t-att-class="this.isGroupExpanded(group) ? '' : 'is-folded'">
                  <button type="button"
                          class="wex_repair_group_header"
                          t-on-click="() => this.toggleGroup(group)">
                    <span class="wex_repair_group_heading">
                      <i t-att-class="'fa wex_repair_group_caret ' + (this.isGroupExpanded(group) ? 'fa-caret-down' : 'fa-caret-right')"/>
                      <span class="wex_repair_group_identity">
                        <span class="wex_repair_group_meta">
                          <t t-esc="this.getGroupMetaLabel()"/>
                        </span>
                        <span class="wex_repair_group_title">
                          <t t-esc="this.getGroupLabel(group)"/>
                        </span>
                      </span>
                    </span>
                    <span class="wex_repair_group_count">
                      <t t-esc="group.count"/>
                    </span>
                  </button>

                  <div t-if="this.isGroupExpanded(group)" class="wex_repair_card_stack">
                    <t t-foreach="group.list.records" t-as="record" t-key="record.id">
                      <t t-call="wexplay_repair.RepairOrderCardView.Card"/>
                    </t>
                    <button t-if="this.hasMore(group)"
                            type="button"
                            class="btn btn-link wex_repair_group_more"
                            t-on-click="() => this.loadMore(group)">
                      Cargar mas
                    </button>
                  </div>
                </section>
              </t>
            </div>
          </t>

          <t t-else="">
            <div class="wex_repair_card_stack">
              <t t-foreach="records" t-as="record" t-key="record.id">
                <t t-call="wexplay_repair.RepairOrderCardView.Card"/>
              </t>
            </div>
          </t>
        </div>

        <aside class="wex_repair_sidebar">
          <div class="wex_repair_sidebar_header">
            <div>
              <div class="wex_repair_sidebar_kicker">Atencion SAT</div>
              <div class="wex_repair_sidebar_title">Pendientes que no deberian dormirse</div>
            </div>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary wex_repair_sidebar_refresh"
                    t-att-disabled="sidebarState.loading ? true : undefined"
                    t-on-click="() => this.loadSidebar()">
              <i class="fa fa-refresh me-1"/>
              Refrescar
            </button>
          </div>

          <div class="wex_repair_sidebar_body">
            <div t-if="sidebarGeneratedAt" class="wex_repair_sidebar_timestamp">
              Actualizado: <t t-esc="sidebarGeneratedAt"/>
            </div>

            <div t-if="sidebarState.loading" class="wex_repair_sidebar_loading">
              Cargando alertas operativas...
            </div>

            <div t-else="" class="wex_repair_sidebar_sections">
              <t t-foreach="sidebarGroups" t-as="group" t-key="group.key">
                <section t-att-class="this.getSidebarGroupClass(group)">
                  <div class="wex_v2_sidebar_metric_group_title">
                    <t t-esc="group.title"/>
                  </div>
                  <div class="wex_v2_sidebar_metric_list">
                    <button t-foreach="group.metrics"
                            t-as="metric"
                            t-key="metric.key"
                            type="button"
                            t-att-class="this.getSidebarMetricClass(metric)"
                            t-att-disabled="!metric.enabled ? true : undefined"
                            t-on-click="() => this.openSidebarMetric(metric)">
                      <span class="wex_v2_sidebar_metric_label">
                        <t t-esc="metric.title"/>
                      </span>
                      <span class="wex_v2_sidebar_metric_count">
                        <t t-esc="metric.count"/>
                      </span>
                      <span t-if="metric.enabled" class="wex_v2_sidebar_metric_arrow">
                        →
                      </span>
                    </button>
                  </div>
                </section>
              </t>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </t>

</templates>
