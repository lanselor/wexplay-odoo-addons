<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.wex.redsys</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'wex_redsys'">
                    <field name="redsys_merchant_code" required="code == 'wex_redsys' and state != 'disabled'"/>
                    <field name="redsys_terminal" required="code == 'wex_redsys' and state != 'disabled'"/>
                    <field name="redsys_secret_key" password="True" groups="base.group_system"
                           required="code == 'wex_redsys' and state != 'disabled'"/>
                    <div class="text-muted">Hosted card payment · EUR · HMAC SHA256 V1. Card saving is not supported.</div>
                </group>
            </group>
        </field>
    </record>
</odoo>
