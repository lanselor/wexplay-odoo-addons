<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_responsive_app_customizer.ChatterFooterBase"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension"
       owl="1">

        <xpath expr="//t[@t-if=&quot;props.has_activities and activities.length and !messageSearch.searching and !messageSearch.searched&quot;]" position="attributes">
            <attribute name="t-if">props.has_activities and activities.length and !messageSearch.searching and !messageSearch.searched and this.isWexChatterMainTabActive()</attribute>
        </xpath>

        <xpath expr="//t[@t-if=&quot;scheduledMessages.length&quot;]" position="attributes">
            <attribute name="t-if">scheduledMessages.length and this.isWexChatterMainTabActive()</attribute>
        </xpath>

        <xpath expr="//div[@t-if=&quot;state.isAttachmentBoxOpened&quot;]" position="attributes">
            <attribute name="t-if">state.isAttachmentBoxOpened and this.isWexChatterMainTabActive()</attribute>
        </xpath>

        <xpath expr="//SearchMessageResult[@t-if=&quot;messageSearch.searching or messageSearch.searched&quot;]" position="replace">
            <SearchMessageResult t-if="this.isWexChatterMainTabActive() and (messageSearch.searching or messageSearch.searched)"
                                 thread="state.thread"
                                 messageSearch="messageSearch"
                                 onClickJump.bind="closeSearch"/>
        </xpath>

        <xpath expr="//Thread[@t-else='']" position="replace">
            <Thread t-if="this.isWexChatterMainTabActive() and !(messageSearch.searching or messageSearch.searched)"
                    thread="state.thread"
                    t-key="state.thread.localId"
                    order="'desc'"
                    scrollRef="rootRef"
                    jumpPresent="state.jumpThreadPresent"/>
        </xpath>

        <xpath expr="//div[hasclass('o-mail-Chatter-content')]" position="after">
            <div t-if="this.isWexChatterFooterEnabled()"
                 class="wex-chatter-footer d-print-none">
                <t t-foreach="this.getWexChatterFooterTabs()" t-as="tab" t-key="tab.name">
                    <button type="button"
                            t-att-data-tab-name="tab.name"
                            t-att-class="'wex-chatter-footer__tab ' + (this.isWexChatterFooterTabActive(tab.name) ? 'is-active' : '')"
                            t-on-click="onClickWexChatterFooterTab">
                        <t t-out="tab.label"/>
                        <span t-if="tab.count"
                              class="wex-chatter-footer__count">
                            <t t-out="tab.count"/>
                        </span>
                    </button>
                </t>
            </div>
        </xpath>

    </t>

</templates>
