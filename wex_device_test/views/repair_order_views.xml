<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_repair_order_form_wex_device_test_results" model="ir.ui.view">
        <field name="name">repair.order.form.wex.device.test.results</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="wexplay_repair.view_repair_order_form_wexplay"/>
        <field name="arch" type="xml">
            <xpath expr="//page[div[contains(normalize-space(.), 'Espacio reservado para futuras pruebas.') or contains(normalize-space(.), 'Espacio reservado para resultados y pruebas del dispositivo.')]]" position="replace">
                <page string="Test" groups="wex_device_test.group_wex_device_test_manager">
                    <field name="x_device_test_active_run_id" invisible="1"/>
                    <field name="x_device_test_session_id" invisible="1"/>
                    <field name="x_device_test_result_ids" invisible="1"/>
                    <field name="x_device_test_log_ids" invisible="1"/>
                    <field name="x_device_test_footer_allowed" invisible="1"/>
                    <field name="x_device_test_overview_html" invisible="1"/>
                    <field name="x_device_test_results_summary_html" invisible="1"/>
                    <field name="x_device_test_categories_html" invisible="1"/>
                    <field name="x_device_test_environment_html" invisible="1"/>

                    <div class="alert alert-info mb-3" role="alert">
                        Esta pestaña muestra la información y los resultados que la app Android ha enviado a Odoo para esta reparación.
                    </div>

                    <div class="alert alert-light mb-3" role="alert" invisible="x_device_test_session_id">
                        Todavía no hay ningún dispositivo Android vinculado a esta reparación. Usa el footer o la pestaña <strong>Conector Android</strong> para iniciar la vinculación.
                    </div>

                    <div invisible="not x_device_test_session_id">
                        <div class="mb-4">
                            <div class="text-uppercase text-muted fw-semibold mb-2" style="font-size:11px;letter-spacing:.5px;">
                                Resumen operativo
                            </div>
                            <field name="x_device_test_overview_html" widget="html" readonly="1" nolabel="1"/>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-lg-8">
                                <div class="text-uppercase text-muted fw-semibold mb-2" style="font-size:11px;letter-spacing:.5px;">
                                    Bloques técnicos
                                </div>
                                <field name="x_device_test_categories_html" widget="html" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-lg-4">
                                <div class="text-uppercase text-muted fw-semibold mb-2" style="font-size:11px;letter-spacing:.5px;">
                                    Estado de pruebas
                                </div>
                                <field name="x_device_test_results_summary_html" widget="html" readonly="1" nolabel="1"/>
                            </div>
                        </div>

                        <div class="card border-0 bg-light mb-4" invisible="not x_device_test_last_message">
                            <div class="card-body">
                                <div class="text-uppercase text-muted fw-semibold mb-2" style="font-size:11px;letter-spacing:.5px;">
                                    Último mensaje recibido
                                </div>
                                <field name="x_device_test_last_message" readonly="1" nolabel="1"/>
                            </div>
                        </div>

                        <notebook class="mt-2">
                            <page string="Resultados">
                                <div class="text-muted mb-2">
                                    Histórico detallado de resultados recibidos para el run activo.
                                </div>
                                <field name="x_device_test_result_ids" readonly="1" nolabel="1">
                                    <list create="0" delete="0" edit="0">
                                        <field name="executed_at"/>
                                        <field name="test_type"/>
                                        <field name="status"/>
                                        <field name="message"/>
                                    </list>
                                    <form string="Resultado de test" create="0" delete="0" edit="0">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="session_id" readonly="1"/>
                                                    <field name="run_id" readonly="1"/>
                                                    <field name="test_type" readonly="1"/>
                                                    <field name="status" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="executed_at" readonly="1"/>
                                                    <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                                                </group>
                                            </group>
                                            <group string="Mensaje">
                                                <field name="message" readonly="1" nolabel="1"/>
                                            </group>
                                            <group string="Detalles técnicos">
                                                <field name="technical_details" readonly="1" nolabel="1"/>
                                            </group>
                                            <group string="Mediciones">
                                                <field name="measurement_json" readonly="1" nolabel="1" widget="text"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Logs">
                                <div class="text-muted mb-2">
                                    Trazas técnicas secundarias para depuración del run activo y la sesión Android.
                                </div>
                                <field name="x_device_test_log_ids" readonly="1" nolabel="1">
                                    <list create="0" delete="0" edit="0">
                                        <field name="create_date"/>
                                        <field name="event_type"/>
                                        <field name="status"/>
                                        <field name="message"/>
                                    </list>
                                    <form string="Log de test" create="0" delete="0" edit="0">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="session_id" readonly="1"/>
                                                    <field name="run_id" readonly="1"/>
                                                    <field name="event_type" readonly="1"/>
                                                    <field name="status" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="create_date" readonly="1"/>
                                                    <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                                                </group>
                                            </group>
                                            <group string="Mensaje">
                                                <field name="message" readonly="1" nolabel="1"/>
                                            </group>
                                            <group string="Detalles técnicos">
                                                <field name="technical_details" readonly="1" nolabel="1"/>
                                            </group>
                                            <group string="Payload">
                                                <field name="payload_json" readonly="1" nolabel="1" widget="text"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_repair_order_form_wex_device_test_connector" model="ir.ui.view">
        <field name="name">repair.order.form.wex.device.test.connector</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="wexplay_repair.view_repair_order_form_wexplay"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='wex_repair_technical_sections']//notebook/page[div[hasclass('wex_repair_form_signatures_placeholder')]]" position="before">
                <page string="Conector Android" groups="wex_device_test.group_wex_device_test_manager">
                    <field name="x_device_test_active_run_id" invisible="1"/>
                    <field name="x_device_test_session_id" invisible="1"/>
                    <field name="x_device_test_show_pairing_token" invisible="1"/>
                    <field name="x_device_test_download_qr_html" invisible="1"/>
                    <field name="x_device_test_pairing_qr_html" invisible="1"/>
                    <field name="x_device_test_pairing_payload" invisible="1"/>
                    <field name="x_device_test_show_preparation_panel" invisible="1"/>
                    <field name="x_device_test_show_operations_panel" invisible="1"/>
                    <field name="x_device_test_footer_allowed" invisible="1"/>
                    <div class="alert alert-info mb-3" role="alert">
                        Usa esta pestaña para preparar la revisión técnica, descargar la APK y vincular la app Android con esta reparación sin copiar datos manualmente.
                    </div>

                    <div class="card border-0 bg-light mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                <div>
                                    <div class="text-uppercase text-muted fw-semibold" style="font-size:11px;letter-spacing:.5px;">
                                        1. Preparar vinculación
                                    </div>
                                    <div class="fw-semibold">
                                        Descargar APK y conectar la app con esta reparación
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <button name="action_start_device_test_run"
                                            type="object"
                                            string="Start Test Run"
                                            class="btn btn-primary"
                                            invisible="x_device_test_active_run_id"/>
                                    <button name="action_restart_active_device_test_pairing"
                                            type="object"
                                            string="Restart Pairing"
                                            class="btn btn-outline-secondary"
                                            invisible="not x_device_test_active_run_id"/>
                                </div>
                            </div>

                            <div invisible="not x_device_test_show_preparation_panel">
                                <div class="d-flex flex-nowrap gap-3 align-items-stretch overflow-auto">
                                    <div class="card bg-white border-0 shadow-sm flex-grow-1" style="min-width:320px;">
                                        <div class="card-body">
                                            <div class="text-uppercase text-muted fw-semibold mb-2" style="font-size:11px;letter-spacing:.5px;">
                                                APK Download
                                            </div>
                                            <p class="mb-3">
                                                Escanea este QR desde la cámara del teléfono para abrir <code>www.wexplay.com/test</code> y descargar la APK actual.
                                            </p>
                                            <field name="x_device_test_download_qr_html" widget="html" readonly="1" nolabel="1"/>
                                            <field name="x_device_test_download_url" widget="url" readonly="1" nolabel="1"/>
                                        </div>
                                    </div>

                                    <div class="card bg-white border-0 shadow-sm flex-grow-1" style="min-width:320px;">
                                        <div class="card-body">
                                            <div class="text-uppercase text-muted fw-semibold mb-2" style="font-size:11px;letter-spacing:.5px;">
                                                Repair Pairing
                                            </div>
                                            <div invisible="x_device_test_active_run_id">
                                                <p class="text-muted mb-0">
                                                    Crea primero un <strong>Test Run</strong> para generar el QR de vinculación de esta reparación.
                                                </p>
                                            </div>
                                            <div invisible="not x_device_test_active_run_id">
                                                <div invisible="not x_device_test_pairing_payload">
                                                    <p class="mb-3">
                                                        Escanea este QR desde la app Android para rellenar la URL de Odoo, el token técnico, el código corto y el <code>run_id</code> de esta reparación.
                                                    </p>
                                                    <field name="x_device_test_pairing_qr_html" widget="html" readonly="1" nolabel="1"/>
                                                    <p class="text-muted small mb-0">
                                                        Flujo recomendado: QR desde la app, luego revisar que el run pase a <code>Paired</code>.
                                                    </p>
                                                </div>
                                                <div class="alert alert-warning mb-0" role="alert" invisible="x_device_test_pairing_payload">
                                                    Configura primero la <strong>URL base pública</strong> en Ajustes de Device Test para poder generar el QR de vinculación.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div invisible="x_device_test_show_preparation_panel">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div class="text-muted">
                                        Vinculación preparada. El panel operativo de la sesión activa está abierto debajo.
                                    </div>
                                    <button name="action_open_device_test_run"
                                            type="object"
                                            string="Open Active Run"
                                            class="btn btn-outline-primary"
                                            invisible="not x_device_test_active_run_id"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 bg-light" invisible="not x_device_test_show_operations_panel">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                <div>
                                    <div class="text-uppercase text-muted fw-semibold" style="font-size:11px;letter-spacing:.5px;">
                                        2. Sesión activa
                                    </div>
                                    <div class="fw-semibold">
                                        Control del run vinculado y acceso rápido a la revisión operativa
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <button name="action_open_device_test_run"
                                            type="object"
                                            string="Open Active Run"
                                            class="btn btn-outline-primary"
                                            invisible="not x_device_test_active_run_id"/>
                                    <button name="action_restart_active_device_test_pairing"
                                            type="object"
                                            string="Restart Pairing"
                                            class="btn btn-outline-secondary"
                                            invisible="not x_device_test_active_run_id"/>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-lg-7">
                                    <group col="2" string="Current Run">
                                        <field name="x_device_test_state" readonly="1"/>
                                        <field name="x_device_test_session_id" readonly="1"/>
                                        <field name="x_device_test_pairing_code" readonly="1" string="Short Pairing Code"/>
                                        <div>
                                            <div class="o_form_label">Technical Pairing Token</div>
                                            <div class="d-flex align-items-center gap-2">
                                                <field name="x_device_test_pairing_token" readonly="1" password="True" invisible="x_device_test_show_pairing_token"/>
                                                <field name="x_device_test_pairing_token" readonly="1" invisible="not x_device_test_show_pairing_token"/>
                                                <button name="action_show_active_device_test_token"
                                                        type="object"
                                                        icon="fa-eye"
                                                        class="btn btn-outline-secondary"
                                                        title="Mostrar token"
                                                        invisible="x_device_test_show_pairing_token"/>
                                                <button name="action_hide_active_device_test_token"
                                                        type="object"
                                                        icon="fa-eye-slash"
                                                        class="btn btn-outline-secondary"
                                                        title="Ocultar token"
                                                        invisible="not x_device_test_show_pairing_token"/>
                                            </div>
                                        </div>
                                    </group>
                                </div>
                                <div class="col-lg-5">
                                    <group col="2" string="History">
                                        <field name="x_device_test_run_count" readonly="1"/>
                                        <field name="x_device_test_active_run_id" readonly="1"/>
                                    </group>
                                </div>
                            </div>
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
