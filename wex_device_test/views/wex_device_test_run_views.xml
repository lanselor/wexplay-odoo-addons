<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_device_test_run_search" model="ir.ui.view">
        <field name="name">wex.device.test.run.search</field>
        <field name="model">wex.device.test.run</field>
        <field name="arch" type="xml">
            <search string="Device Test Runs">
                <field name="name"/>
                <field name="repair_order_id"/>
                <field name="session_id"/>
                <field name="user_id"/>
                <filter name="filter_pending_pairing" string="Pending Pairing" domain="[('state', '=', 'pending_pairing')]"/>
                <filter name="filter_active" string="Active" domain="[('state', 'in', ('pending_pairing', 'paired', 'in_progress'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_by_user" string="Technician" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wex_device_test_run_list" model="ir.ui.view">
        <field name="name">wex.device.test.run.list</field>
        <field name="model">wex.device.test.run</field>
        <field name="arch" type="xml">
            <list string="Device Test Runs">
                <field name="name"/>
                <field name="repair_order_id"/>
                <field name="session_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="started_at"/>
                <field name="paired_at"/>
                <field name="completed_at"/>
            </list>
        </field>
    </record>

    <record id="view_wex_device_test_run_form" model="ir.ui.view">
        <field name="name">wex.device.test.run.form</field>
        <field name="model">wex.device.test.run</field>
        <field name="arch" type="xml">
            <form string="Device Test Run">
                <header>
                    <field name="show_pairing_token" invisible="1"/>
                    <button name="action_start_pairing" type="object" string="Restart Pairing" class="btn-primary" invisible="state not in ('cancelled', 'completed')"/>
                    <button name="action_cancel_pairing" type="object" string="Cancel" invisible="state in ('cancelled', 'completed')"/>
                    <button name="action_mark_completed" type="object" string="Mark Completed" invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_show_pairing_token" type="object" icon="fa-eye" class="btn-secondary" title="Mostrar token" invisible="show_pairing_token"/>
                    <button name="action_hide_pairing_token" type="object" icon="fa-eye-slash" class="btn-secondary" title="Ocultar token" invisible="not show_pairing_token"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending_pairing,paired,in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="repair_order_id" readonly="1"/>
                            <field name="session_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="started_at" readonly="1"/>
                            <field name="paired_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                            <field name="cancelled_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Pairing">
                        <group>
                            <field name="pairing_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="pairing_token" readonly="1" password="True" invisible="show_pairing_token"/>
                            <field name="pairing_token" readonly="1" invisible="not show_pairing_token"/>
                        </group>
                    </group>
                    <group string="Last Message">
                        <field name="last_message" readonly="1" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Results">
                            <field name="result_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="executed_at"/>
                                    <field name="test_type"/>
                                    <field name="status"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Logs">
                            <field name="log_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="create_date"/>
                                    <field name="event_type"/>
                                    <field name="status"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wex_device_test_runs" model="ir.actions.act_window">
        <field name="name">Runs</field>
        <field name="res_model">wex.device.test.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wex_device_test_run_search"/>
    </record>

    <menuitem
        id="menu_wex_device_test_runs"
        name="Runs"
        parent="menu_wex_device_test_root"
        action="action_wex_device_test_runs"
        sequence="20"
        groups="wex_device_test.group_wex_device_test_manager"
    />
</odoo>
