<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_device_test_session_search" model="ir.ui.view">
        <field name="name">wex.device.test.session.search</field>
        <field name="model">wex.device.test.session</field>
        <field name="arch" type="xml">
            <search string="Device Test Sessions">
                <field name="name"/>
                <field name="device_uuid"/>
                <field name="manufacturer"/>
                <field name="model"/>
                <field name="android_version"/>
                <field name="app_version"/>
                <filter name="filter_status_ok" string="OK" domain="[('last_status', '=', 'ok')]"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_by_manufacturer" string="Manufacturer" context="{'group_by': 'manufacturer'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'last_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wex_device_test_session_list" model="ir.ui.view">
        <field name="name">wex.device.test.session.list</field>
        <field name="model">wex.device.test.session</field>
        <field name="arch" type="xml">
            <list string="Device Test Sessions">
                <field name="name"/>
                <field name="device_uuid"/>
                <field name="manufacturer"/>
                <field name="model"/>
                <field name="android_version"/>
                <field name="app_version"/>
                <field name="ping_count"/>
                <field name="last_ping_at"/>
                <field name="last_diagnostic_at"/>
                <field name="last_test_at"/>
                <field name="last_status"/>
                <field name="last_seen_ip" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wex_device_test_session_form" model="ir.ui.view">
        <field name="name">wex.device.test.session.form</field>
        <field name="model">wex.device.test.session</field>
        <field name="arch" type="xml">
            <form string="Device Test Session">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="Session">
                            <group string="Datos del dispositivo">
                                <group>
                                    <field name="device_uuid" readonly="1"/>
                                    <field name="manufacturer" readonly="1"/>
                                    <field name="model" readonly="1"/>
                                </group>
                                <group>
                                    <field name="android_version" readonly="1"/>
                                    <field name="sdk_int" readonly="1"/>
                                    <field name="app_version" readonly="1"/>
                                </group>
                            </group>
                            <group string="Última conexión">
                                <group>
                                    <field name="first_ping_at" readonly="1"/>
                                    <field name="last_ping_at" readonly="1"/>
                                    <field name="ping_count" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_status" readonly="1"/>
                                    <field name="last_seen_ip" readonly="1"/>
                                    <field name="last_user_agent" readonly="1"/>
                                </group>
                            </group>
                            <group string="Último diagnóstico">
                                <group>
                                    <field name="last_diagnostic_at" readonly="1"/>
                                    <field name="last_battery_level" readonly="1"/>
                                    <field name="last_test_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_network_type" readonly="1"/>
                                    <field name="last_storage_free_mb" readonly="1"/>
                                    <field name="last_storage_total_mb" readonly="1"/>
                                </group>
                            </group>
                            <group string="Última información térmica">
                                <group>
                                    <field name="last_battery_temperature_c" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_thermal_status" readonly="1"/>
                                </group>
                            </group>
                            <group string="Mensaje recibido">
                                <field name="last_message" readonly="1" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Resultados">
                            <field name="result_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="executed_at"/>
                                    <field name="run_id"/>
                                    <field name="test_type"/>
                                    <field name="status"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Runs">
                            <field name="run_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="started_at"/>
                                    <field name="repair_order_id"/>
                                    <field name="state"/>
                                    <field name="pairing_code"/>
                                </list>
                            </field>
                        </page>
                        <page string="Logs">
                            <field name="log_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="create_date"/>
                                    <field name="run_id"/>
                                    <field name="event_type"/>
                                    <field name="status"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wex_device_test_sessions" model="ir.actions.act_window">
        <field name="name">Sesiones</field>
        <field name="res_model">wex.device.test.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wex_device_test_session_search"/>
    </record>

    <menuitem
        id="menu_wexplay_root_device_test"
        name="API Test"
        sequence="80"
        groups="wex_device_test.group_wex_device_test_manager"
    />

    <menuitem
        id="menu_wex_device_test_root"
        name="Device Test"
        parent="menu_wexplay_root_device_test"
        sequence="10"
        groups="wex_device_test.group_wex_device_test_manager"
    />

    <menuitem
        id="menu_wex_device_test_sessions"
        name="Sesiones"
        parent="menu_wex_device_test_root"
        action="action_wex_device_test_sessions"
        sequence="10"
        groups="wex_device_test.group_wex_device_test_manager"
    />
</odoo>
