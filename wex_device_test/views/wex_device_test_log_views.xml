<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wex_device_test_log_search" model="ir.ui.view">
        <field name="name">wex.device.test.log.search</field>
        <field name="model">wex.device.test.log</field>
        <field name="arch" type="xml">
            <search string="Device Test Logs">
                <field name="session_id"/>
                <field name="event_type"/>
                <field name="run_id"/>
                <field name="status"/>
                <field name="message"/>
                <filter name="filter_log_ok" string="OK" domain="[('status', '=', 'ok')]"/>
                <filter name="filter_log_warning" string="Warning" domain="[('status', '=', 'warning')]"/>
                <filter name="filter_log_error" string="Error" domain="[('status', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wex_device_test_log_list" model="ir.ui.view">
        <field name="name">wex.device.test.log.list</field>
        <field name="model">wex.device.test.log</field>
        <field name="arch" type="xml">
            <list string="Device Test Logs" create="0" delete="0" edit="0">
                <field name="create_date"/>
                <field name="session_id"/>
                <field name="event_type"/>
                <field name="status"/>
                <field name="message"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wex_device_test_log_form" model="ir.ui.view">
        <field name="name">wex.device.test.log.form</field>
        <field name="model">wex.device.test.log</field>
        <field name="arch" type="xml">
            <form string="Device Test Log" create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="session_id" readonly="1"/>
                            <field name="run_id" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Technical Details">
                        <field name="technical_details" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Payload JSON">
                        <field name="payload_json" readonly="1" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wex_device_test_logs" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="res_model">wex.device.test.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wex_device_test_log_search"/>
    </record>

    <menuitem
        id="menu_wex_device_test_logs"
        name="Logs"
        parent="menu_wex_device_test_root"
        action="action_wex_device_test_logs"
        sequence="20"
        groups="wex_device_test.group_wex_device_test_manager"
    />
</odoo>
