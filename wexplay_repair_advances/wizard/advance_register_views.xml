<odoo>
    <record id="advance_register_form" model="ir.ui.view">
        <field name="name">wex.repair.advance.register.form</field>
        <field name="model">wex.repair.advance.register</field>
        <field name="arch" type="xml">
            <form string="Registrar anticipo">
                <group>
                    <field name="repair_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="allowed_journal_ids" invisible="1"/>
                    <field name="available_payment_method_line_ids" invisible="1"/>
                    <field name="amount"/>
                    <field name="journal_id" domain="[('id', 'in', allowed_journal_ids)]" options="{'no_create': True}"/>
                    <field name="payment_method_line_id" domain="[('id', 'in', available_payment_method_line_ids)]" options="{'no_create': True}" readonly="not journal_id"/>
                    <field name="date"/>
                    <field name="memo"/>
                </group>
                <footer>
                    <button name="action_register" type="object" string="Registrar cobro" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
