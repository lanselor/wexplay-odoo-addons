<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_repair_order_form_wex_consent" model="ir.ui.view">
        <field name="name">repair.order.form.wex.consent</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="wexplay_repair.view_repair_order_form_wexplay"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_consent_documents"
                        type="object"
                        string="Consentimientos"
                        class="btn btn-secondary"
                        groups="wex_consent.group_wex_consent_user"/>
            </xpath>

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_consent_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-pdf-o"
                        groups="wex_consent.group_wex_consent_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Firmas</span>
                        <span class="o_stat_value">
                            <field name="x_consent_document_count"/>
                        </span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='x_accessories']" position="after">
                <div class="wex_repair_form_accessories">
                    <label for="x_device_description" string="Descripción del dispositivo"/>
                    <field name="x_device_description"
                           widget="text"
                           nolabel="1"
                           placeholder="Color, estado estético, golpes visibles, capacidad, configuración entregada..."/>
                </div>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="x_reception_consent_signed" invisible="1"/>
                <field name="x_delivery_consent_signed" invisible="1"/>
                <field name="x_reception_consent_status" invisible="1"/>
                <field name="x_delivery_consent_status" invisible="1"/>
            </xpath>

            <xpath expr="//div[hasclass('wex_repair_form_signatures_placeholder')]" position="replace">
                <div class="wex_repair_form_signatures_placeholder">
                    <div class="row g-3 mb-3">
                        <div class="col-lg-6">
                            <div class="wex_consent_status_card">
                                <div class="wex_consent_status_label">Recepción</div>
                                <div class="wex_consent_status_value">
                                    <field name="x_reception_consent_status" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="wex_consent_status_card">
                                <div class="wex_consent_status_label">Entrega</div>
                                <div class="wex_consent_status_value">
                                    <field name="x_delivery_consent_status" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button name="action_request_reception_signature"
                                type="object"
                                string="Solicitar firma de recepción"
                                class="btn btn-primary"
                                invisible="x_reception_consent_signed"
                                groups="wex_consent.group_wex_consent_user"/>
                        <button name="action_request_delivery_signature"
                                type="object"
                                string="Solicitar firma de entrega"
                                class="btn btn-secondary"
                                invisible="x_delivery_consent_signed"
                                groups="wex_consent.group_wex_consent_user"/>
                    </div>

                    <field name="x_consent_document_ids" readonly="1" nolabel="1">
                        <list create="0" delete="0">
                            <field name="document_type" string="Tipo de documento"/>
                            <field name="state" string="Estado"/>
                            <field name="signer_name" string="Firmante"/>
                            <field name="signed_at" string="Firmado el"/>
                            <field name="pdf_filename" string="Nombre del PDF"/>
                            <button name="action_open_pdf"
                                    type="object"
                                    string="Abrir PDF"
                                    class="btn btn-link"
                                    invisible="not pdf_file and not dms_file_id"/>
                        </list>
                    </field>
                </div>
            </xpath>

            <xpath expr="//notebook[hasclass('wex_repair_form_technical_notebook')]/page[div[hasclass('wex_repair_form_signatures_placeholder')]]" position="after">
                <page name="wex_sat_images_page" string="Imágenes" class="wex_consent_notebook_page">
                    <div class="alert alert-info mb-0">
                        Espacio reservado para imágenes SAT relacionadas con la reparación.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
