<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_portal_repair_shipping_ready" model="mail.template">
            <field name="name">Portal SAT - Operación MRW disponible</field>
            <field name="model_id" ref="wexplay_repair_delivery.model_wex_repair_shipping_operation"/>
            <field name="subject">Actualización de {{ object._get_portal_shipping_notification_operation_label() }} - SAT {{ object.repair_id.name or '' }}</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 0;">
                    <p style="font-size: 13px;">
                        Hola <t t-out="object.repair_id.partner_id.name or ''"/>,
                        <br/><br/>
                        La operación <strong><t t-out="object._get_portal_shipping_notification_operation_label()"/></strong>
                        de tu reparación ya está disponible.
                        <br/><br/>
                        <strong>Referencia SAT:</strong> <t t-out="object.repair_id.name or ''"/><br/>
                        <strong>Referencia MRW:</strong> <t t-out="object.tracking_ref or object.mrw_shipment_number or ''"/><br/>
                        <t t-if="object._get_tracking_url()">
                            Puedes consultar el estado en
                            <a t-att-href="object._get_tracking_url()" target="_blank">el seguimiento de MRW</a>.
                            <br/>
                        </t>
                        <br/>
                        <a t-att-href="object._get_portal_shipping_notification_url()">
                            Acceder a la reparación en el portal
                        </a>
                        <br/><br/>
                        Un saludo,<br/>
                        <t t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
