<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_shipping_operation_view_form_mrw_whatsapp" model="ir.ui.view">
        <field name="name">wex.repair.shipping.operation.form.mrw.whatsapp</field>
        <field name="model">wex.repair.shipping.operation</field>
        <field name="inherit_id" ref="wexplay_repair_delivery.view_wex_repair_shipping_operation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_open_mrw_whatsapp"
                    type="object"
                    string="WhatsApp"
                    class="btn-success"
                    icon="fa-whatsapp"
                    invisible="not mrw_shipment_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
