<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wex_teardown.DataCompletionWidget">
        <div class="wex_td_data_completion">
            <t t-if="state.loading">
                <div class="text-muted">Cargando piezas...</div>
            </t>
            <t t-elif="!state.rows.length">
                <div class="text-muted">No hay piezas aptas pendientes de completar.</div>
            </t>
            <t t-else="">
                <div class="wex_td_data_table">
                    <div class="wex_td_data_header">
                        <span>Componente</span>
                        <span>Part number</span>
                        <span>Cantidad</span>
                        <span>Nombre sugerido</span>
                        <span>Estado</span>
                        <span>Acciones</span>
                    </div>
                    <t t-foreach="state.rows" t-as="row" t-key="row.id">
                        <div class="wex_td_data_row"
                             t-att-class="{'is-expanded': isExpanded(row.id)}">
                            <div class="wex_td_data_summary">
                                <span t-esc="row.component_name"/>
                                <span t-esc="row.part_number || '-'"/>
                                <span t-esc="row.quantity"/>
                                <span t-esc="row.name_suggested || '-'"/>
                                <span t-esc="row.state_label"/>
                                <span class="wex_td_data_actions">
                                    <button type="button" class="btn btn-link p-0"
                                            t-att-data-row-id="row.id"
                                            t-on-click="toggleExpand"
                                            title="Editar precios">
                                        <i class="fa fa-pencil"/>
                                    </button>
                                </span>
                            </div>
                            <t t-if="isExpanded(row.id)">
                                <div class="wex_td_data_editor">
                                    <div class="wex_td_data_context">
                                        <div class="wex_td_data_context_piece">
                                            <span class="badge text-bg-light">Pieza</span>
                                            <strong t-esc="row.component_name"/>
                                        </div>
                                        <t t-if="row.existing_product_name">
                                            <div class="wex_td_data_context_product">
                                                <span class="badge text-bg-success">Producto seleccionado</span>
                                                <strong t-esc="row.existing_product_name"/>
                                                <t t-if="row.existing_product_update_name">
                                                    <span class="badge text-bg-warning">Se actualizará el nombre</span>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-elif="row.decision_label">
                                            <div class="wex_td_data_context_product">
                                                <span class="badge text-bg-secondary" t-esc="row.decision_label"/>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="wex_td_data_editor_grid">
                                        <label>
                                            <span>Precio sin IVA</span>
                                            <input type="number"
                                                   step="0.01"
                                                   class="form-control"
                                                   t-att-value="getDraft(row).list_price"
                                                   t-att-data-row-id="row.id"
                                                   t-on-input="handlePriceInput"/>
                                        </label>
                                        <label>
                                            <span>PVP IVA incluido</span>
                                            <input type="number"
                                                   step="0.01"
                                                   class="form-control"
                                                   t-att-value="getDraft(row).pvp_tax_included"
                                                   t-att-data-row-id="row.id"
                                                   t-on-input="handlePvpInput"/>
                                        </label>
                                        <label>
                                            <span>Coste</span>
                                            <input type="number"
                                                   step="0.01"
                                                   class="form-control"
                                                   t-att-value="getDraft(row).standard_price"
                                                   t-att-data-row-id="row.id"
                                                   t-on-input="handleCostInput"/>
                                        </label>
                                        <label>
                                            <span>Impuestos</span>
                                            <div class="wex_td_data_tax_labels">
                                                <t t-if="row.tax_labels.length">
                                                    <t t-foreach="row.tax_labels" t-as="taxLabel" t-key="taxLabel">
                                                        <span class="badge text-bg-light" t-esc="taxLabel"/>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">Sin impuestos definidos</span>
                                                </t>
                                            </div>
                                        </label>
                                    </div>
                                    <div class="wex_td_data_editor_meta">
                                        <t t-if="row.decision_label and !row.existing_product_name">
                                            <span class="badge text-bg-secondary" t-esc="row.decision_label"/>
                                        </t>
                                    </div>
                                    <div class="wex_td_data_editor_footer">
                                        <button type="button" class="btn btn-secondary"
                                                t-att-data-row-id="row.id"
                                                t-on-click="cancelEdit">
                                            Cancelar
                                        </button>
                                        <button type="button" class="btn btn-primary"
                                                t-att-data-row-id="row.id"
                                                t-att-disabled="state.savingId === row.id"
                                                t-on-click="saveRow">
                                            Guardar
                                        </button>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
