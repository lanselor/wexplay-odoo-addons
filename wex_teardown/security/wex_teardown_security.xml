<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wex_teardown" model="ir.module.category">
        <field name="name">Despieces</field>
        <field name="description">Gestion de despieces Wexplay</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_wex_teardown_user" model="res.groups">
        <field name="name">Usuario Despieces</field>
        <field name="category_id" ref="module_category_wex_teardown"/>
    </record>

    <record id="group_wex_teardown_manager" model="res.groups">
        <field name="name">Responsable Despieces</field>
        <field name="category_id" ref="module_category_wex_teardown"/>
        <field name="implied_ids" eval="[(4, ref('group_wex_teardown_user'))]"/>
    </record>

    <record id="rule_wex_teardown_batch_company" model="ir.rule">
        <field name="name">Despieces por compania</field>
        <field name="model_id" ref="model_wex_teardown_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_wex_teardown_user'))]"/>
    </record>

    <record id="rule_wex_teardown_line_company" model="ir.rule">
        <field name="name">Lineas de despiece por compania</field>
        <field name="model_id" ref="model_wex_teardown_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_wex_teardown_user'))]"/>
    </record>
</odoo>
