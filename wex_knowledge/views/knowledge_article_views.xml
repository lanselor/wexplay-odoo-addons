<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_wex_knowledge_article_search" model="ir.ui.view">
        <field name="name">wex.knowledge.article.search</field>
        <field name="model">wex.knowledge.article</field>
        <field name="arch" type="xml">
            <search string="Knowledge Articles">
                <field name="name"/>
                <field name="subtitle"/>
                <field name="author_id"/>
                <field name="owner_id"/>
                <field name="category_ids"/>
                <field name="tag_ids"/>
                <filter name="favorites" string="Favoritos" domain="[('is_favorite', '=', True)]"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="published" string="Publicado" domain="[('state', '=', 'published')]"/>
                <filter name="archived" string="Archivado" domain="[('state', '=', 'archived')]"/>
                <filter name="obsolete" string="Obsoleto" domain="[('state', '=', 'obsolete')]"/>
                <filter name="private" string="Privado" domain="[('visibility', '=', 'private')]"/>
                <filter name="internal" string="Interno" domain="[('visibility', '=', 'internal')]"/>
                <filter name="by_group" string="Por grupo" domain="[('visibility', '=', 'by_group')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_category" string="Categoría" context="{'group_by': 'category_ids'}"/>
                    <filter name="group_owner" string="Propietario" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wex_knowledge_article_list" model="ir.ui.view">
        <field name="name">wex.knowledge.article.list</field>
        <field name="model">wex.knowledge.article</field>
        <field name="arch" type="xml">
            <list string="Knowledge Articles" default_order="write_date desc">
                <field name="is_favorite" widget="boolean_favorite"/>
                <field name="name"/>
                <field name="subtitle"/>
                <field name="state" widget="badge"/>
                <field name="visibility" widget="badge"/>
                <field name="owner_id"/>
                <field name="last_editor_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_locked" widget="boolean_toggle" groups="wex_knowledge.group_knowledge_manager"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_wex_knowledge_article_form" model="ir.ui.view">
        <field name="name">wex.knowledge.article.form</field>
        <field name="model">wex.knowledge.article</field>
        <field name="arch" type="xml">
            <form class="wex_kb_article_form" string="Knowledge Article">
                <header>
                    <button name="action_return_to_explorer" type="object" string="Volver al explorador" class="btn-secondary"/>
                    <button name="action_publish" type="object" string="Publicar" class="btn-primary" invisible="state == 'published' or not can_publish" groups="wex_knowledge.group_knowledge_editor,wex_knowledge.group_knowledge_manager"/>
                    <button name="action_archive" type="object" string="Archivar" invisible="state == 'archived'" groups="wex_knowledge.group_knowledge_editor,wex_knowledge.group_knowledge_manager"/>
                    <button name="action_mark_obsolete" type="object" string="Marcar obsoleto" invisible="state == 'obsolete'" groups="wex_knowledge.group_knowledge_editor,wex_knowledge.group_knowledge_manager"/>
                    <button name="action_reset_draft" type="object" string="Volver a borrador" invisible="state == 'draft'" groups="wex_knowledge.group_knowledge_editor,wex_knowledge.group_knowledge_manager"/>
                    <button name="action_lock" type="object" string="Bloquear" class="btn-secondary" invisible="is_locked" groups="wex_knowledge.group_knowledge_manager"/>
                    <button name="action_unlock" type="object" string="Desbloquear" class="btn-secondary" invisible="not is_locked" groups="wex_knowledge.group_knowledge_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived,obsolete"/>
                </header>
                <sheet>
                    <field name="can_publish" invisible="1"/>
                    <widget name="web_ribbon" title="Bloqueado" bg_color="text-bg-warning" invisible="not is_locked"/>
                    <div class="wex_kb_workspace_shell">
                        <aside class="wex_kb_workspace_sidebar">
                            <div class="wex_kb_workspace_brand">
                                <span class="wex_kb_workspace_icon"><i class="fa fa-book"/></span>
                                <div>
                                    <div class="wex_kb_workspace_label">Base de conocimiento</div>
                                    <strong>Espacio editorial</strong>
                                </div>
                            </div>

                            <div class="wex_kb_workspace_nav">
                                <div class="wex_kb_sidebar_heading">Articulo principal</div>
                                <field name="display_path" readonly="1" invisible="not id"/>
                                <field name="parent_id"
                                       string="Articulo principal"
                                       placeholder="Selecciona un articulo principal"
                                       readonly="id and not can_edit"/>
                                <div class="wex_kb_sidebar_meta_row" invisible="not id">
                                    <span>Sub-articulos</span>
                                    <strong><field name="child_count" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="wex_kb_sidebar_action_row" invisible="not id">
                                    <button type="object" name="action_open_children" class="btn btn-link p-0">Ver sub-articulos</button>
                                    <button type="object" name="action_create_child_article" class="btn btn-link p-0" invisible="not can_edit">Nuevo sub-articulo</button>
                                </div>
                            </div>

                            <div class="wex_kb_workspace_nav">
                                <div class="wex_kb_sidebar_heading">Categorías</div>
                                <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="id and not can_edit"/>
                            </div>

                            <div class="wex_kb_workspace_nav">
                                <div class="wex_kb_sidebar_heading">Etiquetas</div>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="id and not can_edit"/>
                            </div>

                            <div class="wex_kb_workspace_nav">
                                <div class="wex_kb_sidebar_heading">Contribución</div>
                                <field name="author_id" readonly="1"/>
                                <field name="owner_id" readonly="id and not can_edit"/>
                                <field name="collaborator_ids" widget="many2many_tags" readonly="id and not can_manage_relations"/>
                            </div>

                            <div class="wex_kb_workspace_nav">
                                <div class="wex_kb_sidebar_heading">Estado editorial</div>
                                <field name="state" readonly="1"/>
                                <div class="text-muted">
                                    La publicación externa se gestiona aparte desde los canales portal y enlace público.
                                </div>
                            </div>

                            <div class="wex_kb_workspace_nav">
                                <div class="wex_kb_sidebar_heading">Acceso interno</div>
                                <field name="visibility"/>
                                <field name="allowed_group_ids" widget="many2many_tags" invisible="visibility != 'by_group'" groups="wex_knowledge.group_knowledge_editor,wex_knowledge.group_knowledge_manager"/>
                                <field name="company_id" groups="base.group_multi_company,wex_knowledge.group_knowledge_manager"/>
                                <field name="is_global" groups="wex_knowledge.group_knowledge_manager"/>
                                <div class="wex_kb_sidebar_meta_row" invisible="not id">
                                    <span>Último editor</span>
                                    <strong><field name="last_editor_id" readonly="1" nolabel="1"/></strong>
                                </div>
                            </div>
                        </aside>

                        <div class="wex_kb_workspace_main">
                            <div class="wex_kb_workspace_topbar">
                                <div class="wex_kb_workspace_breadcrumbs">
                                    <span>Base de conocimiento</span>
                                    <i class="fa fa-angle-right"/>
                                    <span>Artículos</span>
                                    <i class="fa fa-angle-right"/>
                                    <span invisible="not id"><field name="name" readonly="1" nolabel="1"/></span>
                                    <span invisible="id">Nuevo artículo</span>
                                </div>
                                <div class="wex_kb_workspace_tools">
                                    <div class="oe_button_box" name="button_box">
                                        <button name="action_toggle_favorite" type="object" class="oe_stat_button" icon="fa-star">
                                            <div class="o_stat_info">
                                                <span class="o_stat_text">Favorito</span>
                                                <span class="o_stat_value"><field name="is_favorite" widget="boolean_favorite"/></span>
                                            </div>
                                        </button>
                                        <button type="object" name="action_open_related_links" class="oe_stat_button" icon="fa-link">
                                            <div class="o_stat_info">
                                                <span class="o_stat_text">Relacionados</span>
                                                <span class="o_stat_value"><field name="related_record_count"/></span>
                                            </div>
                                        </button>
                                        <button type="object" name="action_open_children" class="oe_stat_button" icon="fa-sitemap">
                                            <div class="o_stat_info">
                                                <span class="o_stat_text">Sub-articulos</span>
                                                <span class="o_stat_value"><field name="child_count"/></span>
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="wex_kb_workspace_header">
                                <div class="wex_kb_workspace_page_icon"><i class="fa fa-file-text-o"/></div>
                                <div class="wex_kb_workspace_heading">
                                    <label for="name" string="Título"/>
                                    <h1>
                                        <field name="name" placeholder="Procedimiento de recepción SAT" readonly="id and not can_edit"/>
                                    </h1>
                                    <field name="subtitle" placeholder="Resumen editorial corto para contexto y búsqueda" readonly="id and not can_edit"/>
                                </div>
                            </div>

                            <div class="wex_kb_workspace_meta_strip">
                                <div class="wex_kb_meta_pill">
                                    <span>Estado</span>
                                    <strong><field name="state" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="wex_kb_meta_pill" invisible="not id">
                                    <span>Última edición</span>
                                    <strong><field name="write_date" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="wex_kb_meta_pill" invisible="not id">
                                    <span>Relacionados</span>
                                    <strong><field name="related_record_count" readonly="1" nolabel="1"/></strong>
                                </div>
                            </div>

                            <div class="wex_kb_workspace_notice is-warning" invisible="not is_locked">
                                <i class="fa fa-lock"/>
                                <span>El artículo está bloqueado. Solo un manager puede modificarlo.</span>
                            </div>
                            <div class="wex_kb_workspace_notice is-warning" invisible="can_publish or state == 'published'">
                                <i class="fa fa-exclamation-triangle"/>
                                <span>Para publicar, el artículo debe tener contenido real en el cuerpo.</span>
                            </div>
                            <div class="wex_kb_workspace_notice" invisible="is_locked or can_edit">
                                <i class="fa fa-eye"/>
                                <span>Estás viendo este artículo en modo lectura. No tienes permisos para editarlo.</span>
                            </div>

                            <div class="wex_kb_workspace_editor">
                                <field name="body_html" widget="html" nolabel="1" readonly="id and not can_edit" placeholder="Escribe aquí el artículo base."/>
                            </div>

                            <div class="wex_kb_workspace_related" invisible="not id">
                                <div class="wex_kb_workspace_card">
                                    <div class="wex_kb_workspace_card_header">
                                        <div class="wex_kb_workspace_card_title">Sub-articulos</div>
                                        <button type="object" name="action_create_child_article" class="btn btn-link p-0" invisible="not can_edit">Nuevo sub-articulo</button>
                                    </div>
                                    <field name="child_ids" string="Sub-articulos" readonly="1">
                                        <list string="Sub-articulos">
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                            <field name="state" widget="badge"/>
                                            <field name="owner_id"/>
                                        </list>
                                    </field>
                                </div>
                                <div class="wex_kb_workspace_card">
                                    <div class="wex_kb_workspace_card_header">
                                        <div class="wex_kb_workspace_card_title">Registros relacionados</div>
                                    </div>
                                    <field name="link_ids" readonly="id and not can_manage_relations">
                                        <list editable="bottom" string="Registros relacionados">
                                            <field name="model_id" string="Modelo relacionado"/>
                                            <field name="res_model" column_invisible="1" optional="hide"/>
                                            <field name="res_id" string="Registro concreto (opcional)"/>
                                            <field name="target_display_name" readonly="1" optional="hide"/>
                                            <field name="note"/>
                                            <button name="action_open_target" type="object" string="Abrir" class="btn-link"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                            <div class="wex_kb_workspace_card" invisible="not id">
                                <div class="wex_kb_workspace_card_header">
                                    <div class="wex_kb_workspace_card_title">Historial editorial</div>
                                </div>
                                <field name="history_ids" readonly="1">
                                    <list string="Historial editorial" create="0" edit="0" delete="0">
                                        <field name="event_at" string="Fecha"/>
                                        <field name="event_type" string="Tipo" widget="badge"/>
                                        <field name="user_id" string="Usuario"/>
                                        <field name="description" string="Detalle"/>
                                    </list>
                                </field>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wex_knowledge_article_link_list" model="ir.ui.view">
        <field name="name">wex.knowledge.article.link.list</field>
        <field name="model">wex.knowledge.article.link</field>
        <field name="arch" type="xml">
            <list string="Related Records">
                <field name="article_id"/>
                <field name="model_id" string="Modelo relacionado"/>
                <field name="res_model" column_invisible="1" optional="hide"/>
                <field name="res_id" string="Registro concreto"/>
                <field name="target_display_name" optional="hide"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_wex_knowledge_article_link_form" model="ir.ui.view">
        <field name="name">wex.knowledge.article.link.form</field>
        <field name="model">wex.knowledge.article.link</field>
        <field name="arch" type="xml">
            <form string="Related Record">
                <sheet>
                    <group>
                        <group>
                            <field name="article_id"/>
                            <field name="model_id" string="Modelo relacionado"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" string="Registro concreto (opcional)"/>
                        </group>
                        <group>
                            <field name="target_display_name" readonly="1"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_knowledge_article_library" model="ir.actions.act_window">
        <field name="name">Biblioteca</field>
        <field name="res_model">wex.knowledge.article</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="wex_knowledge.view_wex_knowledge_article_search"/>
        <field name="context">{'search_default_published': 1}</field>
    </record>
</odoo>
