<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_knowledge_wex" model="ir.module.category">
        <field name="name">Knowledge</field>
        <field name="description">Knowledge base permissions</field>
        <field name="sequence">36</field>
    </record>

    <record id="group_knowledge_user" model="res.groups">
        <field name="name">Knowledge User</field>
        <field name="category_id" ref="wex_knowledge.module_category_knowledge_wex"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_knowledge_editor" model="res.groups">
        <field name="name">Knowledge Editor</field>
        <field name="category_id" ref="wex_knowledge.module_category_knowledge_wex"/>
        <field name="implied_ids" eval="[(4, ref('wex_knowledge.group_knowledge_user'))]"/>
    </record>

    <record id="group_knowledge_manager" model="res.groups">
        <field name="name">Knowledge Manager</field>
        <field name="category_id" ref="wex_knowledge.module_category_knowledge_wex"/>
        <field name="implied_ids" eval="[(4, ref('wex_knowledge.group_knowledge_editor'))]"/>
    </record>

    <record id="knowledge_article_rule_user_read" model="ir.rule">
        <field name="name">Knowledge Article User Read</field>
        <field name="model_id" ref="model_wex_knowledge_article"/>
        <field name="domain_force">
            ['&amp;',
                '|', ('is_global', '=', True), ('company_id', 'in', company_ids),
                '|',
                    ('visibility', '=', 'internal'),
                    '|',
                        '&amp;', ('visibility', '=', 'private'),
                            '|', ('author_id', '=', user.id),
                                '|', ('owner_id', '=', user.id), ('collaborator_ids', 'in', user.id),
                        '&amp;', ('visibility', '=', 'by_group'), ('allowed_group_ids', 'in', user.groups_id.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_user'))]"/>
    </record>

    <record id="knowledge_article_rule_user_write" model="ir.rule">
        <field name="name">Knowledge Article User Write Own</field>
        <field name="model_id" ref="model_wex_knowledge_article"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            ['&amp;',
                '&amp;',
                    '|', ('is_global', '=', True), ('company_id', 'in', company_ids),
                    ('is_locked', '=', False),
                '|', ('author_id', '=', user.id),
                    '|', ('owner_id', '=', user.id), ('collaborator_ids', 'in', user.id)
            ]
        </field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_user'))]"/>
    </record>

    <record id="knowledge_article_rule_editor_write" model="ir.rule">
        <field name="name">Knowledge Article Editor Write Visible</field>
        <field name="model_id" ref="model_wex_knowledge_article"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            ['&amp;',
                '&amp;',
                    '|', ('is_global', '=', True), ('company_id', 'in', company_ids),
                    ('is_locked', '=', False),
                '|',
                    ('visibility', '=', 'internal'),
                    '|',
                        '&amp;', ('visibility', '=', 'private'),
                            '|', ('author_id', '=', user.id),
                                '|', ('owner_id', '=', user.id), ('collaborator_ids', 'in', user.id),
                        '&amp;', ('visibility', '=', 'by_group'), ('allowed_group_ids', 'in', user.groups_id.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_editor'))]"/>
    </record>

    <record id="knowledge_article_rule_manager_all" model="ir.rule">
        <field name="name">Knowledge Article Manager All</field>
        <field name="model_id" ref="model_wex_knowledge_article"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_manager'))]"/>
    </record>

    <record id="knowledge_category_rule_read" model="ir.rule">
        <field name="name">Knowledge Category Read by Company</field>
        <field name="model_id" ref="model_wex_knowledge_category"/>
        <field name="domain_force">['|', ('is_global', '=', True), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_user'))]"/>
    </record>

    <record id="knowledge_category_rule_manager_all" model="ir.rule">
        <field name="name">Knowledge Category Manager All</field>
        <field name="model_id" ref="model_wex_knowledge_category"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_manager'))]"/>
    </record>

    <record id="knowledge_tag_rule_company" model="ir.rule">
        <field name="name">Knowledge Tag Company Scope</field>
        <field name="model_id" ref="model_wex_knowledge_tag"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_user'))]"/>
    </record>

    <record id="knowledge_link_rule_read" model="ir.rule">
        <field name="name">Knowledge Link Read with Article</field>
        <field name="model_id" ref="model_wex_knowledge_article_link"/>
        <field name="domain_force">
            ['&amp;',
                '|', ('article_id.is_global', '=', True), ('article_id.company_id', 'in', company_ids),
                '|',
                    ('article_id.visibility', '=', 'internal'),
                    '|',
                        '&amp;', ('article_id.visibility', '=', 'private'),
                            '|', ('article_id.author_id', '=', user.id),
                                '|', ('article_id.owner_id', '=', user.id), ('article_id.collaborator_ids', 'in', user.id),
                        '&amp;', ('article_id.visibility', '=', 'by_group'), ('article_id.allowed_group_ids', 'in', user.groups_id.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_user'))]"/>
    </record>

    <record id="knowledge_history_rule_read" model="ir.rule">
        <field name="name">Knowledge History Read with Article</field>
        <field name="model_id" ref="model_wex_knowledge_article_history"/>
        <field name="domain_force">
            ['&amp;',
                '|', ('article_id.is_global', '=', True), ('article_id.company_id', 'in', company_ids),
                '|',
                    ('article_id.visibility', '=', 'internal'),
                    '|',
                        '&amp;', ('article_id.visibility', '=', 'private'),
                            '|', ('article_id.author_id', '=', user.id),
                                '|', ('article_id.owner_id', '=', user.id), ('article_id.collaborator_ids', 'in', user.id),
                        '&amp;', ('article_id.visibility', '=', 'by_group'), ('article_id.allowed_group_ids', 'in', user.groups_id.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_user'))]"/>
    </record>

    <record id="knowledge_history_rule_manager_all" model="ir.rule">
        <field name="name">Knowledge History Manager All</field>
        <field name="model_id" ref="model_wex_knowledge_article_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_manager'))]"/>
    </record>

    <record id="knowledge_link_rule_editor_write" model="ir.rule">
        <field name="name">Knowledge Link Editor Write</field>
        <field name="model_id" ref="model_wex_knowledge_article_link"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            ['&amp;',
                '&amp;',
                    '|', ('article_id.is_global', '=', True), ('article_id.company_id', 'in', company_ids),
                    ('article_id.is_locked', '=', False),
                '|',
                    ('article_id.visibility', '=', 'internal'),
                    '|',
                        '&amp;', ('article_id.visibility', '=', 'private'),
                            '|', ('article_id.author_id', '=', user.id),
                                '|', ('article_id.owner_id', '=', user.id), ('article_id.collaborator_ids', 'in', user.id),
                        '&amp;', ('article_id.visibility', '=', 'by_group'), ('article_id.allowed_group_ids', 'in', user.groups_id.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_editor'))]"/>
    </record>

    <record id="knowledge_link_rule_manager_all" model="ir.rule">
        <field name="name">Knowledge Link Manager All</field>
        <field name="model_id" ref="model_wex_knowledge_article_link"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('wex_knowledge.group_knowledge_manager'))]"/>
    </record>
</odoo>
