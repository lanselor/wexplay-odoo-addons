<?xml version="1.0" encoding="UTF-8"?>
<!-- wexplay_sat_print/static/src/xml/repair_print_center_modal.xml -->
<templates xml:space="preserve">
    <t t-name="wexplay_sat_print.SatPrintCenterModal">
        <div class="modal fade show d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content border-0 shadow-lg">
                    
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <i class="fa fa-print me-2"></i>Centro de Impresión SAT
                        </h5>
                        <button type="button" class="btn-close btn-close-white" t-on-click="close" aria-label="Close"/>
                    </div>

                    <div class="modal-body p-4">
                        <div class="section-container mb-4 p-3 border rounded bg-light">
                            <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">
                                <i class="fa fa-tag me-2"></i>Etiquetas Brother QL
                            </h6>
                            
                            <div class="d-grid gap-3">
                                <button type="button" class="btn btn-outline-primary d-flex align-items-center justify-content-center" t-on-click="onPrintLabel29x90">
                                    <i class="fa fa-file-text-o me-2"></i> Etiqueta SAT Completa
                                </button>

                                <div class="d-flex align-items-center gap-2">
                                    <div class="input-group">
                                        <button class="btn btn-secondary px-3" t-on-click="decrementAccessoryQty">-</button>
                                        <input type="number" class="form-control text-center fw-bold" 
                                               t-att-value="state.accessoryQty" t-on-input="onAccessoryQtyInput"/>
                                        <button class="btn btn-secondary px-3" t-on-click="incrementAccessoryQty">+</button>
                                    </div>
                                    <button type="button" class="btn btn-secondary w-100 py-2" t-on-click="onPrintLabel29x42">
                                        <i class="fa fa-tags me-2"></i> Accesorios
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="section-container mb-4 p-3 border rounded bg-light">
                            <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">
                                <i class="fa fa-user me-2"></i>Documentación Cliente
                            </h6>
                            <button type="button" class="btn btn-outline-dark w-100" t-on-click="onPrintTicket80x170">
                                <i class="fa fa-ticket me-2"></i> Resguardo (Tamaño Ticket)
                            </button>
                        </div>

                        <button type="button" class="btn btn-success btn-lg w-100 shadow-sm py-3 fw-bold" t-on-click="onPrintAll">
                            <i class="fa fa-check-circle me-2"></i> IMPRIMIR TODO
                        </button>
                         <button type="button" class="btn btn-info btn-lg w-100 shadow-sm py-3 fw-bold" t-on-click="onPrintSat">
                            <i class="fa fa-check-circle me-2"></i> IMPRIMIR DOCUMENTOS CLIENTE
                        </button>
                    </div>

                    <div class="modal-footer border-top-0 justify-content-center">
                        <button type="button" class="btn btn-link text-muted" t-on-click="close">Cancelar y Salir</button>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    </t>
</templates>