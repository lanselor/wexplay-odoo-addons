<?xml version="1.0" encoding="UTF-8"?>
<!-- wexplay_sat_print/static/src/xml/repair_print_center_modal.xml -->
<templates xml:space="preserve">
  <t t-name="wexplay_sat_print.SatPrintCenterModal">
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
      <div class="modal-dialog" role="document">
        <div class="modal-content">

          <div class="modal-header">
            <h5 class="modal-title">Centro de impresión SAT</h5>
            <button type="button" class="btn-close" aria-label="Close" t-on-click="close"/>
          </div>

          <div class="modal-body">

            <div class="mb-3">
              <div class="fw-bold mb-2">Etiquetas (Brother QL)</div>

              <!-- Etiqueta SAT completa (una debajo de la otra) -->
              <div class="mb-2">
                <button type="button" class="btn btn-primary" t-on-click="onPrintLabel29x90">
                  Etiqueta SAT completa
                </button>
              </div>

              <!-- Etiqueta accesorios + selector cantidad -->
              <div class="d-flex align-items-center gap-2">


                <div class="input-group input-group-sm" style="width: 160px;">
                  <button type="button" class="btn btn-outline-secondary" t-on-click="decrementAccessoryQty">-</button>
                  <input type="number"
                         class="form-control text-center"
                         min="1"
                         t-att-value="state.accessoryQty"
                         t-on-input="onAccessoryQtyInput"/>
                  <button type="button" class="btn btn-outline-secondary" t-on-click="incrementAccessoryQty">+</button>
                </div>
                <button type="button" class="btn btn-secondary" t-on-click="onPrintLabel29x42">
                  Etiqueta accesorios
                </button>
              </div>
            </div>

            <hr/>

            <div class="mb-2">
              <div class="fw-bold mb-2">Resguardo Cliente</div>

              <button type="button" class="btn btn-secondary" t-on-click="onPrintTicket80x170">
                Resguardo(Tamaño Ticket)
              </button>
            </div>
            <hr/>
            <div class="mb-3">
              <button type="button" class="btn btn-outline-success btn-lg" t-on-click="onPrintAll">
                Imprimir Todo
              </button>
            </div>

          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" t-on-click="close">Cerrar</button>
          </div>

        </div>
      </div>
    </div>

    <div class="modal-backdrop fade show"></div>
  </t>
</templates>
