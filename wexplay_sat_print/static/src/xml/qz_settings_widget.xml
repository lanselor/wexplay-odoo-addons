<?xml version="1.0" encoding="UTF-8"?>
<!-- wexplay_sat_print/static/src/xml/qz_settings_widget.xml -->
<templates xml:space="preserve">

  <t t-name="wexplay_sat_print.WexQzSettingsWidget">
    <div class="o_wex_qz_settings">

      <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" t-on-click="onTestConnection">
          Probar conexión QZ
        </button>

        <button type="button"
                class="btn btn-secondary"
                t-att-disabled="state.status !== 'ok'"
                t-on-click="onLoadPrinters">
          Cargar impresoras
        </button>
      </div>

      <div class="mt8">
        <t t-if="state.status === 'loading'">
          <span>Procesando...</span>
        </t>
        <t t-elif="state.status === 'ok'">
          <span><strong>OK:</strong> <t t-esc="state.message"/></span>
        </t>
        <t t-elif="state.status === 'error'">
          <span><strong>Error:</strong> <t t-esc="state.message"/></span>
        </t>
        <t t-else="">
          <span t-if="state.message"><t t-esc="state.message"/></span>
        </t>
      </div>

      <t t-if="state.printers.length">
        <div class="mt16">
          <div class="mb8"><strong>Asignar impresoras predeterminadas</strong></div>

        <div class="row g-2">

          <div class="col-12">
            <label class="form-label">Etiquetas</label>
            <select class="form-select"
                    t-on-change="(ev) => setPrinter('wex_qz_label_printer', ev)">
              <option value="">(sin asignar)</option>
              <t t-foreach="state.printers" t-as="p" t-key="p">
                <option t-att-value="p"
                        t-att-selected="props.record.data.wex_qz_label_printer === p">
                  <t t-esc="p"/>
                </option>
              </t>
            </select>
          </div>

          <div class="col-12">
            <label class="form-label">Térmica</label>
            <select class="form-select"
                     t-on-change="(ev) => this.setPrinter('wex_qz_label_printer', ev)">
              <option value="">(sin asignar)</option>
              <t t-foreach="state.printers" t-as="p" t-key="p + '_t'">
                <option t-att-value="p"
                        t-att-selected="props.record.data.wex_qz_thermal_printer === p">
                  <t t-esc="p"/>
                </option>
              </t>
            </select>
          </div>

          <div class="col-12">
            <label class="form-label">A4</label>
            <select class="form-select"
                     t-on-change="(ev) => this.setPrinter('wex_qz_a4_printer', ev)">
              <option value="">(sin asignar)</option>
              <t t-foreach="state.printers" t-as="p" t-key="p + '_a4'">
                <option t-att-value="p"
                        t-att-selected="props.record.data.wex_qz_a4_printer === p">
                  <t t-esc="p"/>
                </option>
              </t>
            </select>
          </div>

        </div>


          <div class="mt8 text-muted">
            Selecciona impresoras y luego pulsa <strong>Guardar</strong> en Ajustes para persistir por compañía.
          </div>
        </div>
      </t>

    </div>
  </t>

</templates>
