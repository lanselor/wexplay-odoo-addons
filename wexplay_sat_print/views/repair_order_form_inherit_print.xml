<odoo>
    <record id="repair_order_form_inherit_print_center_button" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.print.center.button</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(wexplay_sat_print.action_repair_print_center)d"
                        type="action"
                        string="Impresiones"
                        class="btn btn-secondary"/>
            </xpath>
        </field>
    </record>

    <record id="view_repair_form_wexplay_sat_documents" model="ir.ui.view">
        <field name="name">repair.order.form.wexplay.sat.documents</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="wexplay_repair.view_repair_order_form_wexplay"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='wex_sat_documents_page']//div[hasclass('alert')]" position="replace">
                <div>
                    <p class="fw-semibold text-muted mb-3" style="font-size:11px;text-transform:uppercase;letter-spacing:.5px;">Documentos descargables</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button name="%(wexplay_sat_print.report_repair_label_29x90)d"
                                type="action"
                                class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                            <i class="fa fa-barcode"/>
                            Etiqueta SAT 29×90
                        </button>
                        <button name="%(wexplay_sat_print.report_repair_label_29x42)d"
                                type="action"
                                class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                            <i class="fa fa-tag"/>
                            Etiqueta accesorios 29×42
                        </button>
                        <button name="%(wexplay_sat_print.report_repair_ticket_80x170)d"
                                type="action"
                                class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                            <i class="fa fa-file-text-o"/>
                            Resguardo 80×170
                        </button>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
