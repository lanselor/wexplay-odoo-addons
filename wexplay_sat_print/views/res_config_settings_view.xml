<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wexplay_sat_print_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">wexplay_sat_print.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                
                <app string="Wexplay Print / QZ" name="wexplay_sat_print_qz">
                    <block title="Estado y diagnóstico">
                        <setting string="Conexión QZ Tray">
                            <!-- Widget UI -->
                            <field name="wex_qz_ui" widget="wex_qz_settings_widget"/>
                            
                            <!-- Snapshot guardado en compañía -->
                            <div class="mt16">
                                <div><strong>Último test:</strong> <field name="wex_qz_last_test_ok"/></div>
                                <div><strong>Fecha:</strong> <field name="wex_qz_last_test_at"/></div>
                                <div><strong>Usuario:</strong> <field name="wex_qz_last_test_user_id"/></div>
                            </div>
                        </setting>
                    </block>
                    
                    <block title="Predeterminados por tipo">
                        <setting string="Etiquetas">
                            <field name="wex_qz_label_printer" placeholder="Selecciona o escribe nombre exacto"/>
                        </setting>
                        
                        <setting string="Térmica">
                            <field name="wex_qz_thermal_printer" placeholder="Selecciona o escribe nombre exacto"/>
                        </setting>
                        
                        <setting string="A4">
                            <field name="wex_qz_a4_printer" placeholder="Selecciona o escribe nombre exacto"/>
                        </setting>
                    </block>
                    
                    <block title="Avanzado">
                        <setting string="Debug">
                            <field name="wex_qz_debug"/>
                        </setting>
                        
                        <setting string="Fallback">
                            <field name="wex_qz_allow_fallback"/>
                        </setting>
                    </block>
                </app>
                
            </xpath>
        </field>
    </record>
</odoo>
