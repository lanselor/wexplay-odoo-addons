<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_ticket_80x170">
        <t t-name="wexplay_sat_print.repair_ticket_80x170">
            <!-- IMPORTANTE: NO basic_layout -->
            <t t-call="web.html_container">
 
                    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
                    <meta charset="utf-8"/>

                <t t-foreach="docs" t-as="o">
                    <style>
                        @page { size: 80mm 210mm; margin: 0mm; }

                        html, body {
                            margin: 0 !important;
                            padding: 0 !important;
                        }

                        /* Evitar “grises” (la térmica los convierte en puntos) */
                        * {
                            color: #000 !important;
                            -webkit-print-color-adjust: exact;
                            print-color-adjust: exact;
                        }

                        .ticket-container{
                            width: 80mm;
                            padding: 3mm;              /* menos padding para ganar tamaño útil */
                            font-family: Arial, sans-serif;
                            font-size: 11pt;           /* SUBE base */
                            line-height: 1.15;
                            box-sizing: border-box;
                        }

                        .muted{ color:#000 !important; } /* no gris */
                        .mono{ font-family: monospace; }
                        .up{ text-transform: uppercase; }

                        .hr{
                            height: 0.4mm;            /* más grueso */
                            background: #000;         /* negro */
                            margin: 2.5mm 0;
                        }

                        /* Quita fondos grises y bordes finos grises */
                        .card, .card-white{
                            border: 0.35mm solid #000; /* negro y un poco más grueso */
                            background: #fff;          /* blanco */
                            padding: 2.2mm;
                            border-radius: 0mm;        /* en térmica, redondeos finos a veces “ensucian” */
                        }

                        .title-xs{
                            font-size: 9pt;            /* mínimo legible */
                            font-weight: 800;
                            letter-spacing: 0.1mm;
                            text-transform: uppercase;
                        }

                        .block-title{
                            font-size: 10pt;
                            font-weight: 900;
                            letter-spacing: 0.1mm;
                            text-transform: uppercase;
                            margin-bottom: 1.5mm;
                        }

                        .badge{
                            display:inline-block;
                            padding: 0.8mm 1.4mm;
                            border: 0.35mm solid #000;
                            background:#fff;
                            font-size: 9pt;
                            font-weight: 800;
                        }

                        .header-strip{
                            background:#000 !important;
                            color:#fff !important;
                            padding: 2.2mm 2mm;
                            text-align:center;
                            margin: 2.5mm 0 3mm 0;
                        }
                        .header-strip * { color:#fff !important; }

                        .header-strip .kicker{
                            font-size: 9pt;
                            text-transform:uppercase;
                            letter-spacing:0.2mm;
                            font-weight:800;
                        }

                        .header-strip .ord{
                            font-size: 18pt;          /* más grande */
                            font-weight: 900;
                            margin-top: 0.6mm;
                        }

                        .table{
                            width:100%;
                            border-collapse:collapse;
                            font-size: 11pt;          /* sube tabla */
                        }
                        .table td{ padding: 0.8mm 0; vertical-align:top; }
                        .table .k{ width: 20mm; font-weight: 800; }

                        .notes{
                            font-size: 11pt;
                            line-height: 1.2;
                            text-align:left;
                            white-space:pre-wrap;
                            margin:0;
                            padding:0;
                        }

                        .barcode-box{
                            text-align:center;
                            padding: 2mm 0 0 0;
                        }

                        .terms{
                            border-top: 0.6mm dashed #000; /* negro */
                            margin-top: 3mm;
                            padding-top: 3mm;
                        }

                        /* Logo: si lo mantienes, intenta que sea alto contraste */
                        .logo{
                            max-height: 12mm;
                            max-width: 55mm;
                            display:block;
                            margin: 0 auto;
                        }
                    </style>

                    <div class="ticket-container">

                        <!-- HEADER -->
                        <div style="text-align:center;">
                            <t t-if="o.company_id.logo">
                                <img t-att-src="image_data_uri(o.company_id.logo)"
                                     class="logo"
                                     alt="Logo"/>
                            </t>

                            <div class="title-xs" style="margin-top:1.2mm;">
                                Resguardo Servicio Técnico
                            </div>

                            <div style="margin-top:1.6mm;">
                                <span class="badge">
                                    <span class="up">Fecha</span>:
                                    <t t-esc="o.create_date" t-options='{"widget":"datetime","format":"dd/MM/yyyy HH:mm"}'/>
                                </span>
                            </div>
                        </div>

                        <!-- ORDER STRIP -->
                        <div class="header-strip">
                            <div class="kicker">Orden de reparación</div>
                            <div class="ord"><t t-esc="o.name or ''"/></div>
                        </div>

                        <!-- CLIENT CARD -->
                        <div class="card">
                            <div class="block-title">Cliente</div>

                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:2mm;">
                                <div style="flex:1; min-width:0;">
                                    <div style="font-size:13pt; font-weight:900; line-height:1.1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                        <t t-esc="o.partner_id.name or ''"/>
                                    </div>

                                    <div style="margin-top:1mm; font-size:12pt; font-weight:900;" class="mono">
                                        <t t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
                                    </div>
                                </div>

                                <div style="text-align:right; white-space:nowrap;">
                                    <div class="title-xs">Entrada</div>
                                    <div style="font-size:11pt; font-weight:900;">
                                        <t t-esc="o.create_date" t-options='{"widget":"datetime","format":"dd/MM/yyyy HH:mm"}'/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="hr"></div>

                        <!-- DEVICE CARD -->
                        <div class="card-white">
                            <div class="block-title">Equipo</div>

                            <table class="table">
                                <tr>
                                    <td class="k">Modelo:</td>
                                    <td style="font-weight:900;">
                                        <t t-esc="o.x_model_id.display_name if 'x_model_id' in o._fields and o.x_model_id else '—'"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="k">IMEI/SN:</td>
                                    <td class="mono" style="font-weight:900;">
                                        <t t-esc="o.x_imei if 'x_imei' in o._fields and o.x_imei else '—'"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="k">Accesorios:</td>
                                    <td style="font-style:italic;">
                                        <t t-if="'x_accessories' in o._fields and (o.x_accessories or '').strip()">
                                            <t t-esc="(o.x_accessories or '')[:180]"/>
                                            <t t-if="(o.x_accessories or '')[180:]">...</t>
                                        </t>
                                        <t t-else="">Ninguno</t>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="hr"></div>

                        <!-- NOTES CARD -->
                        <div class="card-white">
                            <div class="block-title">Avería / Notas</div>
                            <div class="notes">
                                <t t-if="'x_reported_issue' in o._fields and (o.x_reported_issue or '').strip()">
                                    <t t-esc="o.x_reported_issue"/>
                                </t>
                                <t t-else="">— No detallada —</t>
                            </div>
                        </div>

                       <!-- BARCODE -->
                        <div class="barcode-box">
                            <t t-if="o.name">
                                <t t-set="sat_barcode" t-value="(o.name or '').replace('/', '').replace(' ', '')"/>
                                <t t-set="base_url" t-value="o.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>

                                <!-- un poco más grande -->
                                <img t-att-src="'%s/report/barcode/Code128/%s?width=420&amp;height=120&amp;humanreadable=0' % (base_url, sat_barcode)"
                                     style="width:62mm; height:12mm; display:block; margin:0 auto;"/>

                                <div class="mono" style="font-size:10pt; margin-top:1.2mm; font-weight:900;">
                                    <t t-esc="o.name"/>
                                </div>
                            </t>
                        </div>

                        <!-- TERMS -->
                        <div class="terms">
                            <div style="text-align:center; font-size:10pt; font-weight:900; margin-bottom:1.5mm;">
                                CONDICIONES DE RECOGIDA
                            </div>

                            <div style="font-size:9pt; line-height:1.2; text-align:justify; font-weight:700;">
                                Es imprescindible presentar este documento para la retirada del equipo.
                                No nos hacemos responsables de la pérdida de datos.
                                Pasado <strong>1 año</strong>, el equipo pasará a ser propiedad del SAT.
                            </div>

                            <div style="text-align:center; font-size:8pt; margin-top:3mm; text-transform:uppercase; font-weight:800;">
                                <t t-esc="o.company_id.name"/> · <t t-esc="o.company_id.vat"/>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>