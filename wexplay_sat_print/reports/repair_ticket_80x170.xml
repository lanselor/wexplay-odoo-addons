<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_ticket_80x170">
        <t t-name="wexplay_sat_print.repair_ticket_80x170">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div style="width:80mm; min-height:170mm; padding:3mm; font-family:'Arial', sans-serif; color:#000; background:#fff; box-sizing:border-box;">
                        
                        <div style="text-align:center; margin-bottom:2mm;">
                            <t t-if="o.company_id.logo">
                                <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 15mm; max-width: 50mm;" alt="Logo"/>
                            </t>
                            <t t-else="">
                                <div style="font-size:16pt; font-weight:900; color:#714B67;">
                                    we<span style="color:#4eb052;">x</span>play
                                </div>
                            </t>
                            <div style="font-size:7.5pt; font-weight:bold; text-transform:uppercase; letter-spacing:1px; margin-top:2mm; color:#666;">
                                Resguardo Servicio Técnico
                            </div>
                        </div>
                        
                        <div style="background:#000; color:#fff; padding:4mm 2mm; text-align:center; border-radius:1.5mm; margin-bottom:5mm;">
                            <div style="font-size:8pt; text-transform:uppercase; opacity:0.8; margin-bottom:1mm;">Orden de Reparación</div>
                            <div style="font-size:22pt; font-weight:900; letter-spacing:0.5mm;"><t t-esc="o.name or ''"/></div>
                        </div>
                        
                        <div style="border-bottom:0.5mm solid #000; padding-bottom:2mm; margin-bottom:4mm;">
                            <div style="font-size:7.5pt; font-weight:bold; color:#666; text-transform:uppercase;">Datos del Cliente</div>
                            <div style="font-size:12pt; font-weight:900; margin-top:1mm; line-height:1.2;">
                                <t t-esc="o.partner_id.name or ''"/>
                            </div>
                            <div style="font-size:10.5pt; font-weight:800; font-family:monospace; margin-top:1.5mm;">
                                <t t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
                            </div>
                            <div style="font-size:8.5pt; margin-top:1.5mm; color:#444;">
                                <b>Fecha Entrada:</b> <t t-esc="o.create_date" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                            </div>
                        </div>
                        
                        <div style="background:#f4f4f4; padding:3mm; border-radius:1.5mm; margin-bottom:5mm; border:0.1mm solid #ddd;">
                            <div style="font-size:7.5pt; font-weight:bold; color:#666; text-transform:uppercase; margin-bottom:2mm; border-bottom:0.1mm solid #ccc; padding-bottom:1mm;">Equipo y Accesorios</div>
                            
                            <table style="width:100%; font-size:9.5pt; border-collapse:collapse;">
                                <tr>
                                    <td style="padding:0.5mm 0; color:#555; width:22mm;">Modelo:</td>
                                    <td style="font-weight:900;"><t t-esc="o.x_model_id.display_name if 'x_model_id' in o._fields else '—'"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:0.5mm 0; color:#555;">IMEI/SN:</td>
                                    <td style="font-family:monospace; font-weight:bold;"><t t-esc="o.x_imei if 'x_imei' in o._fields else '—'"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:1mm 0 0.5mm 0; color:#555; vertical-align:top;">Accesorios:</td>
                                    <td style="padding-top:1mm; font-style:italic; line-height:1.1;">
                                        <t t-esc="o.x_accessories if 'x_accessories' in o._fields and o.x_accessories else 'Ninguno'"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        
                        <div style="margin-bottom:6mm; padding:0 1mm;">
                            <div style="font-size:7.5pt; font-weight:bold; color:#666; text-transform:uppercase; border-bottom:0.3mm solid #aaa; padding-bottom:1mm; margin-bottom:2mm;">Avería / Notas</div>
                            <div style="font-size:10pt; line-height:1.4; white-space:pre-wrap; color:#111;">
                                <t t-if="o.x_reported_issue">
                                    <t t-esc="o.x_reported_issue"/>
                                </t>
                                <t t-else="">— No se han detallado notas de avería —</t>
                            </div>
                        </div>
                        
                        <div style="text-align:center; margin-bottom:8mm;">
                            <img t-if="o.name" t-att-src="'/report/barcode/?type=Code128&amp;value=%s&amp;width=600&amp;height=120' % o.name" style="width:65mm; height:12mm;"/>
                            <div style="font-size:7pt; font-family:monospace; margin-top:1mm;"><t t-esc="o.name"/></div>
                        </div>
                        
                        <div style="border-top:0.4mm dashed #000; padding-top:4mm; text-align:center;">
                            <div style="font-size:8pt; font-weight:bold; margin-bottom:2mm; text-transform:uppercase;">Condiciones de Recogida</div>
                            <div style="font-size:7.2pt; line-height:1.3; color:#333; text-align:justify; margin-bottom:4mm;">
                                Es imprescindible presentar este documento para cualquier consulta o para la retirada del equipo. 
                                Pasados 3 meses, el equipo pasará a ser propiedad del SAT.
                            </div>
                            <div style="font-size:6pt; color:#aaa; text-transform:uppercase; letter-spacing:0.5px;">
                                <t t-esc="o.company_id.name"/> · <t t-esc="o.company_id.vat"/>
                            </div>
                        </div>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>