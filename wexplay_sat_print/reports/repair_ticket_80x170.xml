<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_ticket_80x170">
        <t t-name="wexplay_sat_print.repair_ticket_80x170">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div style="width:80mm;height:170mm;font-family:monospace;font-size:10pt;">
                        <div style="text-align:center;font-weight:bold;font-size:12pt;">
                            WEXPLAY - RESGUARDO SAT
                        </div>
                        <div style="text-align:center;font-size:9pt;">
                            <t t-esc="o.company_id.name or ''"/>
                        </div>
                        
                        <hr style="border:0;border-top:0.2mm solid #000;margin:2mm 0;"/>
                        
                        <div><b>Orden:</b> <t t-esc="o.name or ''"/></div>
                        <div><b>Cliente:</b> <t t-esc="o.partner_id.name or ''"/></div>
                        <div><b>Tel:</b> <t t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/></div>
                        <div><b>Fecha:</b> <t t-esc="o.create_date or ''"/></div>
                        
                        <hr style="border:0;border-top:0.2mm solid #000;margin:2mm 0;"/>
                        
                        <div style="margin-top:2mm;">
                            <div><b>Descripción / Avería:</b></div>
                            <div style="white-space:pre-wrap;">
                                <t t-esc="o.description or ''"/>
                            </div>
                        </div>
                        
                        <hr style="border:0;border-top:0.2mm solid #000;margin:2mm 0;"/>
                        
                        <div style="font-size:8pt;">
                            Condiciones: conservar este resguardo para la recogida.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
