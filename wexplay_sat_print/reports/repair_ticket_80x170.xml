<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_ticket_80x170">
        <t t-name="wexplay_sat_print.repair_ticket_80x170">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <style>
                        @page { size: 80mm 170mm; margin: 0; }
                        html, body { margin: 0 !important; padding: 0 !important; }
                        .ticket-container {
                        width: 80mm;
                        padding: 4mm;
                        font-family: 'Arial', sans-serif;
                        font-size: 9pt;
                        color: #000;
                        box-sizing: border-box;
                        }
                    </style>
                    
                    <div class="ticket-container">
                        
                        <div style="text-align:center; margin-bottom:3mm;">
                            <t t-if="o.company_id.logo">
                                <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 12mm; max-width: 45mm;" alt="Logo"/>
                            </t>
                            <div style="font-size:7pt; font-weight:bold; text-transform:uppercase; color:#666; margin-top:1mm;">
                                Resguardo Servicio Técnico
                            </div>
                        </div>
                        
                        <div style="background:#000; color:#fff; width: 100%; padding: 2mm 0; text-align:center; margin-bottom:4mm;">
                            <div style="font-size:7pt; text-transform:uppercase; opacity:0.8;">Orden de Reparación</div>
                            <div style="font-size:16pt; font-weight:900;"><t t-esc="o.name or ''"/></div>
                        </div>
                        
                        <div style="border-bottom:0.3mm solid #000; padding-bottom:2mm; margin-bottom:3mm;">
                            <div style="font-size:7pt; font-weight:bold; color:#666; text-transform:uppercase;">Cliente</div>
                            <div style="font-size:10pt; font-weight:900;"><t t-esc="o.partner_id.name or ''"/></div>
                            <div style="font-size:9pt; font-family:monospace; margin-top:0.5mm;">
                                <t t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
                            </div>
                            <div style="font-size:8pt; margin-top:1mm; color:#444;">
                                Fecha: <t t-esc="o.create_date" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                            </div>
                        </div>
                        
                        <div style="background:#f8f8f8; padding:2mm; border:0.1mm solid #eee; margin-bottom:3mm;">
                            <table style="width:100%; font-size:8.5pt; border-collapse:collapse;">
                                <tr>
                                    <td style="color:#666; width:18mm;">Modelo:</td>
                                    <td style="font-weight:bold;"><t t-esc="o.x_model_id.display_name if 'x_model_id' in o._fields else '—'"/></td>
                                </tr>
                                <tr>
                                    <td style="color:#666;">IMEI/SN:</td>
                                    <td style="font-family:monospace;"><t t-esc="o.x_imei if 'x_imei' in o._fields else '—'"/></td>
                                </tr>
                                <tr>
                                    <td style="color:#666; vertical-align:top;">Accesorios:</td>
                                    <td style="font-style:italic; line-height:1.1;">
                                        <t t-esc="o.x_accessories if 'x_accessories' in o._fields and o.x_accessories else 'Ninguno'"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        
                        <div style="margin-bottom:4mm;">
                            <div style="font-size:7pt; font-weight:bold; color:#666; text-transform:uppercase; border-bottom:0.2mm solid #ddd; padding-bottom:0.5mm; margin-bottom:1.5mm;">Avería / Notas</div>
                            <div style="font-size:9pt; line-height:1.2; text-align:left; white-space:pre-wrap;">
                                <t t-if="o.x_reported_issue">
                                    <t t-esc="o.x_reported_issue"/>
                                </t>
                                <t t-else="">— No detallada —</t>
                            </div>
                        </div>
                        
                        <div style="text-align:center; margin: 4mm 0;">
                            <img t-if="o.name" t-att-src="'/report/barcode/?type=Code128&amp;value=%s&amp;width=600&amp;height=100' % o.name" style="width:50mm; height:8mm;"/>
                            <div style="font-size:6pt; font-family:monospace; margin-top:1mm;"><t t-esc="o.name"/></div>
                        </div>
                        
                        <div style="border-top:0.3mm dashed #ccc; padding-top:3mm; text-align:center;">
                            <div style="font-size:7.5pt; font-weight:bold; margin-bottom:1.5mm;">CONDICIONES DE RECOGIDA</div>
                            <div style="font-size:6.8pt; line-height:1.2; color:#333; text-align:justify;">
                                Es imprescindible presentar este documento para la retirada del equipo. 
                                No nos hacemos responsables de la pérdida de datos. 
                                Pasado <strong>1 año</strong>, el equipo pasará a ser propiedad del SAT.
                            </div>
                            <div style="font-size:6pt; color:#999; margin-top:3mm; text-transform:uppercase;">
                                <t t-esc="o.company_id.name"/> · <t t-esc="o.company_id.vat"/>
                            </div>
                        </div>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>