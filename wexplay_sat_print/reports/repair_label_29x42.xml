<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_label_29x42">
        <t t-name="wexplay_sat_print.repair_label_29x42">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <!-- Horizontal real: ancho = 42, alto = 29 -->
                    <div style="width:42mm;height:29mm;padding:1mm;font-family:monospace;box-sizing:border-box;">
                        <div style="font-size:10pt;font-weight:bold;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.1;">
                            <t t-esc="o.name or ''"/>
                        </div>
                        <div style="font-size:9pt;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.1;">
                            <t t-esc="o.partner_id.name or ''"/>
                        </div>
                        <div style="font-size:9pt;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.1;">
                            <t t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
