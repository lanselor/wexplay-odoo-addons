<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_label_29x90">
        <t t-call="web.html_container">
            <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
            <meta charset="utf-8"/>
            <t t-foreach="docs" t-as="o">
                <style>
                    @page { size: 90mm 29mm; margin: 0; }
                    html, body { margin: 0 !important; padding: 0 !important; }
                    .main-container{
                    width:90mm;height:29mm;
                    margin:0;padding:0;
                    position:relative;
                    overflow:hidden;
                    font-family:'Arial',sans-serif;
                    background:#fff;
                    }
                </style>
                
                <div class="main-container">
                    
                    <!-- Banda negra izquierda -->
                    <div style="position:absolute;left:0;top:0;bottom:0;width:7.5mm;background:#000;color:#fff;">
                        <div style="
                                position: absolute;
                                width: 29mm;
                                height: 8mm;
                                top: 10.5mm;
                                left: -10.5mm;
                                -webkit-transform: rotate(-90deg);
                                text-align: center;
                                line-height: 8mm;
                                font-size: 9pt;
                                font-weight: 900;
                                white-space: nowrap;
                                overflow: hidden;
                                text-overflow: ellipsis;
                                color: #ffffff;
                                ">
                            <t t-esc="o.name or ''"/>
                        </div>
                    </div>
                    
                    <!-- Columna central -->
                    <div style="position:absolute;left:9mm;top:0;width:62mm;height:29mm;padding-top:1.5mm;box-sizing:border-box;">
                        
                        <!-- Header central -->
                        <div style="border-bottom:0.4mm solid #000;padding-bottom:0.9mm;">
                            <div style="font-size:6.5pt;text-transform:uppercase;font-weight:800;color:#666;line-height:1;">
                                Cliente
                            </div>
                            
                            <div style="
                                    margin-top:0.4mm;
                                    font-size:10pt;
                                    font-weight:900;
                                    white-space:nowrap;
                                    overflow:hidden;
                                    text-overflow:ellipsis;
                                    line-height:1.15;
                                    ">
                                <t t-esc="o.partner_id.name if o.partner_id else ''"/>
                            </div>
                            
                            <div style="
                                    margin-top:0.6mm;
                                    font-size:9pt;
                                    font-weight:800;
                                    font-family:monospace;
                                    color:#333;
                                    line-height:1.1;
                                    ">
                                <t t-esc="(o.partner_id and (o.partner_id.phone or o.partner_id.mobile)) or ''"/>
                            </div>
                        </div>
                        
                        <!-- Avería -->
                        <div style="padding-top:1.2mm;">
                            <div style="font-size:6.5pt;font-weight:800;color:#666;text-transform:uppercase;">
                                Averia / Notas
                            </div>
                            
                            <div style="font-size:8pt;line-height:1.1;font-style:italic;color:#000;max-height:11mm;overflow:hidden;">
                                <t t-if="'x_reported_issue' in o._fields and (o.x_reported_issue or '').strip()">
                                    <t t-esc="(o.x_reported_issue or '')[:230]"/>
                                    <t t-if="(o.x_reported_issue or '')[230:]">...</t>
                                </t>
                                <t t-else="">— Sin notas —</t>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Columna derecha -->
                    <div style="
                            position:absolute;right:0;top:0;
                            width:18mm;height:29mm;
                            border-left:0.2mm dashed #ccc;
                            padding:1.5mm 1mm 0 1mm;
                            box-sizing:border-box;
                            ">
                        
                        <!-- Fecha entrada -->
                        <div style="text-align:center;">
                            <div style="font-size:6pt;font-weight:800;color:#666;text-transform:uppercase;">
                                Fecha Entrada
                            </div>
                            <div style="font-size:8pt;font-weight:900;">
                                <t t-esc="o.create_date.strftime('%d/%m/%Y') if o.create_date else ''"/>
                            </div>
                        </div>
                        
                        <!-- Acceso / contraseña -->
                        <t t-if="'x_unlock_type' in o._fields and o.x_unlock_type">
                            <div style="margin-top:1.2mm;border-top:0.2mm solid #ddd;padding-top:0.8mm;">
                                <div style="font-size:6pt;font-weight:800;color:#666;text-transform:uppercase;text-align:center;">
                                    Contraseña
                                </div>
                                
                                <!-- Valor principal según tipo -->
                                <div style="margin-top:0.5mm;font-size:7pt;font-weight:900;font-family:monospace;color:#000;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    <t t-if="o.x_unlock_type in ('pin','password')">
                                        <t t-esc="o.x_unlock_code or ''"/>
                                    </t>
                                    <t t-elif="o.x_unlock_type == 'pattern'">
                                        <t t-esc="o.x_unlock_pattern or ''"/>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="o.x_unlock_type or ''"/>
                                    </t>
                                </div>
                                
                                <!-- Notas extra (muy cortas) -->
                                <t t-if="'x_unlock_notes' in o._fields and (o.x_unlock_notes or '').strip()">
                                    <div style="margin-top:0.6mm;font-size:5.5pt;line-height:1.1;color:#333;max-height:6mm;overflow:hidden;text-align:left;">
                                        <t t-esc="(o.x_unlock_notes or '')[:80]"/>
                                        <t t-if="(o.x_unlock_notes or '')[80:]">...</t>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                    
                    <!-- Footer: documento interno (izquierda) -->
                    <div style="position:absolute;bottom:0.5mm;left:9mm;font-size:4pt;color:#bbb;">
                        DOCUMENTO INTERNO SAT
                    </div>
                    
                    <t t-if="o.name">
                        <t t-set="sat_barcode" t-value="(o.name or '').replace('/', '').replace(' ', '')"/>
                        <t t-set="base_url" t-value="o.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
                        
                        <img
                            t-att-src="'%s/report/barcode/Code128/%s?width=600&amp;height=90&amp;humanreadable=0' % (base_url, sat_barcode)"
                            style="
                            position:absolute;
                            bottom:0.3mm;
                            left:30mm;
                            width:50mm;
                            height:5mm;
                            display:block;
                            "
                            alt="barcode"
                            />
                    </t>
                    
                    <!-- Logo empresa (abajo derecha) -->
                    <t t-if="o.company_id and o.company_id.logo">
                        <img
                            t-att-src="image_data_uri(o.company_id.logo)"
                            style="
                            position:absolute;
                            right:1.2mm;
                            bottom:0.5mm;
                            max-width:16mm;
                            max-height:6mm;
                            display:block;
                            "
                            alt="Logo"
                            />
                    </t>
                    
                </div>
            </t>
        </t>
    </template>
</odoo>