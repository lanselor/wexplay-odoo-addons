<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_label_29x90">
        <t t-name="wexplay_sat_print.repair_label_29x90">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <style>
                        @page { size: 90mm 29mm; margin: 0; }
                        html, body { margin: 0 !important; padding: 0 !important; }
                    </style>
                    
                    <div style="
                            width:90mm;height:29mm;margin:0;padding:0;
                            box-sizing:border-box;overflow:hidden;
                            font-family:'Helvetica','Arial',sans-serif;
                            color:#000;background:#fff;position:relative;
                            ">
                        
                        <!-- Banda izquierda -->
                        <div style="
                                position:absolute;left:0;top:0;bottom:0;width:8mm;
                                background:#000;color:#fff;
                                ">
                            <!-- Texto anclado abajo-izquierda, rotado -90 -->
                            <div style="
                                    position:absolute;
                                    left:1mm;
                                    bottom:1mm;
                                    transform:rotate(-90deg);
                                    transform-origin:left bottom;
                                    white-space:nowrap;
                                    font-size:10pt;
                                    font-weight:700;
                                    letter-spacing:0.2mm;
                                    ">
                                <t t-esc="(o.name or '')"/>
                            </div>
                        </div>
                        
                        <!-- Contenido -->
                        <div style="
                                position:absolute;left:8mm;top:0;right:0;bottom:0;
                                padding:1.2mm 1.2mm 1mm 1.8mm;
                                box-sizing:border-box;
                                display:flex;flex-direction:column;
                                ">
                            
                            <!-- Header -->
                            <div style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:flex-end;
                                    padding-top:0.4mm;              /* baja un poco todo el header */
                                    padding-bottom:0.8mm;
                                    border-bottom:0.4mm solid #000;
                                    ">
                                <div style="min-width:0;">
                                    <div style="font-size:6.5pt;text-transform:uppercase;font-weight:700;color:#555;">
                                        Cliente
                                    </div>
                                    <div style="
                                            font-size:10pt;font-weight:800;
                                            white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
                                            line-height:1;
                                            margin-top:0.2mm;
                                            ">
                                        <t t-esc="(o.partner_id and o.partner_id.name) or ''"/>
                                    </div>
                                    
                                    <!-- Teléfono debajo del nombre (sin label) -->
                                    <div style="
                                            font-size:8.8pt;
                                            font-family:monospace;
                                            font-weight:700;
                                            margin-top:0.6mm;
                                            white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
                                            ">
                                        <t t-esc="(o.partner_id and (o.partner_id.phone or o.partner_id.mobile)) or ''"/>
                                    </div>
                                </div>
                                
                                <div style="text-align:right;min-width:22mm;">
                                    <div style="font-size:6.5pt;font-weight:700;color:#555;">
                                        FECHA ENTRADA
                                    </div>
                                    <div style="font-size:8pt;font-weight:800;">
                                        <t t-esc="o.create_date and o.create_date.strftime('%d/%m/%Y') or ''"/>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Body -->
                            <div style="
                                    display:flex;
                                    flex:1 1 auto;
                                    padding-top:1mm;
                                    gap:2mm;
                                    min-height:0;
                                    ">
                                
                                <!-- Columna izquierda (ahora solo deja aire y separador) -->
                                <div style="
                                        flex:0 0 25mm;
                                        border-right:0.2mm dashed #ccc;
                                        padding-right:1.5mm;
                                        box-sizing:border-box;
                                        position:relative;
                                        ">
                                    <!-- (Vacío deliberado: ya mostramos teléfono en el header) -->
                                </div>
                                
                                <!-- Avería -->
                                <div style="flex:1 1 auto;overflow:hidden;min-width:0;position:relative;">
                                    <div style="font-size:6.5pt;font-weight:700;color:#555;text-transform:uppercase;">
                                        Avería / Notas
                                    </div>
                                    <div style="
                                            font-size:7.6pt;
                                            line-height:1.1;
                                            margin-top:0.6mm;
                                            font-style:italic;
                                            color:#222;
                                            overflow:hidden;
                                            ">
                                        <t t-if="'x_reported_issue' in o._fields and (o.x_reported_issue or '').strip()">
                                            <t t-esc="(o.x_reported_issue or '')[:140]"/>
                                            <t t-if="(o.x_reported_issue or '')[140:]">...</t>
                                        </t>
                                        <t t-else="">— Sin notas —</t>
                                    </div>
                                    
                                    <!-- Logo Wexplay en el hueco derecho, rotado -90 -->
                                    <div style="
                                            position:absolute;
                                            right:0.5mm;
                                            top:0.3mm;
                                            bottom:0.3mm;
                                            width:8mm;
                                            display:flex;
                                            align-items:center;
                                            justify-content:center;
                                            pointer-events:none;
                                            ">
                                        <div style="
                                                transform:rotate(-90deg);
                                                transform-origin:center;
                                                font-size:9pt;
                                                font-weight:900;
                                                color:#714B67;
                                                white-space:nowrap;
                                                ">
                                            we<span style="color:#4eb052;">x</span>play
                                        </div>
                                    </div>
                                    
                                </div>
                                
                            </div>
                            
                            <div style="font-size:5pt;text-align:right;color:#aaa;margin-top:0.2mm;">
                                DOCUMENTO INTERNO SAT
                            </div>
                            
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
