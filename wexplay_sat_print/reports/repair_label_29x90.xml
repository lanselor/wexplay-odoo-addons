<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_label_29x90">
        <t t-name="wexplay_sat_print.repair_label_29x90">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <style>
                        @page {
                        size: 90mm 29mm;
                        margin: 0;
                        }
                        html, body {
                        margin: 0 !important;
                        padding: 0 !important;
                        }
                    </style>
                    
                    <!-- Canvas etiqueta -->
                    <div style="
                            width:90mm;
                            height:29mm;
                            margin:0;
                            padding:0;
                            box-sizing:border-box;
                            overflow:hidden;
                            font-family:'Helvetica','Arial',sans-serif;
                            color:#000;
                            background:#fff;
                            position:relative;
                            ">
                        
                        <!-- Banda izquierda -->
                        <div style="
                                position:absolute;
                                left:0;
                                top:0;
                                bottom:0;
                                width:8mm;
                                background:#000;
                                color:#fff;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                ">
                            <div style="
                                    transform:rotate(-90deg);
                                    white-space:nowrap;
                                    font-size:10pt;
                                    font-weight:700;
                                    letter-spacing:0.3mm;
                                    ">
                                <t t-esc="(o.name or '')[:18]"/>
                            </div>
                        </div>
                        
                        <!-- Contenido -->
                        <div style="
                                position:absolute;
                                left:8mm;
                                top:0;
                                right:0;
                                bottom:0;
                                padding:1mm 1mm 1mm 1.5mm;
                                box-sizing:border-box;
                                display:flex;
                                flex-direction:column;
                                ">
                            
                            <!-- Header -->
                            <div style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:flex-end;
                                    padding-bottom:0.8mm;
                                    border-bottom:0.4mm solid #000;
                                    ">
                                <div style="min-width:0;">
                                    <div style="font-size:6.5pt;text-transform:uppercase;font-weight:700;color:#555;">
                                        Cliente
                                    </div>
                                    <div style="
                                            font-size:9.5pt;
                                            font-weight:700;
                                            white-space:nowrap;
                                            overflow:hidden;
                                            text-overflow:ellipsis;
                                            line-height:1;
                                            ">
                                        <t t-esc="(o.partner_id and o.partner_id.name) or ''"/>
                                    </div>
                                </div>
                                
                                <div style="text-align:right;min-width:22mm;">
                                    <div style="font-size:6.5pt;font-weight:700;color:#555;">
                                        FECHA ENTRADA
                                    </div>
                                    <div style="font-size:8pt;font-weight:700;">
                                        <t t-esc="o.create_date and o.create_date.strftime('%d/%m/%Y') or ''"/>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Body -->
                            <div style="
                                    display:flex;
                                    flex:1 1 auto;
                                    padding-top:1mm;
                                    gap:2mm;
                                    min-height:0;
                                    ">
                                
                                <!-- Teléfono -->
                                <div style="
                                        flex:0 0 25mm;
                                        border-right:0.2mm dashed #ccc;
                                        padding-right:1.5mm;
                                        box-sizing:border-box;
                                        ">
                                    <div style="font-size:6.5pt;font-weight:700;color:#555;text-transform:uppercase;">
                                        Teléfono
                                    </div>
                                    <div style="font-size:8.5pt;font-family:monospace;font-weight:700;margin-top:0.5mm;">
                                        <t t-esc="(o.partner_id and (o.partner_id.phone or o.partner_id.mobile)) or ''"/>
                                    </div>
                                    
                                    <div style="margin-top:2.2mm;font-size:8pt;font-weight:900;color:#714B67;">
                                        we<span style="color:#4eb052;">x</span>play
                                    </div>
                                </div>
                                
                                <!-- Avería -->
                                <div style="flex:1 1 auto;overflow:hidden;min-width:0;">
                                    <div style="font-size:6.5pt;font-weight:700;color:#555;text-transform:uppercase;">
                                        Avería / Notas
                                    </div>
                                    <div style="
                                            font-size:7.5pt;
                                            line-height:1.1;
                                            margin-top:0.5mm;
                                            font-style:italic;
                                            color:#222;
                                            overflow:hidden;
                                            ">
                                        <t t-if="'x_reported_issue' in o._fields and (o.x_reported_issue or '').strip()">
                                            <t t-esc="(o.x_reported_issue or '')[:120]"/>
                                            <t t-if="(o.x_reported_issue or '')[120:]">...</t>
                                        </t>
                                        <t t-else="">— Sin notas —</t>
                                    </div>
                                </div>
                                
                            </div>
                            
                            <div style="font-size:5pt;text-align:right;color:#aaa;margin-top:0.2mm;">
                                DOCUMENTO INTERNO SAT
                            </div>
                            
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
