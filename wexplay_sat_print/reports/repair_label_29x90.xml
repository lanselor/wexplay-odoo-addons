<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========================================================= -->
    <!-- ETIQUETA SAT ACCESORIOS · 29 x 42 mm (DISEÑO HORIZONTAL)   -->
    <!-- ========================================================= -->
    <template id="repair_label_29x42">
        <t t-name="wexplay_sat_print.repair_label_29x42">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <!-- Horizontal: 42mm ancho x 29mm alto -->
                    <div style="width:42mm;height:29mm;padding:1mm;font-family:monospace;box-sizing:border-box;">
                        
                        <!-- Cabecera -->
                        <div style="font-size:11pt;font-weight:bold;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            <t t-esc="o.name or ''"/>
                        </div>
                        
                        <!-- Modelo / Marca -->
                        <div style="font-size:9pt;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            <t t-esc="(o.x_model_id.name if o.x_model_id else '')"/>
                            <t t-if="o.x_model_id and o.x_model_id.brand_id">
                                <span> · </span>
                                <t t-esc="o.x_model_id.brand_id.name"/>
                            </t>
                        </div>
                        
                        <!-- Cliente + Teléfono -->
                        <div style="font-size:9pt;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            <t t-esc="o.partner_id.name or ''"/>
                        </div>
                        <div style="font-size:9pt;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            <t t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
                        </div>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
