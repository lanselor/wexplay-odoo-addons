<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_label_29x90">
        <t t-name="wexplay_sat_print.repair_label_29x90">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <!-- Horizontal real: ancho = 90, alto = 29 -->
                    <div style="width:90mm;height:29mm;padding:1.2mm;box-sizing:border-box;overflow:hidden;font-family:Arial, sans-serif;">
                        
                        <!-- ===== HEADER (tipo “etiqueta bonita”) ===== -->
                        <div style="
                                display:flex;
                                align-items:center;
                                justify-content:space-between;
                                padding:0.8mm 1mm;
                                border:0.25mm solid #000;
                                border-radius:1.2mm;
                                background:#f2f2f2;
                                ">
                            <!-- IZQ: SAT + Nº -->
                            <div style="min-width:0;">
                                <div style="font-size:10pt;font-weight:700;line-height:1.05;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    SAT · <t t-esc="o.name or ''"/>
                                </div>
                                <div style="font-size:7.6pt;line-height:1.05;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    <t t-esc="(o.partner_id.name or '')"/>
                                </div>
                            </div>
                            
                            <!-- DER: FECHA (sin romper si el campo está vacío) -->
                            <div style="
                                    margin-left:2mm;
                                    flex:0 0 auto;
                                    text-align:right;
                                    font-size:7.6pt;
                                    line-height:1.05;
                                    ">
                                <div style="font-weight:700;">ENTRADA</div>
                                <!-- Corrección: mostrar fecha SOLO si existe; si no, vacío -->
                                <div>
                                    <t t-if="o.create_date">
                                        <span t-field="o.create_date" t-options='{"widget": "datetime"}'/>
                                    </t>
                                    <t t-else="">—</t>
                                </div>
                            </div>
                        </div>
                        
                        <!-- ===== BODY ===== -->
                        <div style="display:flex;gap:1.2mm;margin-top:1.1mm;height:18.8mm;">
                            
                            <!-- COLUMNA IZQ: contacto -->
                            <div style="
                                    flex:0 0 32mm;
                                    border:0.2mm solid #000;
                                    border-radius:1mm;
                                    padding:0.8mm;
                                    box-sizing:border-box;
                                    ">
                                <div style="font-size:7.4pt;font-weight:700;letter-spacing:0.2mm;margin-bottom:0.6mm;">
                                    CLIENTE
                                </div>
                                
                                <div style="font-size:8.4pt;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    <t t-esc="o.partner_id.name or ''"/>
                                </div>
                                
                                <div style="font-size:8.2pt;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:0.4mm;">
                                    <t t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
                                </div>
                            </div>
                            
                            <!-- COLUMNA DER: avería -->
                            <div style="
                                    flex:1 1 auto;
                                    border:0.2mm solid #000;
                                    border-radius:1mm;
                                    padding:0.8mm;
                                    box-sizing:border-box;
                                    overflow:hidden;
                                    ">
                                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.6mm;">
                                    <div style="font-size:7.4pt;font-weight:700;letter-spacing:0.2mm;">
                                        AVERÍA
                                    </div>
                                    <!-- mini “tag” -->
                                    <div style="
                                            font-size:7pt;
                                            font-weight:700;
                                            border:0.2mm solid #000;
                                            border-radius:2mm;
                                            padding:0.2mm 1mm;
                                            background:#fff;
                                            ">
                                        WEXPLAY
                                    </div>
                                </div>
                                
                                <div style="font-size:8.2pt;line-height:1.15;max-height:13.5mm;overflow:hidden;">
                                    <t t-if="getattr(o, 'x_reported_issue', False)">
                                        <t t-esc="o.x_reported_issue"/>
                                    </t>
                                    <t t-else="">
                                        —
                                    </t>
                                </div>
                            </div>
                            
                        </div>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
