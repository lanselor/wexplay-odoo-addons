<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_label_29x90">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <style>
                    @page { size: 90mm 29mm; margin: 0; }
                    html, body { margin: 0 !important; padding: 0 !important; }
                    .main-container{
                    width:90mm;height:29mm;
                    margin:0;padding:0;
                    position:relative;
                    overflow:hidden;
                    font-family:'Arial',sans-serif;
                    background:#fff;
                    }
                </style>
                
                <div class="main-container">
                    
                    <!-- Banda negra izquierda -->
                    <div style="position:absolute;left:0;top:0;bottom:0;width:7.5mm;background:#000;color:#fff;">
                        
                        <div style="
                                position: absolute;
                                width: 29mm;
                                height: 8mm;
                                top: 10.5mm; 
                                left: -10.5mm;
                                -webkit-transform: rotate(-90deg);

                                text-align: center;
                                line-height: 8mm;
                                font-size: 9pt;
                                font-weight: 900;
                                white-space: nowrap;

                                overflow: hidden;
                                text-overflow: ellipsis;
                                
                                color: #ffffff;
                                ">
                            <t t-esc="o.name or ''"/>
                        </div>
                        
                    </div>
                    
                    <!-- Columna central -->
                    <div style="position:absolute;left:9mm;top:0;width:62mm;height:29mm;padding-top:1.5mm;box-sizing:border-box;">
                        
                        <!-- Header central -->
                        <div style="border-bottom:0.4mm solid #000;padding-bottom:0.9mm;">
                            <div style="font-size:6.5pt;text-transform:uppercase;font-weight:800;color:#666;line-height:1;">
                                Cliente
                            </div>
                            
                            <!-- + separación -->
                            <div style="
                                    margin-top:0.4mm;
                                    font-size:10pt;
                                    font-weight:900;
                                    white-space:nowrap;
                                    overflow:hidden;
                                    text-overflow:ellipsis;
                                    line-height:1.15;
                                    ">
                                <t t-esc="o.partner_id.name if o.partner_id else ''"/>
                            </div>
                            
                            <div style="
                                    margin-top:0.6mm;
                                    font-size:9pt;
                                    font-weight:800;
                                    font-family:monospace;
                                    color:#333;
                                    line-height:1.1;
                                    ">
                                <t t-esc="(o.partner_id and (o.partner_id.phone or o.partner_id.mobile)) or ''"/>
                            </div>
                        </div>
                        
                        <!-- Avería -->
                        <div style="padding-top:1.2mm;">
                            <div style="font-size:6.5pt;font-weight:800;color:#666;text-transform:uppercase;">
                                Averia / Notas
                            </div>
                            
                            <div style="font-size:8pt;line-height:1.1;font-style:italic;color:#000;max-height:11mm;overflow:hidden;">
                                <t t-if="'x_reported_issue' in o._fields and (o.x_reported_issue or '').strip()">
                                    <!-- slicing seguro sin depender de len() -->
                                    <t t-esc="(o.x_reported_issue or '')[:230]"/>
                                    <t t-if="(o.x_reported_issue or '')[230:]">...</t>
                                </t>
                                <t t-else="">— Sin notas —</t>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Columna derecha -->
                    <div style="
                            position:absolute;right:0;top:0;
                            width:18mm;height:29mm;
                            border-left:0.2mm dashed #ccc;
                            padding:1.5mm 1mm 0 1mm;
                            box-sizing:border-box;
                            ">
                        <div style="text-align:center;">
                            <div style="font-size:6pt;font-weight:800;color:#666;text-transform:uppercase;">
                                Fecha Entrada
                            </div>
                            <div style="font-size:8pt;font-weight:900;">
                                <t t-esc="o.create_date.strftime('%d/%m/%Y') if o.create_date else ''"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Footer: documento interno (izquierda) -->
                    <div style="position:absolute;bottom:0.5mm;left:9mm;font-size:4pt;color:#bbb;">
                        DOCUMENTO INTERNO SAT
                    </div>
                    <!-- Footer: código de barras SAT -->
                    <t t-set="base_url" t-value="o.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
                    <img
                        t-att-src="'%s/report/barcode/Code128/%s?width=420&amp;height=70&amp;humanreadable=0' % (base_url, sat_barcode)"
                        style="position:absolute;bottom:0.3mm;left:42mm;width:24mm;height:9mm;display:block;"
                        alt="barcode"
                    />
                    
                    
                    <!-- Footer: logo (derecha, alineado con el footer) -->
                    <div style="position:absolute;bottom:0.5mm;right:1.2mm;font-size:9pt;font-weight:900;color:#714B67;white-space:nowrap;">
                        we<span style="color:#4eb052;">x</span>play
                    </div>
                    
                </div>
            </t>
        </t>
    </template>
</odoo>
