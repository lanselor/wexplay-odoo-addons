<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="repair_label_29x90">
        <t t-name="wexplay_sat_print.repair_label_29x90">
            <t t-call="web.basic_layout">
                <style>
                    /* Tamaño de la etiqueta (horizontal) */
                    .wex_lbl90 {
                    width: 90mm;
                    height: 29mm;
                    margin: 0;
                    padding: 0;
                    font-family: monospace;
                    box-sizing: border-box;
                    overflow: hidden;
                    }
                    
                    /* Contenedor en 3 columnas */
                    .wex_row {
                    display: flex;
                    height: 100%;
                    border: 0.2mm solid #000;
                    box-sizing: border-box;
                    }
                    
                    /* Columna izquierda: corte + fecha + ID vertical */
                    .wex_left {
                    width: 12mm;
                    border-right: 0.2mm solid #000;
                    box-sizing: border-box;
                    padding: 1mm 0.8mm;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                    }
                    
                    .wex_cut {
                    border-left: 0.4mm dotted #000;
                    height: 100%;
                    position: absolute;
                    left: 3.8mm;
                    top: 0;
                    opacity: 0.8;
                    }
                    
                    .wex_left_inner {
                    position: relative;
                    height: 100%;
                    }
                    
                    .wex_date {
                    font-size: 7pt;
                    line-height: 1.1;
                    white-space: nowrap;
                    }
                    
                    .wex_id_vert {
                    font-size: 10pt;
                    font-weight: 700;
                    line-height: 1;
                    writing-mode: vertical-rl;
                    transform: rotate(180deg);
                    letter-spacing: 0.5pt;
                    align-self: center;
                    }
                    
                    /* Columna central: contenido */
                    .wex_mid {
                    flex: 1;
                    padding: 1mm 1.2mm;
                    box-sizing: border-box;
                    display: flex;
                    flex-direction: column;
                    gap: 0.6mm;
                    overflow: hidden;
                    }
                    
                    .wex_mid_top {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 9pt;
                    font-weight: 700;
                    border-bottom: 0.2mm solid #000;
                    padding-bottom: 0.6mm;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    }
                    
                    .wex_line {
                    display: flex;
                    gap: 2mm;
                    font-size: 8pt;
                    line-height: 1.1;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    }
                    
                    .wex_label {
                    font-weight: 700;
                    }
                    
                    .wex_issue_box {
                    margin-top: auto;
                    border-top: 0.2mm solid #000;
                    padding-top: 0.6mm;
                    font-size: 8pt;
                    line-height: 1.15;
                    overflow: hidden;
                    }
                    
                    .wex_issue_title {
                    font-weight: 700;
                    margin-bottom: 0.3mm;
                    }
                    
                    /* Columna derecha: banda vertical marca */
                    .wex_right {
                    width: 10mm;
                    border-left: 0.2mm solid #000;
                    box-sizing: border-box;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    }
                    
                    .wex_brand_vert {
                    font-family: sans-serif;
                    font-size: 14pt;
                    font-weight: 700;
                    color: #a68fcd; /* lila corporativo */
                    writing-mode: vertical-rl;
                    transform: rotate(180deg);
                    letter-spacing: 0.5pt;
                    }
                </style>
                
                <t t-foreach="docs" t-as="o">
                    <div class="wex_lbl90">
                        <div class="wex_row">
                            
                            <!-- IZQUIERDA -->
                            <div class="wex_left">
                                <div class="wex_left_inner">
                                    <div class="wex_cut"></div>
                                    
                                    <!-- Fecha (si tienes create_date / write_date / fecha entrada) -->
                                    <div class="wex_date">
                                        <t t-if="o.create_date">
                                            <t t-esc="format_datetime(o.create_date, tz='Europe/Madrid', dt_format='dd/MM/yyyy')"/>
                                        </t>
                                    </div>
                                    
                                    <!-- ID / Nº SAT vertical -->
                                    <div class="wex_id_vert">
                                        <t t-esc="(o.name or '')"/>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- CENTRO -->
                            <div class="wex_mid">
                                
                                <!-- Cliente (centrado) -->
                                <div class="wex_mid_top">
                                    <t t-esc="o.partner_id.name or ''"/>
                                </div>
                                
                                <!-- Línea: Tel / Modelo / Equipo (ajusta campos reales) -->
                                <div class="wex_line">
                                    <span class="wex_label">Tel:</span>
                                    <span>
                                        <t t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
                                    </span>
                                </div>
                                
                                <div class="wex_line">
                                    <span class="wex_label">Equipo:</span>
                                    <span>
                                        <t t-esc="(o.x_device_model or o.x_model or o.x_device_name or '')"/>
                                    </span>
                                </div>
                                
                                <!-- Avería -->
                                <div class="wex_issue_box">
                                    <div class="wex_issue_title">Avería:</div>
                                    <div>
                                        <t t-esc="(o.x_reported_issue or '')"/>
                                    </div>
                                </div>
                                
                            </div>
                            
                            <!-- DERECHA -->
                            <div class="wex_right">
                                <div class="wex_brand_vert">wexplay</div>
                            </div>
                            
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
